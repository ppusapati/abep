{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "urn:abep:schemas:interfaces:bus_power_boundary_a9_v1",
 "title": "ABEP A9 spacecraft-DC propulsion bus-power boundary v1 (ledger input declaration)",
 "description": "Instance schema for one evaluated step of abep_sim.bus_boundary_a9.ledger. Installed-slot completeness per configuration/variant and not-installed = exactly 0 W / efficiency 1 are enforced by the module (record shapes, the icp_rf_source plane and 'plane' only on icp_rf_source are enforced by both). Generated by docs/architecture_comparison/power_boundary_a9/build_bus_power_boundary_a9.py.",
 "type": "object",
 "required": [
  "boundary_version",
  "configuration",
  "variant",
  "front_end",
  "loads",
  "efficiencies"
 ],
 "additionalProperties": false,
 "properties": {
  "boundary_version": {
   "const": "bus_power_boundary_a9_v1"
  },
  "configuration": {
   "enum": [
    "hall_c1_reference",
    "hall_icp_neutralizer"
   ]
  },
  "variant": {
   "type": "array",
   "uniqueItems": true,
   "items": {
    "enum": [
     "active_cooling",
     "flow_control_icp_feed",
     "icp_assist_magnet"
    ]
   }
  },
  "label": {
   "type": "string"
  },
  "power_basis": {
   "enum": [
    "steady_state",
    "step_average",
    "peak_sampled",
    "p_bus_1ms_max"
   ]
  },
  "gate_measurement": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "sample_rate_Sa_s",
    "bandwidth_Hz",
    "anti_alias_documented",
    "synchronized",
    "source"
   ],
   "properties": {
    "sample_rate_Sa_s": {
     "type": "number"
    },
    "bandwidth_Hz": {
     "type": "number"
    },
    "anti_alias_documented": {
     "type": "boolean"
    },
    "synchronized": {
     "type": "boolean"
    },
    "source": {
     "type": "string",
     "minLength": 1
    }
   }
  },
  "front_end": {
   "$ref": "#/$defs/front_end"
  },
  "loads": {
   "type": "object",
   "propertyNames": {
    "enum": [
     "hall_discharge",
     "hall_magnet_inner",
     "hall_magnet_outer",
     "hall_magnet_trim",
     "c1_heater",
     "c1_keeper",
     "c1_common_tie",
     "filter_getter",
     "icp_rf_source",
     "icp_matching_network",
     "icp_collector_bias",
     "icp_assist_magnet",
     "active_cooling",
     "flow_control_atmospheric",
     "flow_control_xe",
     "flow_control_icp_feed",
     "compressor",
     "thermal_control",
     "housekeeping_controls",
     "reserved_dc_port"
    ]
   },
   "properties": {
    "icp_rf_source": {
     "$ref": "#/$defs/rf_load"
    },
    "c1_heater": {
     "$ref": "#/$defs/heater_load"
    }
   },
   "additionalProperties": {
    "$ref": "#/$defs/load"
   }
  },
  "efficiencies": {
   "type": "object",
   "propertyNames": {
    "enum": [
     "hall_discharge",
     "hall_magnet_inner",
     "hall_magnet_outer",
     "hall_magnet_trim",
     "c1_heater",
     "c1_keeper",
     "c1_common_tie",
     "filter_getter",
     "icp_rf_source",
     "icp_matching_network",
     "icp_collector_bias",
     "icp_assist_magnet",
     "active_cooling",
     "flow_control_atmospheric",
     "flow_control_xe",
     "flow_control_icp_feed",
     "compressor",
     "thermal_control",
     "housekeeping_controls",
     "reserved_dc_port"
    ]
   },
   "additionalProperties": {
    "$ref": "#/$defs/efficiency"
   }
  }
 },
 "$defs": {
  "load": {
   "oneOf": [
    {
     "type": "object",
     "required": [
      "P_W",
      "evidence_class",
      "source"
     ],
     "properties": {
      "P_W": {
       "type": "number",
       "minimum": 0
      },
      "evidence_class": {
       "enum": [
        "measured",
        "digitized",
        "inferred",
        "reconstructed",
        "model-derived",
        "assumed",
        "owner-allocation"
       ]
      },
      "source": {
       "type": "string",
       "minLength": 1
      }
     },
     "additionalProperties": false
    },
    {
     "type": "object",
     "required": [
      "P_W",
      "tbd_requires"
     ],
     "properties": {
      "P_W": {
       "const": "TBD"
      },
      "tbd_requires": {
       "type": "string",
       "minLength": 1
      }
     },
     "additionalProperties": false
    }
   ]
  },
  "rf_load": {
   "oneOf": [
    {
     "type": "object",
     "required": [
      "P_W",
      "evidence_class",
      "source",
      "plane"
     ],
     "properties": {
      "P_W": {
       "type": "number",
       "minimum": 0
      },
      "evidence_class": {
       "enum": [
        "measured",
        "digitized",
        "inferred",
        "reconstructed",
        "model-derived",
        "assumed",
        "owner-allocation"
       ]
      },
      "source": {
       "type": "string",
       "minLength": 1
      },
      "plane": {
       "const": "generator_dc_input"
      }
     },
     "additionalProperties": false
    },
    {
     "type": "object",
     "required": [
      "P_W",
      "tbd_requires",
      "plane"
     ],
     "properties": {
      "P_W": {
       "const": "TBD"
      },
      "tbd_requires": {
       "type": "string",
       "minLength": 1
      },
      "plane": {
       "const": "generator_dc_input"
      }
     },
     "additionalProperties": false
    }
   ]
  },
  "heater_load": {
   "oneOf": [
    {
     "type": "object",
     "required": [
      "P_W",
      "evidence_class",
      "source"
     ],
     "properties": {
      "P_W": {
       "type": "number",
       "minimum": 0
      },
      "evidence_class": {
       "enum": [
        "measured",
        "digitized",
        "inferred",
        "reconstructed",
        "model-derived",
        "assumed",
        "owner-allocation"
       ]
      },
      "source": {
       "type": "string",
       "minLength": 1
      }
     },
     "additionalProperties": false
    },
    {
     "type": "object",
     "required": [
      "P_W",
      "tbd_requires"
     ],
     "properties": {
      "P_W": {
       "const": "TBD"
      },
      "tbd_requires": {
       "type": "string",
       "minLength": 1
      }
     },
     "additionalProperties": false
    },
    {
     "type": "object",
     "required": [
      "P_W",
      "tbd_requires",
      "booked_W",
      "evidence_class",
      "source"
     ],
     "properties": {
      "P_W": {
       "const": "TBD"
      },
      "tbd_requires": {
       "type": "string",
       "minLength": 1
      },
      "booked_W": {
       "type": "number",
       "exclusiveMinimum": 0
      },
      "evidence_class": {
       "enum": [
        "measured",
        "digitized",
        "inferred",
        "reconstructed",
        "model-derived",
        "assumed",
        "owner-allocation"
       ]
      },
      "source": {
       "type": "string",
       "minLength": 1
      }
     },
     "additionalProperties": false,
     "description": "A9.1 SEQ-heater: TBD c1_heater booked ON at conservative power"
    }
   ]
  },
  "efficiency": {
   "oneOf": [
    {
     "type": "object",
     "required": [
      "value",
      "evidence_class",
      "source",
      "path"
     ],
     "properties": {
      "value": {
       "type": "number",
       "exclusiveMinimum": 0,
       "maximum": 1
      },
      "evidence_class": {
       "enum": [
        "measured",
        "digitized",
        "inferred",
        "reconstructed",
        "model-derived",
        "assumed",
        "owner-allocation"
       ]
      },
      "source": {
       "type": "string",
       "minLength": 1
      },
      "path": {
       "enum": [
        "internal_bus",
        "direct"
       ]
      }
     },
     "additionalProperties": false
    },
    {
     "type": "object",
     "required": [
      "value",
      "tbd_requires",
      "path"
     ],
     "properties": {
      "value": {
       "const": "TBD"
      },
      "tbd_requires": {
       "type": "string",
       "minLength": 1
      },
      "path": {
       "enum": [
        "internal_bus",
        "direct"
       ]
      }
     },
     "additionalProperties": false
    }
   ]
  },
  "front_end": {
   "oneOf": [
    {
     "type": "object",
     "required": [
      "value",
      "evidence_class",
      "source"
     ],
     "properties": {
      "value": {
       "type": "number",
       "exclusiveMinimum": 0,
       "maximum": 1
      },
      "evidence_class": {
       "enum": [
        "measured",
        "digitized",
        "inferred",
        "reconstructed",
        "model-derived",
        "assumed",
        "owner-allocation"
       ]
      },
      "source": {
       "type": "string",
       "minLength": 1
      }
     },
     "additionalProperties": false
    },
    {
     "type": "object",
     "required": [
      "value",
      "tbd_requires"
     ],
     "properties": {
      "value": {
       "const": "TBD"
      },
      "tbd_requires": {
       "type": "string",
       "minLength": 1
      }
     },
     "additionalProperties": false
    }
   ]
  }
 },
 "x-bus-power-boundary-a9": {
  "installed_slots": {
   "hall_c1_reference": [
    "hall_discharge",
    "hall_magnet_inner",
    "hall_magnet_outer",
    "hall_magnet_trim",
    "c1_heater",
    "c1_keeper",
    "c1_common_tie",
    "filter_getter",
    "flow_control_atmospheric",
    "flow_control_xe",
    "compressor",
    "thermal_control",
    "housekeeping_controls",
    "reserved_dc_port"
   ],
   "hall_icp_neutralizer": [
    "hall_discharge",
    "hall_magnet_inner",
    "hall_magnet_outer",
    "hall_magnet_trim",
    "icp_rf_source",
    "icp_matching_network",
    "icp_collector_bias",
    "flow_control_atmospheric",
    "flow_control_xe",
    "compressor",
    "thermal_control",
    "housekeeping_controls",
    "reserved_dc_port"
   ]
  },
  "variant_options": {
   "hall_c1_reference": [
    "active_cooling"
   ],
   "hall_icp_neutralizer": [
    "icp_assist_magnet",
    "active_cooling",
    "flow_control_icp_feed"
   ]
  },
  "internal_bus_V": 100.0,
  "rfp_limit_W": 1500.0,
  "gate_quantity": "P_bus,1ms,max (A9.1 OQ-A902-01)",
  "pass_requires_power_basis": [
   "p_bus_1ms_max"
  ],
  "pass_requires_gate_measurement": {
   "keys": [
    "sample_rate_Sa_s",
    "bandwidth_Hz",
    "anti_alias_documented",
    "synchronized",
    "source"
   ],
   "rule": "sample_rate_Sa_s >= 100e3, bandwidth_Hz >= 20e3, anti_alias_documented and synchronized True, non-empty source"
  }
 }
}
