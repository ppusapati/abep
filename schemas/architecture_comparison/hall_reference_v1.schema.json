{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "urn:abep:schemas:architecture_comparison:hall_reference_v1",
 "title": "Common Hall accelerator reference v1 (interface definition for hall_only / rf_hall / ecr_hall)",
 "description": "JSON Schema for docs/architecture_comparison/hall_reference/hall_reference_v1.json: ONE downstream Hall accelerator reference for Vyovrinda's own thruster, identical in the three thrust architectures hall_only, rf_hall and ecr_hall, so the RF/ECR comparison changes only the pre-ionization method. It is an interface definition. It carries no Hall performance prediction, no P5 geometry or P5 B(z) as a design value, no architecture winner and no transport admission. Every quantity object carries a status: TBD (value null, 'requires' says what is needed), PROPOSED (a proposal for the owner, with rationale, source and evidence class), SOURCED (a cited value, with source, locator and evidence class) or OWNER_DECIDED (a recorded owner decision). The explanation is docs/architecture_comparison/hall_reference/HALL_ACCELERATOR_REFERENCE.md; tests/test_hall_reference.py validates the instance with a minimal validator for the keywords used here (no jsonschema dependency: it is not in requirements-lock.txt).",
 "type": "object",
 "properties": {
  "schema": {"const": "hall_reference_v1"},
  "schema_file": {"const": "schemas/architecture_comparison/hall_reference_v1.schema.json"},
  "reference_id": {"type": "string", "minLength": 1},
  "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[A-Za-z0-9.]+)?$"},
  "status": {"enum": ["DRAFT_FOR_OWNER_REVIEW", "OWNER_APPROVED", "SUPERSEDED"]},
  "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
  "code_baseline_commit": {"type": "string", "pattern": "^[0-9a-f]{7,40}$"},
  "architectures": {
   "type": "array",
   "items": {"enum": ["hall_only", "rf_hall", "ecr_hall"]},
   "minItems": 3,
   "maxItems": 3,
   "uniqueItems": true
  },
  "scope": {
   "type": "object",
   "properties": {
    "statement": {"type": "string", "minLength": 1},
    "block": {"type": "string", "minLength": 1},
    "own_thruster_not_p5": {"type": "string", "minLength": 1},
    "no_performance_claims": {"type": "string", "minLength": 1},
    "no_winner": {"type": "string", "minLength": 1},
    "not_wired": {"type": "string", "minLength": 1}
   },
   "required": ["statement", "block", "own_thruster_not_p5", "no_performance_claims", "no_winner", "not_wired"],
   "additionalProperties": false
  },
  "milestones": {
   "type": "object",
   "properties": {
    "A": {"$ref": "#/$defs/milestone"},
    "B": {"$ref": "#/$defs/milestone"},
    "C": {"$ref": "#/$defs/milestone"}
   },
   "required": ["A", "B", "C"],
   "additionalProperties": false
  },
  "conventions": {
   "type": "object",
   "properties": {
    "axial_coordinate": {"type": "string", "minLength": 1},
    "quantity_status_meanings": {
     "type": "object",
     "properties": {
      "TBD": {"type": "string"},
      "PROPOSED": {"type": "string"},
      "SOURCED": {"type": "string"},
      "OWNER_DECIDED": {"type": "string"}
     },
     "required": ["TBD", "PROPOSED", "SOURCED", "OWNER_DECIDED"],
     "additionalProperties": false
    },
    "evidence_classes": {
     "type": "array",
     "items": {"$ref": "#/$defs/evidence_class"},
     "minItems": 6,
     "uniqueItems": true
    },
    "evidence_levels": {"type": "string", "minLength": 1},
    "numbers_policy": {"type": "string", "minLength": 1}
   },
   "required": ["axial_coordinate", "quantity_status_meanings", "evidence_classes", "evidence_levels", "numbers_policy"],
   "additionalProperties": false
  },
  "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}, "minItems": 1},
  "geometry_interface": {
   "type": "object",
   "properties": {
    "description": {"type": "string", "minLength": 1},
    "fields": {
     "type": "object",
     "properties": {
      "channel_mean_radius_m": {"$ref": "#/$defs/quantity"},
      "channel_width_m": {"$ref": "#/$defs/quantity"},
      "channel_length_m": {"$ref": "#/$defs/quantity"},
      "anode_axial_position": {"$ref": "#/$defs/quantity"},
      "exit_plane_axial_position": {"$ref": "#/$defs/quantity"},
      "domain_length_m": {"$ref": "#/$defs/quantity"},
      "anode_gas_distributor": {"$ref": "#/$defs/quantity"},
      "wall_material": {"$ref": "#/$defs/quantity"},
      "magnetically_shielded": {"$ref": "#/$defs/quantity"}
     },
     "required": ["channel_mean_radius_m", "channel_width_m", "channel_length_m", "anode_axial_position",
                  "exit_plane_axial_position", "domain_length_m", "anode_gas_distributor", "wall_material",
                  "magnetically_shielded"],
     "additionalProperties": false
    },
    "bridge_mapping": {"type": "object", "additionalProperties": {"type": "string"}},
    "sizing_relations": {"type": "array", "items": {"$ref": "#/$defs/evidence_relation"}, "minItems": 1},
    "forbidden_value_sources": {"type": "array", "items": {"type": "string"}, "minItems": 1}
   },
   "required": ["description", "fields", "bridge_mapping", "sizing_relations", "forbidden_value_sources"],
   "additionalProperties": false
  },
  "bfield_interface": {
   "type": "object",
   "properties": {
    "description": {"type": "string", "minLength": 1},
    "shape_families": {
     "type": "object",
     "properties": {
      "measured_or_computed_profile": {"$ref": "#/$defs/shape_family"},
      "asymmetric_gaussian_exit_peaked": {"$ref": "#/$defs/shape_family"}
     },
     "required": ["measured_or_computed_profile", "asymmetric_gaussian_exit_peaked"],
     "additionalProperties": false
    },
    "fields": {
     "type": "object",
     "properties": {
      "shape_family": {"$ref": "#/$defs/quantity"},
      "profile_file": {"$ref": "#/$defs/quantity"},
      "profile_sha256": {"$ref": "#/$defs/quantity"},
      "field_origin": {"$ref": "#/$defs/quantity"},
      "B_max_T": {"$ref": "#/$defs/quantity"},
      "peak_position_rel_exit_m": {"$ref": "#/$defs/quantity"},
      "B_anode_over_B_max": {"$ref": "#/$defs/quantity"},
      "registration_align": {"$ref": "#/$defs/quantity"},
      "registration_z_ref_in_file_mm": {"$ref": "#/$defs/quantity"},
      "scale_to": {"$ref": "#/$defs/quantity"},
      "B_ref_T": {"$ref": "#/$defs/quantity"},
      "gaussian_sigma_in_m": {"$ref": "#/$defs/quantity"},
      "gaussian_sigma_out_m": {"$ref": "#/$defs/quantity"},
      "solver_magnetic_field_scale": {"$ref": "#/$defs/quantity"},
      "magnet_setting_schedule": {"$ref": "#/$defs/quantity"}
     },
     "required": ["shape_family", "profile_file", "profile_sha256", "field_origin", "B_max_T", "peak_position_rel_exit_m",
                  "B_anode_over_B_max", "registration_align", "registration_z_ref_in_file_mm", "scale_to", "B_ref_T",
                  "gaussian_sigma_in_m", "gaussian_sigma_out_m", "solver_magnetic_field_scale", "magnet_setting_schedule"],
     "additionalProperties": false
    },
    "bridge_compatibility_rules": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "design_evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence_relation"}, "minItems": 1},
    "forbidden_value_sources": {"type": "array", "items": {"type": "string"}, "minItems": 1}
   },
   "required": ["description", "shape_families", "fields", "bridge_compatibility_rules", "design_evidence",
                "forbidden_value_sources"],
   "additionalProperties": false
  },
  "discharge_voltage_interface": {
   "type": "object",
   "properties": {
    "description": {"type": "string", "minLength": 1},
    "supply_definition": {"type": "string", "minLength": 1},
    "proposed_range_V": {"$ref": "#/$defs/quantity"},
    "proposed_evaluation_set_V": {"$ref": "#/$defs/quantity"},
    "requirements": {
     "type": "object",
     "properties": {
      "thrust_mN": {"$ref": "#/$defs/quantity"},
      "power_max_W": {"$ref": "#/$defs/quantity"}
     },
     "required": ["thrust_mN", "power_max_W"],
     "additionalProperties": false
    },
    "literature_operating_points": {"type": "array", "items": {"$ref": "#/$defs/operating_point"}, "minItems": 1},
    "voltage_evidence_notes": {"type": "array", "items": {"$ref": "#/$defs/evidence_relation"}},
    "envelope_relations": {"type": "array", "items": {"$ref": "#/$defs/evidence_relation"}, "minItems": 1},
    "ideal_beam_reference_table": {
     "type": "object",
     "properties": {
      "generated_by": {"type": "string", "pattern": "^docs/architecture_comparison/hall_reference/[A-Za-z0-9_]+\\.py$"},
      "role": {"type": "string", "minLength": 1},
      "assumptions": {"type": "array", "items": {"type": "string"}, "minItems": 1},
      "voltages_from": {"type": "string", "pattern": "^/"},
      "ions": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
      "rows": {
       "type": "object",
       "additionalProperties": {
        "type": "object",
        "properties": {
         "ion_mass_u": {"$ref": "#/$defs/quantity"},
         "v_b_m_s": {"$ref": "#/$defs/quantity"},
         "thrust_per_jet_power_mN_per_kW": {"$ref": "#/$defs/quantity"}
        },
        "required": ["ion_mass_u", "v_b_m_s", "thrust_per_jet_power_mN_per_kW"],
        "additionalProperties": false
       }
      }
     },
     "required": ["generated_by", "role", "assumptions", "voltages_from", "ions", "rows"],
     "additionalProperties": false
    },
    "superseded_grid_note": {"type": "string"}
   },
   "required": ["description", "supply_definition", "proposed_range_V", "proposed_evaluation_set_V", "requirements",
                "literature_operating_points", "voltage_evidence_notes", "envelope_relations",
                "ideal_beam_reference_table", "superseded_grid_note"],
   "additionalProperties": false
  },
  "cathode_interface": {
   "type": "object",
   "properties": {
    "description": {"type": "string", "minLength": 1},
    "fields": {"type": "object", "additionalProperties": {"$ref": "#/$defs/quantity"}, "minProperties": 1},
    "bus_components": {"type": "array", "items": {"$ref": "#/$defs/bus_component"}, "minItems": 1},
    "value_owner": {"type": "string", "minLength": 1},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence_relation"}, "minItems": 1}
   },
   "required": ["description", "fields", "bus_components", "value_owner", "evidence"],
   "additionalProperties": false
  },
  "wall_life_interface": {
   "type": "object",
   "properties": {
    "description": {"type": "string", "minLength": 1},
    "hall_map_schema_file": {"const": "hallthruster_bridge/hall_map_schema_v1.json"},
    "hall_map_fields": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "hall_map_meta": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "wall_life_trustworthy_conditions": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "query_level_rule": {"type": "string", "minLength": 1},
    "raw_record_fields": {"type": "array", "items": {"type": "string"}},
    "design_inputs": {"type": "object", "additionalProperties": {"$ref": "#/$defs/quantity"}, "minProperties": 1},
    "consumers": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "rules": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence_relation"}, "minItems": 1}
   },
   "required": ["description", "hall_map_schema_file", "hall_map_fields", "hall_map_meta", "wall_life_trustworthy_conditions",
                "query_level_rule", "raw_record_fields", "design_inputs", "consumers", "rules", "evidence"],
   "additionalProperties": false
  },
  "injection_interface": {
   "type": "object",
   "properties": {
    "description": {"type": "string", "minLength": 1},
    "plane": {
     "type": "object",
     "properties": {
      "id": {"const": "HALL_INLET_Z0"},
      "location": {"type": "string", "minLength": 1},
      "coordinate": {"type": "string", "minLength": 1},
      "notes": {"type": "string"}
     },
     "required": ["id", "location", "coordinate", "notes"],
     "additionalProperties": false
    },
    "applies_to": {
     "type": "object",
     "properties": {
      "hall_only": {"type": "string", "minLength": 1},
      "rf_hall": {"type": "string", "minLength": 1},
      "ecr_hall": {"type": "string", "minLength": 1}
     },
     "required": ["hall_only", "rf_hall", "ecr_hall"],
     "additionalProperties": false
    },
    "upstream_links": {"type": "object", "additionalProperties": {"type": "string"}, "minProperties": 1},
    "representation": {"$ref": "#/$defs/quantity"},
    "inlet_state_fields": {"type": "object", "additionalProperties": {"$ref": "#/$defs/inlet_field"}, "minProperties": 1},
    "conservation_rules": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "solver_capability": {
     "type": "object",
     "properties": {
      "status": {"enum": ["SUPPORTED", "PARTIAL", "GAP"]},
      "findings": {"type": "array", "items": {"$ref": "#/$defs/evidence_relation"}, "minItems": 1},
      "consequence": {"type": "string", "minLength": 1}
     },
     "required": ["status", "findings", "consequence"],
     "additionalProperties": false
    },
    "reconciliation_with_interstage_lane": {
     "type": "object",
     "properties": {
      "status": {"enum": ["PENDING", "RECONCILED"]},
      "contract_path": {"$ref": "#/$defs/quantity"},
      "rule": {"type": "string", "minLength": 1}
     },
     "required": ["status", "contract_path", "rule"],
     "additionalProperties": false
    }
   },
   "required": ["description", "plane", "applies_to", "upstream_links", "representation", "inlet_state_fields",
                "conservation_rules", "solver_capability", "reconciliation_with_interstage_lane"],
   "additionalProperties": false
  },
  "transport_numerics_binding": {
   "type": "object",
   "properties": {
    "transport_member_id": {"$ref": "#/$defs/quantity"},
    "transport_rule": {"type": "string", "minLength": 1},
    "screening_candidates_policy": {"type": "string", "minLength": 1},
    "chemistry": {
     "type": "object",
     "properties": {
      "reaction_set": {"$ref": "#/$defs/quantity"},
      "rule": {"type": "string", "minLength": 1}
     },
     "required": ["reaction_set", "rule"],
     "additionalProperties": false
    },
    "numerics": {
     "type": "object",
     "properties": {
      "rule": {"type": "string", "minLength": 1},
      "reference": {"type": "string", "minLength": 1}
     },
     "required": ["rule", "reference"],
     "additionalProperties": false
    },
    "solver_settings": {"type": "object", "additionalProperties": {"$ref": "#/$defs/quantity"}, "minProperties": 1},
    "solver_pin": {
     "type": "object",
     "properties": {
      "package": {"const": "HallThruster.jl"},
      "version": {"type": "string"},
      "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
      "source": {"type": "string"}
     },
     "required": ["package", "version", "commit", "source"],
     "additionalProperties": false
    },
    "facility_ingestion": {"$ref": "#/$defs/quantity"},
    "calibration_nuisance_policy": {
     "type": "object",
     "properties": {
      "keys": {"type": "array", "items": {"type": "string"}, "minItems": 1},
      "source": {"type": "string"},
      "rule": {"type": "string", "minLength": 1}
     },
     "required": ["keys", "source", "rule"],
     "additionalProperties": false
    }
   },
   "required": ["transport_member_id", "transport_rule", "screening_candidates_policy", "chemistry", "numerics",
                "solver_settings", "solver_pin", "facility_ingestion", "calibration_nuisance_policy"],
   "additionalProperties": false
  },
  "bus_power_boundary": {
   "type": "object",
   "properties": {
    "module": {"const": "abep_sim/arch_boundary.py"},
    "boundary_version": {"const": "bus_power_boundary_v1"},
    "common_hall_components": {"type": "array", "items": {"$ref": "#/$defs/bus_component"}, "minItems": 1, "uniqueItems": true},
    "other_common_components": {"type": "array", "items": {"$ref": "#/$defs/bus_component"}, "uniqueItems": true},
    "arm_specific_components": {
     "type": "object",
     "properties": {
      "hall_only": {"type": "array", "items": {"$ref": "#/$defs/bus_component"}, "maxItems": 0},
      "rf_hall": {"type": "array", "items": {"$ref": "#/$defs/bus_component"}, "minItems": 1},
      "ecr_hall": {"type": "array", "items": {"$ref": "#/$defs/bus_component"}, "minItems": 1}
     },
     "required": ["hall_only", "rf_hall", "ecr_hall"],
     "additionalProperties": false
    },
    "relation": {"$ref": "#/$defs/evidence_relation"},
    "status_at_authoring": {"type": "string", "minLength": 1}
   },
   "required": ["module", "boundary_version", "common_hall_components", "other_common_components",
                "arm_specific_components", "relation", "status_at_authoring"],
   "additionalProperties": false
  },
  "invariance_rules": {"type": "array", "items": {"$ref": "#/$defs/invariance_rule"}, "minItems": 1},
  "allowed_differences": {"type": "array", "items": {"type": "string"}, "minItems": 1},
  "related_contracts": {"type": "object", "additionalProperties": {"$ref": "#/$defs/contract_ref"}, "minProperties": 1},
  "open_questions_for_owner": {"type": "array", "items": {"type": "string"}, "minItems": 1}
 },
 "required": ["schema", "schema_file", "reference_id", "version", "status", "date", "code_baseline_commit", "architectures",
              "scope", "milestones", "conventions", "sources", "geometry_interface", "bfield_interface",
              "discharge_voltage_interface", "cathode_interface", "wall_life_interface", "injection_interface",
              "transport_numerics_binding", "bus_power_boundary", "invariance_rules", "allowed_differences",
              "related_contracts", "open_questions_for_owner"],
 "additionalProperties": false,
 "$defs": {
  "evidence_class": {"enum": ["measured", "digitized", "inferred", "reconstructed", "model-derived", "assumed"]},
  "evidence_level": {"enum": ["1", "2", "3", "4", "5", "6", "7"]},
  "bus_component": {"enum": ["hall_discharge", "hall_magnet", "cathode_keeper", "cathode_heater", "flow_control", "compressor",
                             "thermal_control", "housekeeping", "rf_source", "ecr_source", "ecr_magnet"]},
  "quantity": {
   "type": "object",
   "properties": {
    "definition": {"type": "string", "minLength": 1},
    "value": {"type": ["number", "string", "boolean", "array", "null"]},
    "unit": {"type": "string", "minLength": 1},
    "status": {"enum": ["TBD", "PROPOSED", "SOURCED", "OWNER_DECIDED"]},
    "evidence_class": {"anyOf": [{"$ref": "#/$defs/evidence_class"}, {"type": "null"}]},
    "source": {"type": "array", "items": {"type": "string", "pattern": "^SRC-"}},
    "locator": {"type": "string", "minLength": 1},
    "requires": {"type": "string", "pattern": "^TBD — requires "},
    "rationale": {"type": "string", "minLength": 1},
    "uncertainty": {"type": "string"},
    "allowed_values": {"type": "array"},
    "maps_to": {"type": "string"},
    "evidence": {"type": "array", "items": {"type": "string", "pattern": "^(EV|ER|SC)-[A-Z0-9-]+$"}},
    "notes": {"type": "string"}
   },
   "required": ["definition", "value", "unit", "status"],
   "additionalProperties": false,
   "anyOf": [
    {
     "properties": {"status": {"const": "TBD"}, "value": {"type": "null"}},
     "required": ["requires"]
    },
    {
     "properties": {
      "status": {"const": "PROPOSED"},
      "value": {"type": ["number", "string", "boolean", "array"]},
      "evidence_class": {"$ref": "#/$defs/evidence_class"},
      "source": {"type": "array", "minItems": 1}
     },
     "required": ["rationale", "evidence_class", "source"]
    },
    {
     "properties": {
      "status": {"const": "SOURCED"},
      "value": {"type": ["number", "string", "boolean", "array"]},
      "evidence_class": {"$ref": "#/$defs/evidence_class"},
      "source": {"type": "array", "minItems": 1}
     },
     "required": ["evidence_class", "source", "locator"]
    },
    {
     "properties": {
      "status": {"const": "OWNER_DECIDED"},
      "value": {"type": ["number", "string", "boolean", "array"]},
      "evidence_class": {"$ref": "#/$defs/evidence_class"},
      "source": {"type": "array", "minItems": 1}
     },
     "required": ["evidence_class", "source", "locator"]
    }
   ]
  },
  "source": {
   "type": "object",
   "properties": {
    "id": {"type": "string", "pattern": "^SRC-[A-Z0-9-]+$"},
    "kind": {"enum": ["open_literature", "repository_file", "software_source", "other_lane_contract"]},
    "citation": {"type": "string", "minLength": 1},
    "doi": {"type": "string"},
    "url_accessed": {"type": "string"},
    "path": {"type": "string"},
    "accessed": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "access": {"type": "string", "minLength": 1},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "licence": {"type": "string"},
    "evidence_level": {"$ref": "#/$defs/evidence_level"},
    "notes": {"type": "string"}
   },
   "required": ["id", "kind", "citation", "access"],
   "additionalProperties": false,
   "anyOf": [
    {"properties": {"kind": {"const": "open_literature"}}, "required": ["evidence_level", "url_accessed", "accessed", "sha256"]},
    {"properties": {"kind": {"enum": ["repository_file", "software_source", "other_lane_contract"]}}, "required": ["path"]}
   ]
  },
  "evidence_relation": {
   "type": "object",
   "properties": {
    "id": {"type": "string", "pattern": "^(EV|ER|SC)-[A-Z0-9-]+$"},
    "relation": {"type": "string", "minLength": 1},
    "source": {"type": "array", "items": {"type": "string", "pattern": "^SRC-"}, "minItems": 1},
    "locator": {"type": "string", "minLength": 1},
    "evidence_level": {"$ref": "#/$defs/evidence_level"},
    "quantity_type": {"type": "string", "minLength": 1},
    "applicability": {"type": "string", "minLength": 1},
    "transfer_note": {"type": "string"},
    "stated_values": {"type": "object", "additionalProperties": {"$ref": "#/$defs/quantity"}},
    "role": {"enum": ["evidence, not a decision", "identity used for rationale", "solver-capability finding",
                      "interface definition"]}
   },
   "required": ["id", "relation", "source", "locator", "evidence_level", "quantity_type", "applicability", "role"],
   "additionalProperties": false
  },
  "operating_point": {
   "type": "object",
   "properties": {
    "device": {"type": "string", "minLength": 1},
    "device_class": {"type": "string", "minLength": 1},
    "gas": {"type": "string", "minLength": 1},
    "propellant_family": {"enum": ["light", "xenon"]},
    "discharge_voltage_V": {"$ref": "#/$defs/quantity"},
    "evidence_level": {"$ref": "#/$defs/evidence_level"},
    "notes": {"type": "string"}
   },
   "required": ["device", "device_class", "gas", "propellant_family", "discharge_voltage_V", "evidence_level", "notes"],
   "additionalProperties": false
  },
  "shape_family": {
   "type": "object",
   "properties": {
    "description": {"type": "string", "minLength": 1},
