{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:abep:schemas:architecture_comparison:bus_power_boundary_v1",
  "title": "ABEP common bus-power boundary v1",
  "description": "Inputs and output of abep_sim.arch_boundary.bus_power_ledger (boundary bus_power_boundary_v1): one electrical boundary, the spacecraft DC bus input to the propulsion subsystem, identical for hall_only, rf_hall and ecr_hall. Common components are identical across architectures; pre-ionized architectures add exactly their pre-ionizer components. Every component needs an explicit load and efficiency (no defaults). Component definitions and reference planes: docs/architecture_comparison/power_boundary/BUS_POWER_BOUNDARY.md.",
  "x-boundary_version": "bus_power_boundary_v1",
  "x-common_components": [
    "hall_discharge",
    "hall_magnet",
    "cathode_keeper",
    "cathode_heater",
    "flow_control",
    "compressor",
    "thermal_control",
    "housekeeping"
  ],
  "x-preionizer_components": {
    "hall_only": [],
    "rf_hall": [
      "rf_source"
    ],
    "ecr_hall": [
      "ecr_source",
      "ecr_magnet"
    ]
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "inputs",
    "ledger"
  ],
  "properties": {
    "inputs": {
      "$ref": "#/$defs/inputs"
    },
    "ledger": {
      "$ref": "#/$defs/ledger"
    }
  },
  "$defs": {
    "architecture": {
      "description": "Architecture on the common boundary.",
      "enum": [
        "hall_only",
        "rf_hall",
        "ecr_hall"
      ]
    },
    "component": {
      "description": "Component key of bus_power_boundary_v1 (eight common + pre-ionizer components).",
      "enum": [
        "hall_discharge",
        "hall_magnet",
        "cathode_keeper",
        "cathode_heater",
        "flow_control",
        "compressor",
        "thermal_control",
        "housekeeping",
        "rf_source",
        "ecr_source",
        "ecr_magnet"
      ]
    },
    "load_W": {
      "description": "Delivered load-side power at the component's reference plane [W]; finite, >= 0.",
      "type": "number",
      "minimum": 0
    },
    "efficiency": {
      "description": "DC-bus-to-load efficiency at the operating point, in (0, 1]. No defaults exist.",
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1
    },
    "power_W": {
      "type": "number",
      "minimum": 0
    },
    "ledger_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "P_load_W",
        "efficiency",
        "P_bus_W",
        "P_loss_W"
      ],
      "properties": {
        "component": {
          "$ref": "#/$defs/component"
        },
        "P_load_W": {
          "$ref": "#/$defs/load_W"
        },
        "efficiency": {
          "$ref": "#/$defs/efficiency"
        },
        "P_bus_W": {
          "description": "P_load_W / efficiency [W]",
          "$ref": "#/$defs/power_W"
        },
        "P_loss_W": {
          "description": "P_bus_W - P_load_W [W]: conversion loss between the bus and the load plane",
          "$ref": "#/$defs/power_W"
        }
      }
    },
