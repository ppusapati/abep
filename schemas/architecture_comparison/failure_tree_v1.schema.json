{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "urn:abep:schemas:architecture_comparison:failure_tree_v1",
 "title": "ABEP architecture-specific failure trees v1",
 "description": "Schema for docs/architecture_comparison/failure_tree/failure_trees_v1.json: one failure tree per thrust architecture (hall_only, rf_hall, ecr_hall). Each node names a way the architecture could fail the programme, its physical cause with open-literature evidence (source, evidence class, direction), a deterministic evidence status, the quantity and threshold that decide it (linked to hard-gate ids), and the actions (literature / analysis / measurement) that would resolve it. The ranking of next evidence is generated by docs/architecture_comparison/failure_tree/derive_failure_tree.py. Only these JSON Schema keywords are used: $schema, $id, $defs, $ref, title, description, type, required, properties, additionalProperties, items, enum, const, pattern, minItems, uniqueItems, minLength, minimum, maximum (tests/test_failure_tree.py validates with a minimal validator restricted to this list).",
 "type": "object",
 "additionalProperties": false,
 "required": ["schema", "id", "version", "status", "date", "base_commit", "lane", "scope", "no_winner_statement", "milestones",
  "architectures", "hard_gates", "hard_gate_matrix_link", "lanes", "failure_classes", "design_branches", "evidence_status_rule", "elimination_rule", "eliminations",
  "sources", "actions", "action_effects", "nodes", "ranking_rule", "derived_values", "ranked_next_evidence", "open_questions_for_owner"],
 "properties": {
  "schema": {"const": "failure_tree_v1"},
  "id": {"const": "failure_trees_v1"},
  "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
  "status": {"type": "string", "minLength": 1},
  "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
  "base_commit": {"type": "string", "pattern": "^[0-9a-f]{7,40}$"},
  "lane": {"type": "string", "minLength": 1},
  "scope": {"type": "string", "minLength": 1},
  "no_winner_statement": {"type": "string", "minLength": 1},
  "milestones": {"$ref": "#/$defs/milestones"},
  "architectures": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/architecture"}},
  "hard_gates": {"type": "array", "minItems": 7, "items": {"$ref": "#/$defs/hard_gate"}},
  "hard_gate_matrix_link": {"$ref": "#/$defs/hard_gate_matrix_link"},
  "lanes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/lane"}},
  "failure_classes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/failure_class"}},
  "design_branches": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/design_branch"}},
  "evidence_status_rule": {"$ref": "#/$defs/evidence_status_rule"},
  "elimination_rule": {"$ref": "#/$defs/elimination_rule"},
  "eliminations": {"type": "array", "items": {"$ref": "#/$defs/elimination"}},
  "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}},
  "actions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/action"}},
  "action_effects": {"$ref": "#/$defs/action_effects"},
  "nodes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/node"}},
  "ranking_rule": {"$ref": "#/$defs/ranking_rule"},
  "derived_values": {"$ref": "#/$defs/derived_values"},
  "ranked_next_evidence": {"$ref": "#/$defs/ranked_next_evidence"},
  "open_questions_for_owner": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
 },
 "$defs": {
  "arch_id": {"enum": ["hall_only", "rf_hall", "ecr_hall"]},
  "gate_id": {"enum": ["thrust", "bus_power", "mass", "firing_life", "mission_life", "restart_sustainment", "air_xe"]},
  "milestone": {"enum": ["A", "B", "C"]},
  "matrix_gate_id": {"enum": ["G1_thrust", "G2_bus_power", "G3_mass", "G4_firing_life", "G5_mission", "G6_ignition_sustainment", "G7_air_xenon"]},
  "matrix_proposed_gate_id": {"enum": ["P1_thermal", "P2_cathode"]},
  "hard_gate_matrix_link": {
   "type": "object", "additionalProperties": false,
   "required": ["path", "matrix_schema", "availability", "binding_gates", "proposed_gates", "proposed_gate_note", "mapping_status"],
   "properties": {
    "path": {"const": "docs/architecture_comparison/hard_gates/hard_gate_matrix_v1.json"},
    "matrix_schema": {"const": "hard_gate_matrix_v1"},
    "availability": {"type": "string", "minLength": 1},
    "binding_gates": {"type": "array", "minItems": 7, "uniqueItems": true, "items": {"$ref": "#/$defs/matrix_gate_id"}},
    "proposed_gates": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/matrix_proposed_gate_id"}},
    "proposed_gate_note": {"type": "string", "minLength": 1},
    "mapping_status": {"type": "string", "minLength": 1}
   }
  },
  "evidence_class": {"enum": ["measured", "digitized", "inferred", "reconstructed", "model-derived", "assumed"]},
  "action_kind": {"enum": ["literature", "analysis", "measurement"]},
  "rfp_block": {"enum": ["gas_supply_upstream", "ionization_discharge", "acceleration_thrust", "cathode", "power_bus", "thermal", "structure_mass", "operations"]},
  "milestones": {
   "type": "object", "additionalProperties": false,
   "required": ["supports", "definitions", "provides_for_A", "to_reach_B", "to_reach_C"],
   "properties": {
    "supports": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/milestone"}},
    "definitions": {"type": "object", "additionalProperties": false, "required": ["A", "B", "C"],
     "properties": {"A": {"type": "string", "minLength": 1}, "B": {"type": "string", "minLength": 1}, "C": {"type": "string", "minLength": 1}}},
    "provides_for_A": {"type": "string", "minLength": 1},
    "to_reach_B": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "to_reach_C": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
   }
  },
  "architecture": {
   "type": "object", "additionalProperties": false,
   "required": ["id", "pre_ionization", "description"],
   "properties": {
    "id": {"$ref": "#/$defs/arch_id"},
    "pre_ionization": {"enum": ["none", "rf", "ecr"]},
    "description": {"type": "string", "minLength": 1}
   }
  },
  "hard_gate": {
   "type": "object", "additionalProperties": false,
   "required": ["id", "matrix_gate_id", "title", "threshold", "threshold_status", "source", "existing_checks"],
   "properties": {
    "id": {"$ref": "#/$defs/gate_id"},
    "matrix_gate_id": {"$ref": "#/$defs/matrix_gate_id"},
    "title": {"type": "string", "minLength": 1},
    "threshold": {"type": "object", "additionalProperties": false, "required": ["text", "values"],
     "properties": {
      "text": {"type": "string", "minLength": 1},
      "values": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["name", "value", "unit", "rfp_constant"],
       "properties": {"name": {"type": "string"}, "value": {"type": "number"}, "unit": {"type": "string"}, "rfp_constant": {"type": "string"}}}}
     }},
    "threshold_status": {"enum": ["RFP", "RFP_with_TBD_count", "RFP_with_TBD_share"]},
    "source": {"type": "string", "minLength": 1},
    "existing_checks": {"type": "array", "items": {"type": "string"}},
    "tbd": {"type": "string"}
   }
  },
  "lane": {
   "type": "object", "additionalProperties": false,
   "required": ["id", "name", "deliverable", "availability"],
   "properties": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "name": {"type": "string", "minLength": 1},
    "deliverable": {"type": "string", "minLength": 1},
    "availability": {"type": "string", "minLength": 1}
   }
  },
  "failure_class": {
   "type": "object", "additionalProperties": false,
   "required": ["id", "name", "generic", "applies_to", "description"],
   "properties": {
    "id": {"type": "string", "pattern": "^FC-[A-Z]{3}$"},
    "name": {"type": "string", "pattern": "^[a-z_]+$"},
    "generic": {"type": "boolean"},
    "applies_to": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/arch_id"}},
    "description": {"type": "string", "minLength": 1}
   }
  },
  "design_branch": {
   "description": "A design decision with mutually exclusive options whose failure paths differ (e.g. cathode feed). Nodes specific to one option carry it in 'branch' and are ranked per option, never in the core ranking.",
   "type": "object", "additionalProperties": false,
   "required": ["id", "applies_to", "status", "description", "options"],
   "properties": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "applies_to": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/arch_id"}},
    "status": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "options": {"type": "array", "minItems": 2, "items": {"type": "object", "additionalProperties": false, "required": ["id", "description"],
     "properties": {"id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}, "description": {"type": "string", "minLength": 1}}}}
   }
  },
  "branch_ref": {
   "description": "One design-branch option (design_branches[].id and one of its options[].id). A node or action carrying it applies only if that option is chosen.",
   "type": "object", "additionalProperties": false, "required": ["decision", "option"],
   "properties": {"decision": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}, "option": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}}
  },
  "evidence_status_rule": {
   "type": "object", "additionalProperties": false,
   "required": ["meaning", "directions", "rule", "unknown_basis"],
   "properties": {
    "meaning": {"type": "string", "minLength": 1},
    "directions": {"type": "object"},
    "rule": {"type": "array", "minItems": 3, "items": {"type": "string"}},
    "unknown_basis": {"type": "object"}
   }
  },
  "elimination_rule": {
   "type": "object", "additionalProperties": false,
   "required": ["status", "text"],
   "properties": {"status": {"const": "PROPOSED"}, "text": {"type": "string", "minLength": 1}}
  },
  "elimination": {
   "type": "object", "additionalProperties": false,
   "required": ["architecture", "node", "gate", "evidence"],
   "properties": {"architecture": {"$ref": "#/$defs/arch_id"}, "node": {"type": "string"}, "gate": {"$ref": "#/$defs/gate_id"}, "evidence": {"type": "string"}}
  },
  "source": {
   "type": "object", "additionalProperties": false,
   "required": ["id", "citation", "access", "retrieved_via", "accessed"],
   "properties": {
    "id": {"type": "string", "pattern": "^S-[A-Z0-9]+$"},
    "citation": {"type": "string", "minLength": 1},
    "doi": {"type": "string", "pattern": "^10\\.[0-9]{4,}/\\S+$"},
    "arxiv": {"type": "string", "pattern": "^[0-9]{4}\\.[0-9]{4,5}(v[0-9]+)?$"},
    "report_id": {"type": "string"},
    "access": {"enum": ["full_text_open", "abstract_only", "repo_audit", "identified_not_read"]},
    "retrieved_via": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "accessed": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "license": {"type": "string"},
    "notes": {"type": "string"}
   }
  },
  "action": {
   "type": "object", "additionalProperties": false,
   "required": ["id", "kind", "title", "description", "lane", "deliverable", "blocked_by"],
   "properties": {
    "id": {"type": "string", "pattern": "^[LAM]-[A-Z0-9]+$"},
    "kind": {"$ref": "#/$defs/action_kind"},
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "lane": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "deliverable": {"type": "string", "minLength": 1},
    "blocked_by": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "branch": {"$ref": "#/$defs/branch_ref"},
    "specified_by": {"description": "Lanes that specify the protocol or requirement of a measurement action; the executing lane is 'lane'.", "type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}},
    "targets": {"type": "array", "items": {"type": "string"}}
   }
  },
  "action_effects": {
   "type": "object", "additionalProperties": false,
   "required": ["decides", "contributes", "informs", "rule"],
   "properties": {
    "decides": {"type": "string", "minLength": 1}, "contributes": {"type": "string", "minLength": 1},
    "informs": {"type": "string", "minLength": 1}, "rule": {"type": "string", "minLength": 1}
   }
  },
  "evidence_item": {
   "type": "object", "additionalProperties": false,
   "required": ["source", "direction", "evidence_class", "evidence_level", "statement", "locator", "applicability"],
   "properties": {
    "source": {"type": "string", "pattern": "^S-[A-Z0-9]+$"},
    "direction": {"enum": ["supports", "contradicts", "context"]},
    "evidence_class": {"$ref": "#/$defs/evidence_class"},
    "evidence_level": {"type": "integer", "minimum": 1, "maximum": 7},
    "statement": {"type": "string", "minLength": 1},
    "locator": {"type": "string", "minLength": 1},
    "applicability": {"type": "string", "minLength": 1},
    "gas_not_stated": {"description": "true when the source does not state the gas or composition for the cited result; on an air_specific node such an item can only be 'context'.", "type": "boolean"},
    "gas_stated": {"description": "The gas the source states for the cited result. Required on a decisive item (supports/contradicts) of an air_specific node when another item of the same source is gas_not_stated.", "type": "string", "minLength": 1}
   }
  },
  "node_action": {
   "type": "object", "additionalProperties": false,
   "required": ["action", "effect"],
   "properties": {
    "action": {"type": "string", "pattern": "^[LAM]-[A-Z0-9]+$"},
    "effect": {"enum": ["decides", "contributes", "informs"]}
   }
  },
  "decision_quantity": {
   "type": "object", "additionalProperties": false,
   "required": ["quantity", "threshold", "threshold_status", "requires_actions", "requires_owner_inputs", "gates"],
   "properties": {
    "quantity": {"type": "string", "minLength": 1},
    "threshold": {"type": "string", "minLength": 1},
    "threshold_status": {"enum": ["RFP", "PROPOSED", "TBD", "physics_bound"]},
    "requires": {"type": "string"},
    "requires_actions": {"description": "Every action whose output the threshold comparison needs. Each is 'contributes' on the node (or is its single deciding action); no other action may decide the node.", "type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[LAM]-[A-Z0-9]+$"}},
    "requires_owner_inputs": {"description": "Owner-fixed inputs (thresholds, margins, allocations, allowed Xe roles, operations assumptions) the comparison needs; these do not stop an action from deciding.", "type": "array", "items": {"type": "string", "minLength": 1}},
    "derived_values": {"type": "array", "items": {"type": "string", "pattern": "^D-[A-Z0-9.-]+$"}},
    "gates": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/gate_id"}}
   }
  },
  "node": {
   "type": "object", "additionalProperties": false,
   "required": ["id", "architectures", "failure_class", "title", "rfp_blocks", "air_specific", "mechanism", "physical_cause", "evidence",
    "evidence_status", "decision_quantity", "actions", "cheapest_resolution", "resolve_by_milestone", "milestone_A_condition",
    "analysis_requires_admitted_hall_closure", "decision_state"],
   "properties": {
    "id": {"type": "string", "pattern": "^N-[A-Z]{2,3}-[A-Z0-9]+$"},
    "architectures": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/arch_id"}},
    "failure_class": {"type": "string", "pattern": "^FC-[A-Z]{3}$"},
    "sub_cause_of": {"description": "Parent node whose threshold comparison this node repeats (a contributing cause: an architecture-specific component, or the mechanism behind the parent's quantity). Sub-causes are listed but not counted in the ranking.", "type": "string", "pattern": "^N-[A-Z]{2,3}-[A-Z0-9]+$"},
    "title": {"type": "string", "minLength": 1},
    "condition": {"description": "Plain-text applicability condition; present exactly when 'branch' is (the test enforces the pairing).", "type": "string", "minLength": 1},
    "branch": {"$ref": "#/$defs/branch_ref"},
    "rfp_blocks": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/rfp_block"}},
    "air_specific": {"description": "true when the node's decision quantity is evaluated on the atmospheric (air / N2 / O2) feed or its mechanism depends on N/O species; evidence whose gas is not stated cannot decide it.", "type": "boolean"},
    "mechanism": {"type": "string", "minLength": 1},
    "physical_cause": {"type": "string", "minLength": 1},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence_item"}},
    "evidence_gap": {"type": "string", "minLength": 1},
    "evidence_status": {"enum": ["supported", "contradicted", "unknown"]},
    "decision_quantity": {"$ref": "#/$defs/decision_quantity"},
    "actions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/node_action"}},
    "cheapest_resolution": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[LAM]-[A-Z0-9]+$"}},
    "resolve_by_milestone": {"enum": ["B", "C"]},
    "milestone_A_condition": {"type": "string", "minLength": 1},
    "analysis_requires_admitted_hall_closure": {"type": "boolean"},
    "upstream_hall_independent": {"type": "boolean"},
    "proposed_gate_links": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/matrix_proposed_gate_id"}},
    "decision_state": {"enum": ["open", "resolved_pass", "resolved_fail"]}
   }
  },
  "ranking_rule": {
   "type": "object", "additionalProperties": false,
   "required": ["id", "text", "eligibility", "branch_rule", "key", "cost_rank", "no_weighting"],
   "properties": {
    "id": {"const": "decisiveness_lexicographic_v2"},
    "text": {"type": "string", "minLength": 1},
    "eligibility": {"type": "string", "minLength": 1},
    "branch_rule": {"type": "string", "minLength": 1},
    "key": {"type": "array", "minItems": 6, "items": {"type": "string"}},
    "cost_rank": {"type": "object", "additionalProperties": false, "required": ["literature", "analysis", "measurement"],
     "properties": {"literature": {"const": 0}, "analysis": {"const": 1}, "measurement": {"const": 2}}},
    "no_weighting": {"type": "string", "minLength": 1}
   }
  },
  "derived_values": {
   "type": "object", "additionalProperties": false,
   "required": ["generated_by", "constants", "values"],
   "properties": {
    "generated_by": {"const": "docs/architecture_comparison/failure_tree/derive_failure_tree.py"},
    "constants": {"type": "object"},
    "values": {"type": "array", "items": {"type": "object", "required": ["id", "quantity", "value", "unit", "evidence_class", "inputs", "note"],
     "properties": {"id": {"type": "string", "pattern": "^D-[A-Z0-9.-]+$"}, "evidence_class": {"const": "model-derived"}}}}
   }
  },
  "ranked_next_evidence": {
   "type": "object", "additionalProperties": false,
   "required": ["generated_by", "rule_id", "per_architecture"],
   "properties": {
    "generated_by": {"const": "docs/architecture_comparison/failure_tree/derive_failure_tree.py"},
    "rule_id": {"const": "decisiveness_lexicographic_v2"},
    "per_architecture": {"type": "object", "additionalProperties": false, "required": ["hall_only", "rf_hall", "ecr_hall"],
     "properties": {"hall_only": {"$ref": "#/$defs/arch_ranking"}, "rf_hall": {"$ref": "#/$defs/arch_ranking"}, "ecr_hall": {"$ref": "#/$defs/arch_ranking"}}}
   }
  },
  "arch_ranking": {
   "type": "object", "additionalProperties": false,
   "required": ["n_nodes", "n_sub_causes_not_counted", "n_branch_nodes_not_counted", "ranked", "blocked", "branch_rankings"],
   "properties": {
    "n_nodes": {"description": "Open core nodes of the architecture that are counted (sub-causes and branch-specific nodes excluded).", "type": "integer", "minimum": 1},
    "n_sub_causes_not_counted": {"type": "integer", "minimum": 0},
    "n_branch_nodes_not_counted": {"description": "Open nodes specific to a design-branch option; ranked in branch_rankings, not in the core list.", "type": "integer", "minimum": 0},
    "ranked": {"type": "array", "items": {"$ref": "#/$defs/ranked_row"}},
    "blocked": {"type": "array", "items": {"$ref": "#/$defs/blocked_row"}},
    "branch_rankings": {"type": "array", "items": {"type": "object", "additionalProperties": false,
     "required": ["decision", "option", "n_nodes", "ranked", "blocked"],
     "properties": {"decision": {"type": "string"}, "option": {"type": "string"}, "n_nodes": {"type": "integer", "minimum": 0},
      "ranked": {"type": "array", "items": {"$ref": "#/$defs/ranked_row"}},
      "blocked": {"type": "array", "items": {"$ref": "#/$defs/blocked_row"}}}}}
   }
  },
  "ranked_row": {
   "type": "object", "additionalProperties": false,
   "required": ["rank", "action", "kind", "n_decides", "n_gates_decided", "n_contributes", "n_informs", "gates_decided", "nodes_decided", "nodes_contributed", "nodes_informed"],
   "properties": {
    "rank": {"type": "integer", "minimum": 1}, "action": {"type": "string"}, "kind": {"$ref": "#/$defs/action_kind"},
    "n_decides": {"type": "integer", "minimum": 0}, "n_gates_decided": {"type": "integer", "minimum": 0},
    "n_contributes": {"type": "integer", "minimum": 0}, "n_informs": {"type": "integer", "minimum": 0},
    "gates_decided": {"type": "array", "items": {"$ref": "#/$defs/gate_id"}},
    "nodes_decided": {"type": "array", "items": {"type": "string"}},
    "nodes_contributed": {"type": "array", "items": {"type": "string"}},
    "nodes_informed": {"type": "array", "items": {"type": "string"}}
   }
  },
  "blocked_row": {
   "type": "object", "additionalProperties": false,
   "required": ["action", "blocked_by", "nodes_touched"],
   "properties": {"action": {"type": "string"}, "blocked_by": {"type": "array", "items": {"type": "string"}}, "nodes_touched": {"type": "array", "items": {"type": "string"}}}
  }
 }
}
