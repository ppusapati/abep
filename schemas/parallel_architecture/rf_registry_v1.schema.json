{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "rf_registry_v1",
 "title": "RF map registry record v1",
 "description": "Append-only record (abep_sim.rf_registry). REGISTER pins the map file sha256; ADMIT pins an owner decision file; WITHDRAW revokes. record_sha256 = sha256 of the canonical record body.",
 "type": "object",
 "required": [
  "action",
  "map_sha256",
  "registry_version",
  "seq",
  "record_sha256"
 ],
 "properties": {
  "action": {
   "enum": [
    "REGISTER",
    "ADMIT",
    "WITHDRAW"
   ]
  },
  "map_sha256": {
   "type": "string",
   "pattern": "^[0-9a-f]{64}$"
  },
  "map_file": {
   "type": "string",
   "minLength": 1
  },
  "map_id": {
   "type": "string",
   "minLength": 1
  },
  "evidence_class": {
   "type": "string"
  },
  "decision_file": {
   "type": "string",
   "minLength": 1
  },
  "decision_sha256": {
   "type": "string",
   "pattern": "^[0-9a-f]{64}$"
  },
  "reason": {
   "type": "string",
   "minLength": 1
  },
  "registry_version": {
   "const": "rf_registry_v1"
  },
  "seq": {
   "type": "integer",
   "minimum": 0
  },
  "record_sha256": {
   "type": "string",
   "pattern": "^[0-9a-f]{64}$"
  }
 }
}
