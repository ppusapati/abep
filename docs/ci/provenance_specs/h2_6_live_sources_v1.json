{
 "schema": "abep_live_source_spec_v1",
 "id": "h2_6_live_sources_v1",
 "check": "h2_6_live_sources",
 "status": "VERIFICATION_SPEC (data for the generic Rust provenance verifier, crates/abep-provenance verifier::live_sources)",
 "semantics_source": {
  "python": "docs/hardware/h2/h2_6_diagnostics_fixture/build_h2_6_diagnostics_fixture.py::verify_sources, called by scripts/ci_checks.py::check_h2_6_live_sources",
  "python_sha256": "18498a0508eb2d4e8b0dad7acf2161ecbd458c2a3077af1eb99fac2a8d15cd24",
  "contract": "docs/rust_migration/contracts/C-PROVENANCE-VERIFIER/parity_prereg_v1.json"
 },
 "what_this_is": [
  "the check semantics of verify_sources() as data: the evidence pins and the consumed values come from the immutable H2-6 record; each group names a live source, how Python reads it, and the ordered value checks with their live locators and comparison rules",
  "H2-6 consumed-input names are identities of historical evidence (H2 v1, immutable); no H2-6 architecture content is computed here; the S_eff cross-check reads the record's derived value"
 ],
 "consumed_record": {
  "path": "docs/hardware/h2/h2_6_diagnostics_fixture/h2_6_diagnostics_fixture_v1.json",
  "sha256": "bc7d6b049067c6fbd5489bda32ee9c8c1af36508576db4619b08d2c4ec196a56",
  "pin_lists": [
   "authority_pins",
   "deliverable_pins"
  ],
  "inputs_key": "inputs",
  "binding": "a missing or changed record fails closed (MODEL_ERROR) before any value check"
 },
 "pin_label": "h2_6 pin",
 "locator_steps": {
  "key": "d[k]: KeyError(k) if absent, TypeError if not subscriptable by a string",
  "get": "d.get(k): None if absent, TypeError (AttributeError) if not a dict",
  "by_id": "first element x of the iteration with isinstance(x, dict) and x.get(field) == equals, else KeyError(equals)",
  "map": "{x[key_field]: x[value_field] (value_absent 'error') or x.get(value_field) (value_absent 'none') for x in it}: key evaluated first, last duplicate wins",
  "float_keys_sorted": "sorted(float(k) for k in it)"
 },
 "ops": {
  "compare": "cmp(name, live, consumed, rel_tol): both numbers (int, float or bool) -> math.isclose(float(live), float(consumed), rel_tol, abs_tol = 0.0); else live != consumed (Python ==)",
  "contains": "needle not in live",
  "equals_literal": "live != literal"
 },
 "group_rule": "a group's source is read first; FileNotFoundError -> SOURCE_MISSING (group label) and the group stops; a KeyError while evaluating the group (catch_key_error) -> SOURCE_KEY_MISSING (the key) and the group stops; any other error aborts the whole check (RAISED)",
 "groups": [
  {
