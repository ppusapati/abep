def sha256_file(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


class Ctx:
    """Loaded inputs. Every file is read from `root`; a missing input raises (no fallback)."""

    def __init__(self, root: Path = REPO):
        self.root = Path(root)
        self._json: dict = {}
        self._text: dict = {}
        self.citations: list = []
        self.premises: list = []

    def path(self, rel: str) -> Path:
        p = self.root / rel
        if not p.exists():
            raise FileNotFoundError(f"required input missing: {rel} (no fallback; CLAUDE.md rule 3)")
        return p

    def json(self, rel: str):
        if rel not in self._json:
            self._json[rel] = json.loads(self.path(rel).read_text(encoding="utf-8"))
        return self._json[rel]

    def text(self, rel: str) -> str:
        if rel not in self._text:
            raw = self.path(rel).read_text(encoding="utf-8")
            if rel.endswith(".json"):
                # JSON may escape non-ASCII; search both the raw text and an unescaped dump.
                raw = raw + "\n" + json.dumps(json.loads(raw), ensure_ascii=False)
            self._text[rel] = raw
        return self._text[rel]

    def premise(self, desc: str, ok: bool, source: str):
        self.premises.append({"premise": desc, "source": source, "holds": bool(ok)})
        if not ok:
            raise RuntimeError(f"premise no longer holds, revise the affected row: {desc} ({source})")


def cite(key_or_path: str, locator: str, *tokens: str) -> dict:
    path = P.get(key_or_path, key_or_path)
    return {"path": path, "locator": locator, "verified_tokens": list(tokens)}


def pending(lane: str) -> dict:
    spec = PARALLEL_LANES[lane]
    return {"pending_parallel_lane": lane, "paths": list(spec["paths"])}


def item(text: str, *sources: dict, **extra) -> dict:
    if not sources:
        raise ValueError(f"unsourced statement: {text!r}")
    out = {"text": text, "sources": list(sources)}
    out.update(extra)
    return out


def verify_citations(ctx: Ctx, obj) -> int:
    """Walk obj; every {'path','verified_tokens'} citation must resolve. Returns the number of citations checked."""
    n = 0
    if isinstance(obj, dict):
        if "path" in obj and "verified_tokens" in obj:
            txt = ctx.text(obj["path"])
            for t in obj["verified_tokens"]:
                if t not in txt:
                    raise ValueError(f"citation token {t!r} not found in {obj['path']} ({obj.get('locator')})")
            return 1
        for v in obj.values():
            n += verify_citations(ctx, v)
    elif isinstance(obj, list):
        for v in obj:
            n += verify_citations(ctx, v)
    return n


def lane_state(root: Path, lane: str) -> dict:
    """Lazy re-read of a parallel lane's deliverable paths. Never interprets content; never required."""
    spec = PARALLEL_LANES[lane]
    root = Path(root)
    present, files = [], []
    for rel in spec["paths"]:
        p = root / rel
        if p.exists():
            present.append(rel)
            cands = sorted(q for q in p.rglob("*") if q.is_file()) if p.is_dir() else [p]
            for q in cands:
                entry = {"path": q.relative_to(root).as_posix(), "sha256": sha256_file(q)}
                if q.suffix == ".json":
                    try:
                        d = json.loads(q.read_text(encoding="utf-8"))
                    except (ValueError, UnicodeDecodeError) as exc:
                        entry["declared_status"] = f"UNREADABLE_JSON ({type(exc).__name__})"
                    else:
                        st = None
                        if isinstance(d, dict):
                            st = d.get("status")
                            if st is None and isinstance(d.get("x-icd"), dict):
                                st = d["x-icd"].get("status")
                        entry["declared_status"] = st if isinstance(st, str) else "not declared"
                files.append(entry)
    if not present:
        state = "PENDING_PARALLEL_LANE"
    elif len(present) == len(spec["paths"]):
        state = "PRESENT"
    else:
        state = "PARTIALLY_PRESENT"
    declared = sorted({f["declared_status"] for f in files if "declared_status" in f})
    frozen = bool(declared) and all(s.upper().startswith("FROZEN") for s in declared)
    return {"lane": lane, "a6_name": spec["a6_name"], "trigger": spec["trigger"], "what": spec["what"],
            "paths": list(spec["paths"]), "state": state, "files": files, "declared_statuses": declared,
            "declared_frozen": frozen and state == "PRESENT",
            "content_interpreted": False}


def lane_phrase(ls: dict) -> str:
    if ls["state"] == "PENDING_PARALLEL_LANE":
        return f"pending parallel lane {ls['lane']}"
    st = ", ".join(ls["declared_statuses"]) or "not declared"
    return (f"parallel lane {ls['lane']} {ls['state'].lower().replace('_', ' ')} (declared status: {st}); "
            f"content not interpreted by this builder: integrate in the next revision")


def fmt(x: float) -> str:
    return f"{x:.3g}"


def evidence_scan(obj) -> dict:
    """Count evidence classes (keys evidence_class / quantity_type with a value in the six classes) and evidence levels."""
    classes = {c: 0 for c in EVIDENCE_CLASSES}
    levels: dict = {}

    def walk(o):
        if isinstance(o, dict):
            for k, v in o.items():
                if k in ("evidence_class", "quantity_type") and isinstance(v, str) and v in classes:
                    classes[v] += 1
                elif k == "evidence_level" and isinstance(v, int) and not isinstance(v, bool) and 1 <= v <= 7:
                    levels[str(v)] = levels.get(str(v), 0) + 1
                walk(v)
        elif isinstance(o, list):
            for v in o:
                walk(v)

    walk(obj)
    return {"classes": {k: v for k, v in classes.items() if v},
            "levels": dict(sorted(levels.items())),
            "n_classified_values": sum(classes.values()),
            "level_1_in_house_count": levels.get("1", 0),
            "level_2_same_hardware_count": levels.get("2", 0)}


