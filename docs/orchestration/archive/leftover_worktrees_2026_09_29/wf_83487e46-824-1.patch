        a(f"  - basis: {b['basis']} [{_srcs(b['sources'])}]")
        if b["outside_gate_path"]:
            a(f"  - blocks instead: {b['outside_gate_path']}")
        a(f"- **owner**: {c['owner']['value']} ({c['owner']['basis']})")
        a("- **A5 risks**: " + "; ".join(f"{m['rank']} ({m['why_this_row']})" for m in r["a5_risk_mapping"]))
    a("")
    a("## 6. Parallel lanes (lazy re-read)")
    a("")
    a("| lane | A6 name | paths | state | files |")
    a("|---|---|---|---|---|")
    for lane, s in doc["parallel_lanes"].items():
        a(f"| `{lane}` | {s['a6_name']} | {', '.join('`' + p + '`' for p in s['paths'])} | {s['state']} | {len(s['files'])} |")
    a("")
    a("The builder re-reads these paths on every run. It records files (sha256) and any declared top-level status, never "
      "their content; it never requires them. When a lane delivers, rerun the builder and integrate the content in the next "
      "revision of the affected cells.")
    a("")
    a("## 7. Rules and vocabularies")
    a("")
    for x in doc["vocabularies"]["rules"]:
        a(f"- {x}")
    a("")
    a("| interface status | meaning |")
    a("|---|---|")
    for k, v in INTERFACE_STATUS.items():
        a(f"| {k} | {v} |")
    a("")
    a("| blocker category | meaning |")
    a("|---|---|")
    for k, v in BLOCKER_CATEGORIES.items():
        a(f"| `{k}` | {_esc(v)} |")
    a("")
    a("## 8. Owner questions")
    a("")
    for q in doc["owner_questions"]:
        a(f"- **{q['id']}** {q['question']}")
    a("")
    a("## 9. Pins, inputs and premises")
    a("")
    a("Owner decisions and the G0 record (immutable, hard-pinned):")
    a("")
    for k, v in doc["decision_pins"].items():
        a(f"- `{k}` sha256 `{v}`")
    a("")
    a(f"G0: verdict {doc['authority']['g0']['verdict']} at `{doc['authority']['g0']['verified_commit']}`; "
      f"{doc['authority']['g0']['note']}.")
    a("")
    a("Verified deliverables read (sha256 at build):")
    a("")
    for k, v in doc["input_pins"].items():
        a(f"- `{k}` `{v}`")
    a("")
    a("Governance files referenced by id only, never read or pinned: " + ", ".join(f"`{x}`" for x in doc["governance_referenced_not_pinned"]) + ".")
    a("")
    a(f"Premises re-checked on every build ({len(doc['premises_checked'])}; a change raises and the row is revised):")
    a("")
    for p in doc["premises_checked"]:
        a(f"- {p['premise']} (`{p['source']}`)")
    a("")
    a("## 10. Compliance")
    a("")
    for x in doc["compliance"]:
        a(f"- {x}")
    a("")
    return "\n".join(L)


def dumps(obj: dict) -> str:
    return json.dumps(obj, indent=1, ensure_ascii=False) + "\n"


def main(argv: list) -> int:
    doc = build()
    js, md = dumps(doc), render_md(doc)
    if "--check" in argv:
        ok = True
        for path, text in ((OUT_JSON, js), (OUT_MD, md)):
            if not path.exists() or path.read_text(encoding="utf-8") != text:
                print(f"MISMATCH: {path.relative_to(REPO)} is not reproduced by this script "
                      "(inputs or a parallel lane changed: regenerate)")
                ok = False
        if ok:
            print("OK")
        return 0 if ok else 1
    OUT_JSON.write_text(js, encoding="utf-8")
    OUT_MD.write_text(md, encoding="utf-8")
    print(f"wrote {OUT_JSON.relative_to(REPO)} and {OUT_MD.relative_to(REPO)}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
