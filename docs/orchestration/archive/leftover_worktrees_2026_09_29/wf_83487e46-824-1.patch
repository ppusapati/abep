def icd_item(ctx: Ctx, iface: str, fields=None, role: str = "") -> dict:
    icd = ctx.json(P["ICD"])
    doc_status = icd["x-icd"]["status"]
    df = icd["$defs"][iface]
    props = df["properties"]
    names = list(props) if fields is None else list(fields)
    counts: dict = {}
    for f in names:
        if f not in props:
            raise KeyError(f"ICD field {iface}.{f} not found")
        s = props[f]["x-field"]["status"]
        counts[s] = counts.get(s, 0) + 1
    non_gap = sum(v for k, v in counts.items() if k != "gap")
    if doc_status.upper().startswith("FROZEN") and not counts.get("gap") and not counts.get("partial"):
        status = "FROZEN"
    elif non_gap:
        status = "PARTIAL"
    else:
        status = "OPEN"
    return {"document": P["ICD"], "companion": P["ICD_MD"], "item": iface if fields is None else
            f"{iface}: " + ", ".join(names), "role": role, "document_status": doc_status,
            "field_status_counts": dict(sorted(counts.items())), "status": status}


def hw_item(ctx: Ctx, ids, role: str = "") -> dict:
    hw = ctx.json(P["HW"])
    reqs = {r["id"]: r for r in hw["requirements"]}
    planes = {p["id"]: p for p in hw["interface_planes"]}
    cis = {c["id"]: c for c in hw["configuration_items"]}
    st = {}
    for i in ids:
        if i in reqs:
            st[i] = reqs[i]["status"]
        elif i in planes:
            st[i] = "DEFINED_PLANE"
        elif i in cis:
            st[i] = "CONFIGURATION_ITEM"
        else:
            raise KeyError(f"{i} not found in {P['HW']}")
    status = "OPEN" if all(v == "TBD" for v in st.values()) else "PARTIAL"
    return {"document": P["HW"], "item": ", ".join(ids), "role": role, "document_status": hw["status"],
            "item_statuses": st, "status": status}


def bus_item(components, role: str = "") -> dict:
    allc = set(arch_boundary.COMMON_COMPONENTS)
    for a in arch_boundary.ARCHITECTURES:
        allc |= set(arch_boundary.REQUIRED_COMPONENTS[a])
    for c in components:
        if c not in allc:
            raise KeyError(f"{c} is not a {arch_boundary.BOUNDARY_VERSION} component")
    return {"document": P["AB"], "companion": P["BPB"], "item": f"{arch_boundary.BOUNDARY_VERSION}: " +
            ", ".join(components), "role": role, "document_status": "DRAFT for the owner (BUS_POWER_BOUNDARY.md)",
            "status": "PARTIAL"}


def doc_item(ctx: Ctx, key: str, item_desc: str, status_value: str, role: str = "") -> dict:
    ctx.path(P[key])
    return {"document": P[key], "item": item_desc, "role": role, "document_status": status_value, "status": "PARTIAL"}


def lane_item(ls: dict, item_desc: str, role: str = "") -> dict:
    if ls["state"] == "PENDING_PARALLEL_LANE":
        status = "OPEN"
    elif ls["declared_frozen"]:
        status = "FROZEN"
    else:
        status = "PARTIAL"
    return {"document": " + ".join(ls["paths"]), "item": item_desc, "role": role,
            "document_status": lane_phrase(ls), "pending_parallel_lane": ls["lane"], "status": status}


def interface_cell(items: list) -> dict:
    sts = [i["status"] for i in items]
    if not items:
        raise ValueError("interface cell needs at least one item")
    value = "FROZEN" if all(s == "FROZEN" for s in sts) else "OPEN" if all(s == "OPEN" for s in sts) else "PARTIAL"
    return {"value": value, "items": items}


