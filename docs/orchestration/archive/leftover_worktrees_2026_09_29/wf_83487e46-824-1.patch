    row("SM-ATM-03", "atmospheric_branch", 2, {
        "requirement": requirement_cell("RFP P_bus < 1.5 kW hard gate; IC compressor 0.60 (verify); W1-derived CR / pumping-speed envelope", [
            R["chain"], R["power"], R["firing"], R["ic"]("compressor >= 0.60"),
            item("A4: the hard gate remains full-system P_bus < 1.5 kW (a compressor needing more than 300 W is not "
                 "rejected if the system closes)", cite("A4", "decisions.compressor_power_allocation", "The hard gate remains full-system P_bus < 1.5 kW")),
            item(f"DERIVED (compressor down-selection requirement envelope, PROPOSED, model-derived): required active CR "
                 f"{fmt(cr['min'])}-{fmt(cr['max'])} (self-consistent backflow); inlet pumping speed at b = 0.25 "
