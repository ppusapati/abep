            ], pend=[pend_item(ctx, "fo_preionizer_module_icd", "the common interface definition"),
                     pend_item(ctx, "fo_phase1_prereg_framework", "same-condition definition and counterbalancing")]),
            "blocker": blocker_cell(
                rb + "; the IP-UP/IP-DN module interface control drawing must be frozen before S1 (hardware readiness review, HW-PIM-01)",
                "unresolved_interface", "S1",
