                oth("A5 case B", "RF restores operation with a net system-level benefit after RF source, matching and PPU power and mass are counted",
                    cite("A5", "phase1_branch_decision.cases.B_rf_hall", "net system-level benefit")),
                oth("A6 execution order", "order-balanced scheme; A5's Hall-only -> RF+Hall -> ECR+Hall names the configurations, not the execution order",
