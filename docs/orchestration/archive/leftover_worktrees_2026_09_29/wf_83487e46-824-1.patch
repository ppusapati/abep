             cite("HW", "requirements[id=HW-ENV-07]", "HW-ENV-07")],
            outside_gate_path="flight delivered-feed representativeness (W1 delivered flow is an upper bound without filter "
                              "transmission) and the mass BOM (hard gate G3)"),
