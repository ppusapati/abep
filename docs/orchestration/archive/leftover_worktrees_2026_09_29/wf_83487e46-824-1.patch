def build_rollup(ctx: Ctx, rows: list) -> dict:
    by_cat = {c: [] for c in BLOCKER_CATEGORIES}
    by_step = {s: {} for s in GATE_SEQUENCE + [NONE_ON_H1_PATH]}
    for r in rows:
        b = r["columns"]["blocker"]
        by_cat[b["category"]].append(r["id"])
        by_step[b["earliest_blocked_step"]].setdefault(b["category"], []).append(r["id"])
    first = next(s for s in GATE_SEQUENCE if by_step[s])
    gate_table = {g: {c: sorted(i for s in GATE_SEQUENCE[:GATE_SEQUENCE.index(g) + 1] for i in by_step[s].get(c, []))
                      for c in BLOCKER_CATEGORIES} for g in REPORTED_GATES}
    gate_table = {g: {c: v for c, v in d.items() if v} for g, d in gate_table.items()}
    risk_rows = {}
    for r in rows:
        for m in r["a5_risk_mapping"]:
            risk_rows.setdefault(m["rank"], []).append(r["id"])
    closing = []
    for rank in sorted(risk_rows):
        rk = a5_risk(ctx, rank)
        cat, why = RISK_CATEGORY[rank]
        cur = sorted({next(x for x in rows if x["id"] == rid)["columns"]["blocker"]["category"] for rid in risk_rows[rank]})
        closing.append({"rank": rank, "risk": rk["risk"], "category": cat, "category_basis": why,
                        "category_mapping_status": "PROPOSED by this lane (owner question MQ-03)",
                        "a5_response": rk["response"], "rows": risk_rows[rank],
                        "current_blocker_categories_in_front_of_it": cur})
    no_current = [c for c, v in by_cat.items() if not v]
    flight_only = by_step[NONE_ON_H1_PATH]
    order = [s for s in GATE_SEQUENCE if by_step[s]]
    step_txt = "; ".join(f"{s}: " + ", ".join(f"{BLOCKER_CATEGORIES[c].split(':')[0]} ({len(v)})" for c, v in sorted(by_step[s].items()))
                         for s in order)
    statement = (
        f"Execution toward Phase 1 is blocked first at {first} by "
        + ", ".join(BLOCKER_CATEGORIES[c].split(":")[0] for c in sorted(by_step[first])) +
        f" (rows {', '.join(sorted(i for v in by_step[first].values() for i in v))}). Earliest blocked step per row: {step_txt}. "
        f"Categories with no current row blocker: {', '.join(BLOCKER_CATEGORIES[c].split(':')[0] for c in no_current) or 'none'}. "
        "Propulsion physics (A5 risks 1-2) is the question the gate sequence leads to: only H-1 Phase 1 (and a life test) "
        "can answer it, and it decides the branch A hall_only / B rf_hall / C ecr_hall / NO_VIABLE_CASE; no row can retire "
        "it before Phase 1. Rows whose blocker is off the H-1 gate path ("
        + ", ".join(sorted(i for v in flight_only.values() for i in v)) +
        ") block only the flight closure of A5 risks 3-4 (Xe budget, mass, feed state). "
        "No architecture is ranked, preferred or eliminated.")
    return {
        "question": "Which blocker category actually blocks the architecture: propulsion physics, cathode/Xe, mass, "
                    "thermal, compressor, unresolved interface or procurement? (A6 authorized_now.fo_subsystem_maturity_matrix)",
        "by_category": {c: v for c, v in by_cat.items()},
        "by_earliest_step": {s: by_step[s] for s in GATE_SEQUENCE + [NONE_ON_H1_PATH]},
        "blocked_by_gate_cumulative": gate_table,
        "first_blocked_step": first,
        "first_blocked_step_categories": sorted(by_step[first]),
        "categories_without_a_current_row_blocker": no_current,
        "flight_closure_only": flight_only,
        "architecture_closing_risks": closing,
        "answer": statement,
        "gate_sequence_source": [cite("A4", "critical_path", "S1a -> LOCK-1 -> W5 freeze -> S1/S1b -> LOCK-2"),
                                 cite("A6", "authorized_now.fo_phase1_prereg_framework", "sequence S1a -> LOCK-1 -> W5 freeze -> S1/S1b -> LOCK-2 -> Phase 1")],
    }


def build(root: Path = REPO) -> dict:
    ctx = Ctx(root)
    for rel, h in DECISION_PINS.items():
        got = sha256_file(ctx.path(rel))
        if got != h:
            raise RuntimeError(f"decision pin mismatch for {rel}: {got} != {h}")
    g0 = ctx.json(G0)
    ctx.premise("G0 verdict CLEAN", g0["verdict"] == "CLEAN", G0)
    ctx.premise("G0 verified the pinned A5 sha256", g0["a5_sha256"] == DECISION_PINS[A5], G0)
    a6 = ctx.json(A6)
    ctx.premise("A6 follows A5 at the pinned sha256", a6["follows_sha256"] == DECISION_PINS[A5], A6)
    ctx.premise("A6 authorizes fo_subsystem_maturity_matrix", "fo_subsystem_maturity_matrix" in a6["authorized_now"], A6)
    a5 = ctx.json(A5)
    ctx.lanes = {lane: lane_state(ctx.root, lane) for lane in PARALLEL_LANES}

    rows = build_rows(ctx)
    arch = a5["architecture"]
    expect = arch["atmospheric_branch"] + arch["xe_branch"] + arch["propulsion"] + arch["support"]
    got = [r["a5_name"] for r in rows if not r["reserved_interface"]]
    if got != expect or len(expect) != arch["baseline_subsystem_count"]:
        raise RuntimeError("row names do not reproduce A5 'architecture' exactly")
    input_pins = {rel: sha256_file(ctx.path(rel)) for rel in sorted(INPUTS.values())}
    rollup = build_rollup(ctx, rows)
    b1 = ctx.json(P["B1"])
    doc = {
        "schema": "subsystem_maturity_matrix_v1",
        "id": "subsystem_maturity_v1",
        "title": "A5 subsystem maturity matrix: central execution dashboard (16 baseline subsystems + reserved pre-ionizer interface)",
        "follow_on": "fo_subsystem_maturity_matrix",
        "a6_lane_name": "M16",
        "trigger": "T_A5_SUBSYSTEM_MATURITY",
        "status": "DRAFT_FOR_OWNER_REVIEW",
        "base_commit": BASE_COMMIT,
        "generated_by": f"{REL_DIR}/build_subsystem_maturity.py",
        "companion_document": f"{REL_DIR}/SUBSYSTEM_MATURITY.md",
        "test": "tests/test_subsystem_maturity.py",
        "authority": {
            "a6_text": a6["authorized_now"]["fo_subsystem_maturity_matrix"],
            "a6_source": cite("A6", "authorized_now.fo_subsystem_maturity_matrix", "the CENTRAL execution dashboard from A6 on"),
            "a5_status": a5["status"],
            "g0": {"file": G0, "verdict": g0["verdict"], "verified_commit": g0["verified_commit"],
                   "consequence": g0["consequence"],
                   "note": "A6 execution: no deliverable pins A5/A6 until G0 passes; G0 is CLEAN, so this lane pins A5/A6"},
        },
        "what_it_is": "The per-subsystem maturity state of the A5 proposal reference architecture, read from the repository: "
                      "requirement -> allocation -> interface status -> preliminary design -> evidence status -> procurement "
                      "status -> analysis/test needed -> blocker -> owner, with a blocker-category rollup and each row's "
                      "mapping to the A5 architecture-closing risks 1-4.",
        "what_it_is_not": [
            "not a design, a prediction or a validation claim: every A5 number quoted here is an allocation or a requirement",
