                          cite("HG", "rfp.recorded_in R6", "ionise nascent O")),
    }


def a5_alloc(ctx: Ctx, quantity: str) -> dict:
    for a in ctx.json(A5)["allocations_and_requirements"]:
        if a["quantity"] == quantity:
            return a
    raise KeyError(f"A5 allocation {quantity!r} not found")


def a5_risk(ctx: Ctx, rank: int) -> dict:
    for r in ctx.json(A5)["architecture_closing_risks"]:
        if r["rank"] == rank:
            return r
    raise KeyError(f"A5 risk {rank} not found")


def s1a_state(ctx: Ctx, cid: str) -> str:
    for c in ctx.json(P["S1A_ST"])["conditions"]:
        if c["id"] == cid:
            return c["state"]
    raise KeyError(f"S1a condition {cid} not found")


def s1_state(ctx: Ctx, cid: str) -> str:
    for c in ctx.json(P["S1_ST"])["conditions"]:
        if c["id"] == cid:
            return c.get("state") or c.get("status")
    raise KeyError(f"S1 condition {cid} not found")


def l1_decision(ctx: Ctx, did: str) -> dict:
    for d in ctx.json(P["L1"])["decisions"]:
        if d["id"] == did:
            return d
    raise KeyError(f"LOCK-1 decision {did} not found")


def hw_status(ctx: Ctx, rid: str) -> str:
    for r in ctx.json(P["HW"])["requirements"]:
        if r["id"] == rid:
            return r["status"]
    raise KeyError(rid)


def ins_name(ctx: Ctx, iid: str) -> str:
    for i in ctx.json(P["INS"])["instruments"]:
        if i["id"] == iid:
            return i["name"]
    raise KeyError(f"{iid} not found in {P['INS']}")


def bom_item(ctx: Ctx, iid: str) -> dict:
    for i in ctx.json(P["BOM"])["items"]:
        if i["id"] == iid:
            return i
    raise KeyError(f"mass_bom item {iid} not found")


def bom_tba(ctx: Ctx, iid: str, extra: str = "") -> dict:
    it = bom_item(ctx, iid)
    basis = it["cbe"]["basis"]
    ctx.premise(f"mass_bom item {iid} has no sourced CBE (basis {basis})", basis in ("TBD", "scaling_relation"), P["BOM"])
    req = it["cbe"].get("requires", "scaling relation on TBD items")
    return {"dimension": "mass", "value": TBA,
            "basis": f"mass_bom_v1 item '{iid}' CBE {basis}: {req}{extra}",
            "sources": [cite("BOM", f"items[id={iid}].cbe", f'"id": "{iid}"')]}


def mass_system_context(ctx: Ctx) -> dict:
    a = a5_alloc(ctx, "system mass design allocation")
    return {"quantity": a["quantity"], "value": a["value"], "status": a["status"],
            "note": "system-level only; A5 records no subsystem sub-allocation",
            "sources": [cite("A5", "allocations_and_requirements 'system mass design allocation'", a["value"])]}


def power_system_context(ctx: Ctx) -> dict:
    a = a5_alloc(ctx, "bus-power design allocation")
    return {"quantity": a["quantity"], "value": a["value"], "status": a["status"],
            "note": "system-level only; A5 records no component sub-allocation",
            "sources": [cite("A5", "allocations_and_requirements 'bus-power design allocation'", a["value"])]}


def power_tba(component: str, extra: str = "") -> dict:
    return {"dimension": "power", "value": TBA,
            "basis": f"{arch_boundary.BOUNDARY_VERSION} component '{component}': no component allocation recorded "
                     f"(aux bus: load/efficiency TBD){extra}",
            "sources": [cite("AUX_MD", f"component table `{component}`", f"`{component}`"),
                        cite("AB", "COMMON_COMPONENTS / PREIONIZER_COMPONENTS", f'"{component}"')]}


def power_na(reason_src: dict, reason: str) -> dict:
    return {"dimension": "power", "value": "NOT_APPLICABLE", "basis": reason, "sources": [reason_src]}


def allocation_cell(ctx: Ctx, dims: list, *, system_mass=True, system_power=True) -> dict:
    allocated = [d for d in dims if d["value"] not in (TBA, "NOT_APPLICABLE")]
    ctx_list = []
    if system_mass:
        ctx_list.append(mass_system_context(ctx))
    if system_power:
        ctx_list.append(power_system_context(ctx))
    return {"value": "PARTIALLY_ALLOCATED" if allocated else TBA,
            "dimensions": dims,
            "system_level_context_not_a_sub_allocation": ctx_list}


def a5_allocated(ctx: Ctx, dimension: str, quantity: str, key: str | None = None, *, token: str | None = None,
                 status_note: str | None = None) -> dict:
    """An allocation recorded in A5 (top-level allocations or the Xe mass allocation block)."""
    a5 = ctx.json(A5)
    if key is None:
        a = a5_alloc(ctx, quantity)
        return {"dimension": dimension, "value": a["value"], "status": a["status"], "recorded_by": "A5",
                "basis": f"A5 allocations_and_requirements '{quantity}'",
                "sources": [cite("A5", f"allocations_and_requirements '{quantity}'", a["value"])]}
    val = a5["xe_mass_allocation"][key]
    return {"dimension": dimension, "value": f"{val} mg/s" if key.endswith("_mg_s") else str(val),
            "status": status_note or "A5 design target (allocation)", "recorded_by": "A5",
            "basis": f"A5 xe_mass_allocation.{key}",
            "sources": [cite("A5", f"xe_mass_allocation.{key}", token or f'"{key}"')]}


# ---------------------------------------------------------------------------------------------------------------
# Row cells
# ---------------------------------------------------------------------------------------------------------------
def requirement_cell(value: str, items: list) -> dict:
    return {"value": value, "items": items}


def design_cell(value: str, items: list, h1_analogue: str | None = None, h1_sources: list | None = None) -> dict:
    out = {"value": value, "items": items}
    if h1_analogue:
        out["h1_test_analogue"] = item(h1_analogue, *(h1_sources or []))
    return out


def evidence_cell(ctx: Ctx, value: str, matrices: list, items: list) -> dict:
    summaries = []
    for key, locator in matrices:
        obj = ctx.json(P[key])
        node = obj
        if locator:
            for part in locator.split("/"):
                node = node[part]
        summaries.append({"path": P[key] + (f"#/{locator}" if locator else ""), **evidence_scan(node)})
    return {"value": value,
            "evidence_matrix": [s["path"] for s in summaries] or None,
            "matrix_summaries": summaries,
            "vyovrinda_hardware_evidence": "none (evidence level 1 entries: "
                                           f"{sum(s['level_1_in_house_count'] for s in summaries)}; no H-1/C-1 or flight "
                                           "unit has been measured)",
            "items": items}


def procurement_cell(value: str, items: list) -> dict:
    return {"value": value, "items": items}


def analysis_cell(ctx: Ctx, *, s1a=(), s1=(), ins=(), phase1=(), other=(), pend=()) -> dict:
    s1a_l = [{"id": c, "state": s1a_state(ctx, c), "source": P["S1A_ST"]} for c in s1a]
    s1_l = [{"id": c, "state": s1_state(ctx, c), "source": P["S1_ST"]} for c in s1]
    ins_l = [{"id": i, "name": ins_name(ctx, i), "source": P["INS"]} for i in ins]
    a6txt = ctx.text(A6)
    for q in phase1:
        if q not in PHASE1_DECISION_QUANTITIES or q not in a6txt:
            raise ValueError(f"Phase-1 decision quantity {q!r} not frozen by A6")
    parts = []
    if s1a_l:
        parts.append(", ".join(c["id"] for c in s1a_l))
    if s1_l:
        parts.append(", ".join(c["id"] for c in s1_l))
    if ins_l:
        parts.append(", ".join(i["id"] for i in ins_l))
    if phase1:
        parts.append("Phase-1 DQ: " + "; ".join(phase1))
    ids = [o["id"] for o in other]
    if ids:
        parts.append(", ".join(ids))
    if pend:
        parts.append("pending: " + ", ".join(p["lane"] for p in pend))
    return {"value": " | ".join(parts),
            "s1a_conditions": s1a_l, "s1_conditions": s1_l, "instruments": ins_l,
            "phase1_decision_quantities": {"quantities": list(phase1),
                                           "source": [cite("A6", "authorized_now.fo_phase1_prereg_framework",
                                                           *phase1)] if phase1 else [],
                                           "framework": lane_phrase(ctx.lanes["fo_phase1_prereg_framework"])
                                           if phase1 else None},
            "other": list(other), "pending_parallel": list(pend)}


def oth(oid: str, what: str, *sources: dict) -> dict:
    if not sources:
        raise ValueError(f"unsourced analysis item {oid}")
    return {"id": oid, "what": what, "sources": list(sources)}


def pend_item(ctx: Ctx, lane: str, what: str) -> dict:
    ls = ctx.lanes[lane]
    return {"lane": lane, "paths": ls["paths"], "state": ls["state"], "what": what, "status_text": lane_phrase(ls)}


def blocker_cell(item_text: str, category: str, earliest: str, basis: str, sources: list, *,
                 outside_gate_path: str | None = None) -> dict:
    if category not in BLOCKER_CATEGORIES:
        raise ValueError(f"unknown blocker category {category}")
    if earliest != NONE_ON_H1_PATH and earliest not in GATE_SEQUENCE:
        raise ValueError(f"unknown gate {earliest}")
    if not sources:
        raise ValueError("unsourced blocker")
    if earliest == NONE_ON_H1_PATH:
        blocks = {g: False for g in REPORTED_GATES}
        if not outside_gate_path:
            raise ValueError("a blocker off the H-1 gate path must say what it blocks instead")
    else:
        k = GATE_SEQUENCE.index(earliest)
        blocks = {g: GATE_SEQUENCE.index(g) >= k for g in REPORTED_GATES}
    return {"value": f"{item_text}", "category": category, "category_label": BLOCKER_CATEGORIES[category].split(":")[0],
            "earliest_blocked_step": earliest, "blocks": blocks, "basis": basis, "sources": sources,
            "outside_gate_path": outside_gate_path}


def owner_cell() -> dict:
    return {"value": OWNER_TO_ASSIGN,
            "basis": "no accountable party is recorded for this subsystem in any pinned input; the owner decisions "
                     "that act on this row are listed in its blocker and analysis/test cells"}


def risks(ctx: Ctx, mapping: list) -> list:
    out = []
    for rank, why in mapping:
        r = a5_risk(ctx, rank)
        out.append({"rank": rank, "risk": r["risk"], "a5_response": r["response"], "why_this_row": why,
                    "source": cite("A5", f"architecture_closing_risks[rank={rank}]", r["risk"])})
    return out


