            oth("G-08", "no pressure-loss model (filter, feed line, valve, regulator)", cite("ICD_MD", "section 7", "| G-08 |")),
            oth("G-11", "no contamination transport", cite("ICD_MD", "section 7", "| G-11 |")),
            oth("G3_mass", "hard gate G3 mass (filter is a BOM item)", cite("HG", "gates[id=G3_mass]", "G3_mass")),
        ]),
        "blocker": blocker_cell(
