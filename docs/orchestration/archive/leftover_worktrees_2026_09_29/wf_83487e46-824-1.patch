def _src(s: dict) -> str:
    if "pending_parallel_lane" in s:
        return f"pending parallel lane `{s['pending_parallel_lane']}`"
    return f"`{s['path']}` ({s['locator']})"


def _srcs(lst) -> str:
    return "; ".join(_src(s) for s in lst)


def _esc(t: str) -> str:
    return str(t).replace("|", "\\|").replace("\n", " ")


def _short_blocker(b: dict) -> str:
    return f"**{b['category_label']}** -> {b['earliest_blocked_step']}"


