def build_rows(ctx: Ctx) -> list:
    R = rfp(ctx)
    a5 = ctx.json(A5)
    arch = a5["architecture"]
    w1 = ctx.json(P["W1"])
    cmp_ = ctx.json(P["CMP"])
    hw = ctx.json(P["HW"])
    L = ctx.lanes
    pim, xel, p1f = L["fo_preionizer_module_icd"], L["fo_xe_system_ledger"], L["fo_phase1_prereg_framework"]

    # ---- premises re-checked on every build (a change raises: revise the row) --------------------------------
    for did in ("D-06", "D-09", "D-11", "D-13"):
        ctx.premise(f"LOCK-1 decision {did} is OPEN_OWNER_DECISION", l1_decision(ctx, did)["status"] == "OPEN_OWNER_DECISION", P["L1"])
    ctx.premise("LOCK-1 brief not signed (locked == false)", ctx.json(P["L1"])["locked"] is False, P["L1"])
    for rid in ("HW-H1-03", "HW-ENV-03", "HW-MC-08", "HW-PIM-06"):
        ctx.premise(f"W3 requirement {rid} is TBD", hw_status(ctx, rid) == "TBD", P["HW"])
    ctx.premise("W3 hardware register is DRAFT_PENDING_OWNER", hw["status"] == "DRAFT_PENDING_OWNER", P["HW"])
    ctx.premise("S1a gate verdict S1A_NOT_READY", ctx.json(P["S1A_ST"])["verdict"] == "S1A_NOT_READY", P["S1A_ST"])
    ctx.premise("S1 (N4) gate verdict S1_NOT_READY", ctx.json(P["S1_ST"])["verdict"] == "S1_NOT_READY", P["S1_ST"])
    ctx.premise("S1a engineering hardware record absent (S1A-C1)",
                not (ctx.root / "docs/experiments/hardware/s1a_engineering_hardware_record.json").exists(), P["S1A"])
    ctx.premise("A5 m_Xe_total_value is PENDING_OWNER",
                str(a5["xe_mass_allocation"]["m_Xe_total_value"]).startswith("PENDING_OWNER"), A5)
    ctx.premise("MCQ S1 gate items all MISSING",
                all(x["state"] == "MISSING" for x in ctx.json(P["MCQ"])["s1_gate_items"]), P["MCQ"])
    ctx.premise("dual-feed state machine second lens not passed",
                "NOT YET PASSED" in ctx.json(P["DFSM"])["verification"]["second_lens"], P["DFSM"])
    aux_sum = ctx.json(P["AUX"])["ledger_summary"]
    ctx.premise("aux bus: no ledger evaluable", aux_sum["evaluated"] == 0, P["AUX"])
    b1_form = ctx.json(P["B1"])["outcome"]["form"]
    ctx.premise("Bundle 1 outcome NO_BASELINE_YET", b1_form == "NO_BASELINE_YET", P["B1"])

    w1_cands = [f"{c['id']} ({w1['closure'][c['id']]['status']})" for c in w1["candidates"]]
    rs = cmp_["requirement_summary"]
    cr = rs["CR_required_self_consistent"]
    s25 = rs["S_required_m3_s"]["0.25"]
    a25 = rs["A_inlet_min_m2"]["0.25"]
    veto = {r["id"]: r for r in ctx.json(P["VETO"])["risk_indicators"]}

    def veto_item(rid: str, what: str) -> dict:
        r = veto[rid]
        return item(f"{rid}: {what} (evidence class {r['evidence_class']}; not verdict-bearing)",
                    cite("VETO", f"risk_indicators[id={rid}]", rid))

    rows = []

    def row(rid, group, idx, cols, risk_map, h1_analogue_note=None):
        name = arch[group][idx]
        r = {"id": rid, "group": group, "a5_name": name,
             "a5_source": cite("A5", f"architecture.{group}[{idx}]", name),
             "baseline_flight_hardware": True, "reserved_interface": False,
             "columns": {c: cols[c] for c in COLUMNS}, "a5_risk_mapping": risks(ctx, risk_map)}
        rows.append(r)

    # ======================= atmospheric branch ===========================================================
    row("SM-ATM-01", "atmospheric_branch", 0, {
        "requirement": requirement_cell("RFP chain element; 180-230 km; 26,000 h mission; IC intake 0.80 (verify); A4 intake sizing driver", [
            R["chain"], R["altitude"], R["mission"], R["ic"]("intake >= 0.80"), R["ao_test"],
            item("DERIVED (A4 intake_sizing): the molecular-entrance constraint (0.098-0.377 m2 minimum inlet at b = 0.25) "
                 "makes intake/compressor sizing a spacecraft-level driver before the flight geometry is locked",
                 cite("A4", "decisions.intake_sizing", "0.098-0.377 m2 minimum inlet at b = 0.25")),
            item("DERIVED (A5 risk 1 evidence): delivered flow <= ~3.2 mg/s and delivered O2 fraction 0.42-0.60 set the "
                 "low-flow / high-O2 condition the intake produces",
                 cite("A5", "architecture_closing_risks[rank=1].evidence", "<= ~3.2 mg/s delivered", "0.42-0.60")),
        ]),
        "allocation": allocation_cell(ctx, [
            bom_tba(ctx, "intake"),
            power_na(cite("ICD_MD", "IF-A1 'Not applicable here'", "shaft_power (passive element)"),
                     "passive element: no bus_power_boundary_v1 component (ICD IF-A1 shaft_power not applicable)"),
        ]),
        "interface_status": interface_cell([
            icd_item(ctx, "IF-A0", role="in: free stream -> intake aperture"),
            icd_item(ctx, "IF-A1", role="out: intake -> filter"),
        ]),
        "preliminary_design": design_cell("CANDIDATE_CONCEPT", [
            item("PROPOSED candidate intake geometries only (W1 feed-state closure candidates, closure status in "
                 "brackets): " + "; ".join(w1_cands) + "; conditional on owner decisions DI-1.1/DI-1.2",
                 cite("W1", "candidates; closure", *[c["id"] for c in w1["candidates"]])),
            item("no Vyovrinda intake design: the mass BOM requires 'Vyovrinda intake geometry'; abep_sim/intake_tpmc.py "
                 "gives collection performance, not a design", cite("BOM", "items[id=intake].cbe.requires", "Vyovrinda intake geometry")),
        ], "none: H-1 tests use bottled N2 / N2+O2 / Xe through the lab feed system FS-C (HW-ENV-07)",
            [cite("HW", "requirements[id=HW-ENV-07]", "HW-ENV-07", "No atomic-O source is part of the minimum hardw")]),
        "evidence_status": evidence_cell(ctx, "MODEL_DERIVED_FROM_ASSUMED_INPUTS", [], [
            item("valve-outlet feed states are model-derived from assumed (PROPOSED) intake/compressor/buffer/valve "
                 "candidates on the frozen TPMC surface; nothing measured", cite("W1", "valve_outlet / flight_status_control",
                 "model-derived (from assumed inputs)", "PROPOSED_FLIGHT_REPRESENTATIVE"), evidence_class="model-derived"),
            item("no intake evidence matrix exists in the base (published ABEP platform comparables LIT-01.. are context only)",
                 cite("W1", "published_comparables", "LIT-01")),
        ]),
        "procurement_status": procurement_cell(UNKNOWN, [
            item("no procurement record for a flight intake in the base", cite("BOM", "items[id=intake].cbe", '"basis": "TBD"'))]),
        "analysis_test_needed": analysis_cell(ctx, s1a=["S1A-C3"], s1=["S1-C3"], other=[
            oth("DI-1.1", "area sizing rule and design case (owner)", cite("W1", "owner_decisions_DI1", "DI-1.1", "Area sizing rule and design case")),
            oth("DI-1.2", "intake geometry (L/d, phi) and TPMC-surface authorisation (owner)", cite("W1", "owner_decisions_DI1", "DI-1.2")),
            oth("DI-1.3", "surface state / accommodation for the design case (owner)", cite("W1", "owner_decisions_DI1", "DI-1.3")),
            oth("DI-1.11", "which candidate(s) define the frozen DI-1 test-point set (owner)", cite("W1", "owner_decisions_DI1", "DI-1.11")),
            oth("G-02", "species-selective collection lost on the production path (ICD gap register)", cite("ICD_MD", "section 7", "| G-02 |")),
            oth("G-10", "V_rel never produced (ICD gap register)", cite("ICD_MD", "section 7", "| G-10 |")),
            oth("RG-08", "W5: registered N2 test points require W1 and LOCK-1", cite("W5", "runnability_gates.gates[id=RG-08]", "RG-08", "TBD - requires W1 and LOCK-1")),
            oth("RFP 4.1a", "AO-beam test for AO-exposed surfaces", cite("HG", "rfp_requirements_recorded_not_gated", "AO-beam test (recorded as RFP 4.1a)")),
        ]),
        "blocker": blocker_cell(
            "Intake sizing rule/design case and geometry are open owner decisions (DI-1.1, DI-1.2), so the W1 valve-outlet "
            "feed states and test points stay candidate-conditional (DI-1.11 open)",
            "unresolved_interface", "LOCK-1",
            "LOCK-1 input lock1_inputs[0] (mdot_min, mdot_nom, composition) is 'TBD - requires W1 valve-outlet test points "
            "(IF-A5)'; the W1 test-point set is candidate-conditional until DI-1.11 is decided. S1a is not blocked: "
            "S1A-C3 asks for owner-released GROUND_QUALIFICATION_POINTs, which do not need the flight intake",
            [cite("L1", "lock1_inputs[0]", "TBD - requires W1 valve-outlet test points (IF-A5)"),
             cite("W1", "owner_decisions_DI1; flight_status_control", "DI-1.11", "GROUND_QUALIFICATION_POINT")]),
        "owner": owner_cell(),
    }, [(1, "the intake sets the delivered flow (<= ~3.2 mg/s) and O2 fraction at which risk 1 is tested"),
        (4, "intake mass (A4: spacecraft-level sizing driver) enters the mass closure")])

    row("SM-ATM-02", "atmospheric_branch", 1, {
        "requirement": requirement_cell("RFP chain element; 26,000 h mission; no numeric requirement recorded (TBD)", [
            R["chain"], R["mission"],
            item("TBD - requires a filter concept and its stated protection function (ICD open question 1: separate "
                 "element or lumped into the intake)", cite("ICD_MD", "section 9, open question 1", "**Filter (G-01).**")),
        ]),
        "allocation": allocation_cell(ctx, [
            bom_tba(ctx, "filter"),
            power_na(cite("BPB", "section 3, 'Not covered by v1'", "A powered filter"),
                     "passive filter: no bus component; a powered filter is not covered by bus_power_boundary_v1 (new "
                     "boundary version needed)"),
        ]),
        "interface_status": interface_cell([
            icd_item(ctx, "IF-A1", role="in: intake -> filter"),
            icd_item(ctx, "IF-A2", role="out: filter -> compressor"),
        ]),
        "preliminary_design": design_cell("NONE", [
            item("filter concept and geometry are not defined in the repository", cite("BOM", "items[id=filter].cbe.requires",
