def _r(x: float, nd: int = 4) -> float:
    v = round(float(x), nd)
    return 0.0 if v == 0 else v


def _sha256(rel: str) -> str:
    p = os.path.join(ROOT, rel)
    if not os.path.isfile(p):
        raise FileNotFoundError(f"pinned input missing: {rel}")
    h = hashlib.sha256()
    with open(p, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 16), b""):
            h.update(chunk)
    return h.hexdigest()


def verify_pins() -> None:
    bad = []
    for rel, pin in DECISION_PINS.items():
        got = _sha256(rel)
        if got != pin:
            bad.append(f"{rel}: sha256 {got} != pinned {pin}")
    for rel, (pin, _role) in INPUT_PINS.items():
        got = _sha256(rel)
        if got != pin:
            bad.append(f"{rel}: sha256 {got} != pinned {pin}")
    if bad:
        raise RuntimeError("pinned inputs changed or missing (no fallback):\n  " + "\n  ".join(bad))


def _load_json(rel: str):
    with open(os.path.join(ROOT, rel), encoding="utf-8") as f:
        return json.load(f)


def bus_draw(load_W: float, eta: float) -> float:
    """P_bus = P_load / eta (bus_power_boundary_v1). Explicit inputs only; refuses invalid values."""
    if not (isinstance(load_W, (int, float)) and math.isfinite(load_W) and load_W >= 0):
        raise ValueError(f"load must be a finite number >= 0 W, got {load_W!r}")
    if not (isinstance(eta, (int, float)) and 0.0 < eta <= 1.0):
        raise ValueError(f"efficiency must be in (0, 1], got {eta!r}")
    return load_W / eta


def headroom_W(limit_W: float, f_d: float, aux_bus_W: float) -> float:
    """Budget left for the reserved pre-ionizer slot: H = L (1 - f_d) - A, with f_d = P_bus[hall_discharge] / L."""
    if not (0.0 <= f_d <= 1.0):
        raise ValueError(f"discharge bus share must be in [0, 1], got {f_d!r}")
    if limit_W <= 0 or aux_bus_W < 0:
        raise ValueError("limit must be > 0 and auxiliary bus draw >= 0")
    return limit_W * (1.0 - f_d) - aux_bus_W


def rhodes_eta_band(ec: dict, p_min_W: float) -> dict:
    """Min/max digitized discharge-supply efficiency of the HD-RH24-* series at P_out >= p_min_W (all inputs 25/28/34 V)."""
    pts = []
    for ent in ec["components"]["hall_discharge"]["entries"]:
        if ent["id"].startswith("HD-RH24-"):
            for p in ent["value"]:
                pts.append((ent["id"], p["P_out_W"], p["efficiency"]))
    if not pts:
        raise RuntimeError("no HD-RH24-* series in the electrical-closure data")
    sel = [p for p in pts if p[1] >= p_min_W]
    lo = min(sel, key=lambda t: t[2])
    hi = max(sel, key=lambda t: t[2])
    all_lo = min(pts, key=lambda t: t[2])
    return {"min": lo[2], "min_at": [lo[0], lo[1]], "max": hi[2], "max_at": [hi[0], hi[1]],
            "n_points": len(sel), "p_min_W": p_min_W, "all_points_min": all_lo[2], "all_points_min_at": [all_lo[0], all_lo[1]],
            "max_measured_P_out_W": max(p[1] for p in pts)}


