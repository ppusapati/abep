def efficiency_parameters(eta_d: dict) -> list:
    return [
        {"supply": "discharge converter", "component": "hall_discharge", "kind": "PARAMETER",
         "range": [eta_d["min"], ETA_D_BENAVIDES[1]],
         "analogs": [
             {"device": "NASA SSEP LCC resonant discharge breadboard (28 V class)", "source": "electrical_closure HD-RH24-*",
              "value": f"{eta_d['min']}-{eta_d['max']} at P_out >= {RH24_MIN_POWER_W:.0f} W (24-34 V in, 250/400 V out; "
                       f"{eta_d['n_points']} points); {eta_d['all_points_min']} over all 200-1000 W points",
              "evidence_class": "digitized", "level": 3},
             {"device": "NASA SSEP full-bridge DPS module, <= 375 W, 350 V out", "source": "X-BENAVIDES19 p. 15",
              "value": "0.92-0.95 across the design power and 24-34 V input", "evidence_class": "measured", "level": 3},
             {"device": "SETS PPU-500 (catalog)", "source": "X-SETS-PPU500", "value": "'up to 94 %' (conditions not stated)",
              "evidence_class": "measured", "level": 5, "use": "context only"}],
         "limits": f"no accessed 24-34 V measurement above {eta_d['max_measured_P_out_W']} W output; harness/filters to the "
                   "thruster excluded (bus_power_boundary_v1 needs them inside eta; PENDING H2-7 harness)",
         "closes_with": "measured bus-to-terminal efficiency of the flight-like discharge converter at the allocation power "
