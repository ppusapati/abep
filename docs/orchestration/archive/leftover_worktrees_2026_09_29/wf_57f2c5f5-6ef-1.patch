               "rule": "each step's P_bus <= the PROPOSED start-up limit 1500 W (H24-33) under the averaging window of H24-34"}

    k1 = _bracket([HEAT_START_W[0], KEEP_START_W[0], 2 * pf1], [HEAT_START_W[1], KEEP_START_W[1], MAG_W[1], 2 * PFCV_W[1]])
    k2 = _bracket([2 * pf1], [MAG_W[1], KEEP_START_W[1], 2 * PFCV_W[1]])
