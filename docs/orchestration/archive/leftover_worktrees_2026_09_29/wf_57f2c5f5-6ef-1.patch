         "mitigation": "current-controlled supply with slew limit (TBD - requires MC-1 L/R, H2-1)"},
        {"id": "TR-5", "what": "compressor motor start", "bound": "TBD - requires the H2-3 motor drive",
         "mitigation": "soft-start motor drive with current limit (PROPOSED)"},
        {"id": "TR-6", "what": "PPU input-filter charging at power-on", "bound": "TBD - requires the EPS ICD inrush limit",
         "mitigation": "input inrush limiter (PROPOSED)"},
        {"id": "TR-7", "what": "I_d excursions at atmosphere admission", "bound": "TBD - H-1 Phase-1 measurement",
         "mitigation": "discharge current limit + state-machine guard (I_d monitored)"},
    ]
    peak = {"name": "PEAK", "definition": "worst simultaneous loads including transients/inrush, per case",
            "cases": cases, "transients": transients,
            "proposed_rules": [
                "PR-1 (PROPOSED): every PEAK case, averaged over the EPS window (H24-34, TBD), stays below 1500 W "
                "(H24-33, PROPOSED reading of the RFP limit); the instantaneous inrush meets the EPS ICD limit (TBD)",
                "PR-2 (PROPOSED): the heater is off before the compressor spin-up (consistent with the state machine: heater "
                "off in WARM_UP)",
                "PR-3 (PROPOSED): no two high-power converters start in the same control cycle (stagger discharge, compressor "
                "and pre-ionizer starts)",
                "PR-4 (PROPOSED): heater re-application with the discharge on (PK-5) only at a derated discharge setpoint or "
                "with the compressor idle; FDIR input to the control/FDIR row",
                "PR-5 (PROPOSED): the discharge supply runs in voltage regulation with an active current limit (glow-mode "
                "capable) so ignition and excursion transients are bounded by the limit setting"],
            "evidence_class": "model-derived (sums of sourced brackets); every discharge term is a measured/allocated "
                              "quantity, never predicted"}
    return {"STEADY": steady, "STARTUP": startup, "PEAK": peak}


def ledger_attempts(ab) -> list:
    """Call bus_power_ledger with the inputs that exist; record the boundary's own refusal (nothing defaulted)."""
    out = []
    loads = {"cathode_heater": 0.0}
    effs = {"cathode_heater": 1.0}
    for mode in ("STEADY", "STARTUP", "PEAK"):
        try:
            ab.bus_power_ledger("hall_only", dict(loads) if mode == "STEADY" else {}, dict(effs) if mode == "STEADY" else {})
            status, msg = "EVALUATED", None
        except ValueError as exc:
            status, msg = "NOT_EVALUABLE", str(exc)
        missing = [c for c in ab.REQUIRED_COMPONENTS["hall_only"] if not (mode == "STEADY" and c == "cathode_heater")]
        out.append({"architecture": "hall_only", "mode": mode, "status": status, "boundary_refusal": msg,
                    "passed_components": ["cathode_heater"] if mode == "STEADY" else [],
                    "blocking_components": missing,
                    "note": "hall_discharge is an allocation residual (not a load value); the auxiliary loads are PROPOSED "
                            "caps or PENDING; a ledger is evaluated only on measured/closed values"})
    out.append({"architecture": "rf_hall / ecr_hall", "mode": "all", "status": "NOT_ATTEMPTED",
                "boundary_refusal": None, "passed_components": [], "blocking_components": ["reserved slot not baseline (A5)"],
                "note": "pre-ionized ledgers belong to H-1 Phase 2 on the same boundary; headroom only (slot_headroom)"})
    return out


