def interface_demands() -> list:
    H1, H2, H3, H5, H6, H7 = (PENDING_LANES[k] for k in ("H2-1", "H2-2", "H2-3", "H2-5", "H2-6", "H2-7"))
    d = []
    def dem(frm, to, q, v, u, s):
        d.append({"from": frm, "to": to, "quantity": q, "value": v, "units": u, "status": s})
    me = REL_HERE + "/"
    dem(me, H1, "hall_magnet load allocation cap (hot coil, steady)", list(MAG_W), "W", "PROPOSED allocation; H2-1 returns the coil value")
    dem(H1, me, "MC-1 coil I, V, R_hot, L (ramp time) and PM/EM choice", None, "A, V, ohm, H", "PENDING")
    dem(me, H1, "discharge-supply voltage rating / anode isolation", VD_RATING_V, "V", "INPUT (HW-ENV-01 PROPOSED)")
    dem(me, H2, "heater supply envelope: constant current, <= 12 V class, P_max to cover the selected C-1",
        list(HEAT_START_W), "W", "analog bracket; H2-2 returns the C-1 heater profile")
    dem(H2, me, "C-1 heater V/I/P vs time, t_preheat, heater state at discharge ignition", None, "V, A, W, s", "PENDING")
    dem(H2, me, "steady keeper policy, keeper sustaining V/I, ignition voltage, self-heating current", None, "V, A", "PENDING")
    dem(H2, me, "cathode return path / cathode-common connection to spacecraft ground", None, "-", "PENDING")
    dem(me, H2, "C-1 emission capability I_emit >= I_d + I_keeper + I_interstage at the allocation bound",
        "see discharge_current_bounds", "A", "derived bound (HW-C1-02)")
    dem(H3, me, "valve count per mode, atmospheric valve coil R/I, Xe PFCV driver", None, "-, ohm, A", "PENDING")
    dem(H3, me, "compressor steady bus draw and spin-up profile, motor bus voltage", None, "W, s, V", "PENDING")
    dem(me, H3, "compressor bus allocation (OD-C2 screening)", COMP_ALLOC_BUS_W, "W", "PROPOSED (owner replaces)")
    dem(me, H5, "PPU conversion loss to reject (discharge + identified auxiliaries) at the allocation corners",
        "see discharge_allocation_table.discharge_conversion_loss_W + aux loss_identified_W", "W", "PRELIMINARY")
    dem(H5, me, "thermal_control heater loads per mode and duty; PPU baseplate temperature range", None, "W, C", "PENDING")
    dem(me, H6, "per-component load-plane metering channels (v1 ids) + DC-input metering as evidence; sampling for PEAK "
        "transients", "INS-02 / INS-03 rows of instrumentation_definition Sec. 6", "-", "PRELIMINARY (bandwidth TBD)")
    dem(H6, me, "flight sensor set and its housekeeping power", None, "W", "PENDING")
    dem(me, H7, "PPU mass/volume, harness length and gauge (discharge harness loss inside eta_d)", None, "kg, m",
        "PENDING (H2-7 owns the mass model)")
    dem(me, PENDING_LANES["PMI-ICD"], "pre-ionizer electrical power interface: switched/fused/metered bus tap; slot "
        "headroom H_slot(f_d); standby booked under housekeeping (v1)", "see slot_headroom", "W", "PENDING (A6 ICD lane)")
    dem(me, PENDING_LANES["XE-LEDGER"], "start-up phase durations during which Xe flows (purge, preheat, ignition, "
        "warm-up, transition)", {"t_preheat_s": list(PREHEAT_S)}, "s", "analog; others TBD")
    dem(me, PENDING_LANES["P1-PREG"], "P_bus reconstruction rule for T/P_bus (PARTIAL vs V1)", "see ground_vs_flight",
        "-", "PRELIMINARY")
    dem(me, PENDING_LANES["M16"], "m16_rows of this lane", "see m16_rows", "-", "PRELIMINARY")
    dem(me, "H-1 CI PS-C", "H-1 ground-supply ratings", "see ground_vs_flight.h1_ground_supplies", "V, A, W", "PRELIMINARY")
    dem(me, "H-1 CI SVC-1", "power-line ratings across the stand: discharge >= 350 V and >= 8.333 A (+ margin)",
        {"V": VD_RATING_V, "I_A": _r(P_REQ_W / min(VD_SET_V), 3)}, "V, A", "PRELIMINARY")
    dem(me, "H-1 CI FS-C", "gas-isolator voltage rating >= the discharge-supply rating", VD_RATING_V, "V", "PRELIMINARY")
    dem(me, "H-1 CI C-1 / MC-1", "load-plane terminals for keeper, heater and coil metering (HW-C1-05, HW-MC-14)", None, "-",
        "INPUT (existing requirements)")
    return d


