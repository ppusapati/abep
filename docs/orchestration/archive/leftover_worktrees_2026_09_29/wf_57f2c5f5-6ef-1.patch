      ", ".join(f"{k} `{v['path']}`" for k, v in d["pending_lanes"].items()) + ".")
    a("")
    return "\n".join(L)


def dumps(d: dict) -> str:
    return json.dumps(d, indent=1, ensure_ascii=False) + "\n"


def pending_lane_status(root: str) -> dict:
    """Lazy presence report of the PENDING lanes; never used to build the JSON."""
    return {k: ("PRESENT" if os.path.isdir(os.path.join(root, v)) else "MISSING") for k, v in PENDING_LANES.items()}


def main(argv=None) -> int:
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("--check", action="store_true", help="compare a fresh build with the committed outputs")
    ap.add_argument("--pending-status", action="store_true", help="report presence of the PENDING lane directories")
    args = ap.parse_args(argv)
    if args.pending_status:
        for k, v in pending_lane_status(ROOT).items():
            print(f"{k:10s} {v:8s} {PENDING_LANES[k]}")
        return 0
    doc = build()
    js, md = dumps(doc), render_md(doc)
    if args.check:
        bad = []
        for path, txt in ((OUT_JSON, js), (OUT_MD, md)):
            if not os.path.isfile(path):
                bad.append(f"{os.path.relpath(path, ROOT)} not committed")
                continue
            with open(path, encoding="utf-8") as f:
                if f.read() != txt:
                    bad.append(f"{os.path.relpath(path, ROOT)} differs from a fresh build")
        for b in bad:
            print(b)
        print("h2_4_ppu_bus check: " + ("OK" if not bad else "DRIFT"))
        return 1 if bad else 0
    with open(OUT_JSON, "w", encoding="utf-8") as f:
        f.write(js)
    with open(OUT_MD, "w", encoding="utf-8") as f:
        f.write(md)
    print(f"wrote {os.path.relpath(OUT_JSON, ROOT)} and {os.path.relpath(OUT_MD, ROOT)}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
