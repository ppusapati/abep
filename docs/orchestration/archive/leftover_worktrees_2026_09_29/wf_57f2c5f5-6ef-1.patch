def margin_table() -> list:
    rows = []
    for L in P_ALLOC_W:
        rows.append({"allocation_W": L, "requirement_W": P_REQ_W, "margin_W": _r(P_REQ_W - L),
                     "margin_fraction_of_requirement": _r((P_REQ_W - L) / P_REQ_W),
                     "evidence_class": "model-derived", "basis": "A5 allocation vs RFP requirement (arithmetic)"})
    return rows


def bus_current_table() -> list:
    out = []
    for P in (P_ALLOC_W[0], P_ALLOC_W[1], P_REQ_W):
        for V in BUS_V_OPTIONS:
            out.append({"P_bus_W": P, "V_bus_V": V, "I_bus_A": _r(P / V, 3)})
    return out


def discharge_current_bounds() -> list:
    out = []
    for V in VD_SET_V + (VD_RATING_V,):
        out.append({"V_d_V": V, "I_d_bound_at_requirement_A": _r(P_REQ_W / V, 3),
                    "I_d_bound_at_allocation_A": [_r(P_ALLOC_W[0] / V, 3), _r(P_ALLOC_W[1] / V, 3)],
                    "note": "upper bound (eta <= 1, other loads >= 0); not a prediction of I_d"})
    return out


def aux_cap_bus(eta_aux: float) -> dict:
    """Steady auxiliary bus draw at the PROPOSED allocation caps (thermal_control and housekeeping excluded: U)."""
    mag = bus_draw(MAG_W[1], eta_aux)
    keep = bus_draw(KEEP_STEADY_W[1], eta_aux)
    heat = bus_draw(0.0, 1.0)
    flow = bus_draw(N_VALVES_CAP * PFCV_W[1], eta_aux)
    comp = COMP_ALLOC_BUS_W
    return {"hall_magnet": _r(mag), "cathode_keeper": _r(keep), "cathode_heater": _r(heat), "flow_control": _r(flow),
            "compressor": _r(comp), "total_excl_U": _r(mag + keep + heat + flow + comp),
            "loss_identified_W": _r((mag - MAG_W[1]) + (keep - KEEP_STEADY_W[1]) + (flow - N_VALVES_CAP * PFCV_W[1]))}


def aux_floor_bus() -> dict:
    flow = bus_draw(PFCV_W[0], ETA_AUX[1])
    return {"hall_magnet": 0.0, "cathode_keeper": 0.0, "cathode_heater": 0.0, "flow_control": _r(flow),
            "compressor": "C (PENDING H2-3; no floor justifiable)", "total_excl_C_and_U": _r(flow),
            "conditions": "permanent-magnet MC-1, keeper off, heater off (self-heating), one Xe PFCV at its minimum current, "
                          "efficiency at the upper analog 0.89"}


def discharge_allocation_table(eta_d: dict) -> list:
    rows = []
    for L in P_ALLOC_W:
        for ea in ETA_AUX:
            A = aux_cap_bus(ea)
            for U in U_GRID_W:
                p_bus_d = L - A["total_excl_U"] - U
                for ed in (eta_d["min"], ETA_D_BENAVIDES[1]):
                    p_d = bus_draw(p_bus_d, 1.0) * ed
                    rows.append({"allocation_W": L, "eta_aux": ea, "aux_bus_at_caps_W": A["total_excl_U"], "U_W": U,
                                 "P_bus_discharge_W": _r(p_bus_d, 2), "eta_d": ed, "P_d_load_allocation_W": _r(p_d, 2),
                                 "discharge_conversion_loss_W": _r(p_bus_d - p_d, 2),
                                 "f_d": _r(p_bus_d / L),
                                 "I_d_at_Vd_A": {str(int(v)): _r(p_d / v, 3) for v in VD_SET_V}})
    return rows


def slot_headroom() -> dict:
    A_cap = aux_cap_bus(ETA_AUX[0])["total_excl_U"]
    A_floor = aux_floor_bus()["total_excl_C_and_U"]
    table = []
    for f in F_D_GRID:
        table.append({"f_d": f, **{f"H_at_{int(L)}W": _r(headroom_W(L, f, A_cap), 2) for L in P_ALLOC_W + (P_REQ_W,)}})
    zero = {f"f_d_zero_at_{int(L)}W": _r(1.0 - A_cap / L) for L in P_ALLOC_W + (P_REQ_W,)}
    zero_floor = {f"f_d_zero_at_{int(L)}W": _r(1.0 - A_floor / L) for L in P_ALLOC_W + (P_REQ_W,)}
    return {
        "definition": "f_d = P_bus[hall_discharge] / L (bus-side discharge share of the limit L); "
                      "H_slot(f_d) = L (1 - f_d) - A_aux - U, the bus power left inside L for the reserved pre-ionizer "
                      "slot of rf_hall (rf_source) or ecr_hall (ecr_source + ecr_magnet) plus its housekeeping increment",
        "fit_condition_not_evaluated": "a contingency module fits only if P_bus[rf_source] + dK_preionizer <= H_slot(f_d,rf_hall) "
                                       "or P_bus[ecr_source] + P_bus[ecr_magnet] + dK_preionizer <= H_slot(f_d,ecr_hall), "
                                       "with f_d measured on the pre-ionized arm itself (H-1 Phase 2); this lane does not "
                                       "evaluate it and draws no conclusion (A7 blocker 2)",
        "coupling_plane_equivalent": "maximum net source power at the coupling plane = eta_chain x (H_slot - dK_preionizer); "
                                     "eta_chain evidence in H24-42 / H24-43 (context only)",
        "aux_case": {"name": "AUX-CAP", "A_aux_bus_W": A_cap, "eta_aux": ETA_AUX[0],
                     "components": aux_cap_bus(ETA_AUX[0]),
                     "not_included": "U = P_bus[thermal_control] + P_bus[housekeeping] (PENDING H2-5 / H2-6); subtract "
                                     "U from every entry; if the compressor draws C < 300 W add (300 - C)"},
        "table": table,
        "f_d_where_headroom_vanishes_AUX_CAP_U0": zero,
        "f_d_where_headroom_vanishes_AUX_FLOOR_excl_C_U": zero_floor,
        "evidence_class": "model-derived",
        "statement": "headroom stated as a function of the unknown discharge share only; no RF/ECR fit conclusion",
    }


def _bracket(terms_lo: list, terms_hi: list) -> list:
    lo = sum(bus_draw(x, ETA_AUX[1]) for x in terms_lo)
    hi = sum(bus_draw(x, ETA_AUX[0]) for x in terms_hi)
    return [_r(lo, 2), _r(hi, 2)]


def profiles(sm: dict) -> dict:
    states = {s["id"]: s for s in sm["states"]}
    def st(sid):
        if sid not in states:
            raise KeyError(f"state {sid} not in dual_feed_state_machine_v1")
        s = states[sid]
        return {"state_id": sid, "outputs": s["outputs"], "valves": s["valves"], "compressor": s["compressor"]}

    pf1 = PFCV_W[0]
    steady_sourced = _bracket([pf1], [MAG_W[1], KEEP_STEADY_W[1], 2 * PFCV_W[1]])
    steady = {
        "name": "STEADY", "mode": "atmospheric Hall + Xe cathode (A5 nominal mode)",
        "state": st("AIR_ONLY_ANODE_XE_CATHODE"),
        "components": {
            "hall_discharge": "allocation residual P_bus,d = L - A_aux - U (discharge_allocation_table)",
            "hall_magnet": {"load_W": list(MAG_W), "note": "hot coil (H24-14)"},
            "cathode_keeper": {"load_W": list(KEEP_STEADY_W)},
            "cathode_heater": {"load_W": 0.0, "efficiency": 1.0, "condition": "C-1 self-heats (PENDING H2-2)"},
            "flow_control": {"energized": "xe_cathode (Xe PFCV) + atm_anode", "load_W": [pf1, _r(2 * PFCV_W[1])]},
            "compressor": {"bus_allocation_W": COMP_ALLOC_BUS_W},
            "thermal_control": "TBD (PENDING H2-5)", "housekeeping": "TBD (PENDING H2-6 + controller)"},
        "aux_bus_sourced_W_excl_compressor_U": steady_sourced,
        "aux_bus_at_caps_W_excl_U": aux_cap_bus(ETA_AUX[0])["total_excl_U"],
        "rule": "STEADY P_bus <= A5 allocation 1300-1350 W (design allocation) and < 1500 W (requirement)",
        "degraded_variant": "XE_FALLBACK (time-limited Xe contingency): atm valve closed, xe_anode at the fallback setpoint, "
                            "compressor idle or stopped (TBD); not a nominal profile (A5 rules), checked in PEAK only if "
                            "the compressor keeps running",
    }

    seq = []
    def phase(i, name, sid, on, loads_lo, loads_hi, duration, notes, symbolic):
        seq.append({"step": i, "name": name, "state": st(sid), "components_on": on,
                    "aux_bus_sourced_W": _bracket(loads_lo, loads_hi) if loads_hi else [0.0, 0.0],
                    "symbolic_terms": symbolic, "duration": duration, "notes": notes})
    phase(0, "OFF", "OFF", ["housekeeping (standby, TBD)"], [], [], "-",
          "all converters off; invariant P_bus <= P_bus_idle_max (TBD, state machine)", ["P_bus[housekeeping] standby (TBD)"])
    phase(1, "Xe purge", "XE_PURGE", ["flow_control", "housekeeping", "thermal_control"], [pf1], [2 * PFCV_W[1]],
          "t_purge: TBD - requires the H2-2/H2-3 purge setpoint and the Xe ledger (" + PENDING_LANES["XE-LEDGER"] + ")",
          "xe_cathode (+ xe_anode if the feed routes it)", ["U"])
    phase(2, "heater preheat (cathode conditioning)", "CATHODE_CONDITIONING",
          ["cathode_heater", "flow_control", "housekeeping", "thermal_control"], [HEAT_START_W[0], pf1],
          [HEAT_START_W[1], PFCV_W[1]], {"analog_s": list(PREHEAT_S), "status": pending("H2-2")},
          f"heater energy per start {HEATER_E_WH[0]}-{HEATER_E_WH[1]} Wh (SITAEL HC1 analog pairs); constant-current heater "
          "drive (PROPOSED)", ["U"])
    phase(3, "keeper ignition", "CATHODE_IGNITION", ["cathode_heater", "cathode_keeper", "flow_control", "housekeeping"],
          [HEAT_START_W[0], KEEP_START_W[0], pf1], [HEAT_START_W[1], KEEP_START_W[1], PFCV_W[1]],
          "t_ignition: TBD - bounded retries (state machine); open-circuit >= 100 V then current regulation (H24-18)",
          "keeper-only discharge brackets from CK-PEDRINI17-HC1/HC3", ["U"])
    phase(4, "magnet ramp (entry of Xe discharge ignition)", "XE_DISCHARGE_IGNITION",
          ["hall_magnet", "cathode_keeper", "cathode_heater (per C-1 design)", "flow_control", "housekeeping"],
          [KEEP_START_W[0], 2 * pf1], [HEAT_START_W[1], KEEP_START_W[1], MAG_W[1], 2 * PFCV_W[1]],
          "t_magnet_ramp: TBD - requires the MC-1 coil L/R and the supply slew (" + PENDING_LANES["H2-1"] + ")",
          "current-controlled coil: cold-coil power <= hot steady (H24-14); lower bound with heater off, upper with heater "
          "on; xe_anode opens to the ignition setpoint", ["U"])
    phase(5, "Xe discharge ignition", "XE_DISCHARGE_IGNITION",
          ["hall_discharge", "hall_magnet", "cathode_keeper", "cathode_heater (per C-1 design)", "flow_control", "housekeeping"],
          [KEEP_START_W[0], 2 * pf1], [HEAT_START_W[1], KEEP_START_W[1], MAG_W[1], 2 * PFCV_W[1]],
          "until lit and stable (bounded retries); soft-start ramp tens of ms (H24-35)",
          "discharge at V_d_ign with Xe anode flow; heater off 'once the discharge starts' (Goebel & Katz p. 337 via "
          "lane 19) unless the C-1 design keeps it on; alternative published order: glow-mode start with the magnet after "
          "the discharge (X-RHODES24P) - an H-1 option (PK-1 applies either way)", ["P_bus[hall_discharge] at ignition "
                                                                                  "(H-1 S1 measurement)", "U"])
    phase(6, "Xe warm-up + compressor spin-up", "WARM_UP",
          ["hall_discharge", "hall_magnet", "cathode_keeper (per design)", "flow_control", "compressor (spin-up)",
           "housekeeping", "thermal_control"], [2 * pf1], [MAG_W[1], KEEP_START_W[1], 2 * PFCV_W[1]],
          "t_warmup: TBD - requires the H2-5 thermal soak", "heater off; compressor spin-up commanded on entry",
          ["P_bus[hall_discharge] warm-up (H-1)", "P_bus[compressor] spin-up (PENDING H2-3)", "U"])
    phase(7, "atmosphere admission", "ATMOSPHERE_ADMISSION",
          ["hall_discharge", "hall_magnet", "cathode_keeper (per design)", "flow_control (3 valves)", "compressor",
           "housekeeping", "thermal_control"], [3 * pf1], [MAG_W[1], KEEP_STEADY_W[1], 3 * PFCV_W[1]],
          "t_admit_ramp: TBD (state-machine parameter)", "Xe anode held while the atmospheric valve ramps open; I_d "
