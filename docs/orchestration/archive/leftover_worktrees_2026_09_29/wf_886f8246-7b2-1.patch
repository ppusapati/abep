# ------------------------------------------------------------------------------------------------------ I/O
def render():
    return json.dumps(build_document(build_derived()), indent=1, ensure_ascii=False) + "\n"


def sha256_file(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 16), b""):
            h.update(chunk)
    return h.hexdigest()


def verify_pins(repo_root=REPO_ROOT):
    """Return {path: (expected, actual or None)} for every pinned input (None when the file is absent)."""
    out = {}
    for path, expected, _role, _kind in PINNED_INPUTS:
        if expected is None:
            continue
        full = os.path.join(repo_root, path)
        out[path] = (expected, sha256_file(full) if os.path.exists(full) else None)
    return out


def pending_lane_status(repo_root=REPO_ROOT):
    """Lazy, read-only presence check of the parallel lanes (never imported or parsed; not written to the JSON)."""
    return {k: ("present (not read by this lane)" if os.path.exists(os.path.join(repo_root, p)) else "absent")
            for k, p in PENDING_LANES.items()}


def main(argv=None):
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("--check", action="store_true", help="fail if the committed JSON differs from a fresh build")
    ap.add_argument("--verify-pins", action="store_true", help="check the sha256 of every pinned input")
    args = ap.parse_args(argv)
    text = render()
    if args.verify_pins:
        bad = {p: v for p, v in verify_pins().items() if v[0] != v[1]}
        for p, (e, a) in sorted(bad.items()):
            print(f"PIN MISMATCH {p}: expected {e}, found {a}")
        print("pins OK" if not bad else f"{len(bad)} pin(s) differ")
        if bad:
            return 1
    if args.check:
        with open(OUT_PATH, encoding="utf-8") as f:
            same = f.read() == text
        print("check OK" if same else "check FAILED: the committed JSON differs from a fresh build")
        return 0 if same else 1
    if not args.verify_pins:
        with open(OUT_PATH, "w", encoding="utf-8") as f:
            f.write(text)
        print(f"wrote {OUT_PATH}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
