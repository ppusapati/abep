def _p(pid, topic, name, value, units, basis, source, evidence_class, status, representativeness, ci, note=None):
    if basis not in BASES:
        raise H22InputError(f"{pid}: unknown basis {basis!r}")
    if representativeness not in REPRESENTATIVENESS:
        raise H22InputError(f"{pid}: unknown representativeness {representativeness!r}")
    if evidence_class is not None and evidence_class not in EVIDENCE_CLASSES:
        raise H22InputError(f"{pid}: unknown evidence class {evidence_class!r}")
    e = {"id": pid, "topic": topic, "name": name, "value": value, "units": units, "basis": basis, "source": source,
         "evidence_class": evidence_class, "status": status, "representativeness": representativeness, "ci": ci}
    if note:
        e["note"] = note
    return e


def pend(key, extra=""):
    return f"PENDING {PENDING_LANES[key]}" + (f" ({extra})" if extra else "")


