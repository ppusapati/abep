    for P0 in grid("plenum_pressure_bar"):
        for T in grid("gas_temperature_K"):
            orif[f"P0={P0:g}bar"] = {
                "d_um_at_0.10_mg_s": sig(choked_orifice_diameter_um(q10, P0, T, inp("kaist_orifice_cd"), inp("xe_gamma"),
                                                                    inp("xe_molar_mass_g_mol"), inp("N_A_per_mol"), k_B)),
                "d_um_at_0.15_mg_s": sig(choked_orifice_diameter_um(q15, P0, T, inp("kaist_orifice_cd"), inp("xe_gamma"),
                                                                    inp("xe_molar_mass_g_mol"), inp("N_A_per_mol"), k_B))}
    put("choked_orifice_diameter_um", orif, "um", "mdot = Cd A P0 sqrt(gamma/(R_s T0)) (2/(gamma+1))^((gamma+1)/"
        "(2(gamma-1))), ideal gas, gamma = 5/3, Cd = 0.97 (IEPC-2009-061 assumption), T0 = 293.15 K",
        ["a5_cathode_flow_design_target_mg_s", "a5_cathode_flow_upper_test_point_mg_s", "kaist_orifice_cd", "xe_gamma",
         "xe_molar_mass_g_mol", "N_A_per_mol", "k_B_J_K", "GRIDS.plenum_pressure_bar"],
        note="cross-check: the IEPC-2009-061 cathode channel used a 9 um choked orifice at ~3 bar for a 0-2 sccm "
             "requirement; sizing is final only after H4 measures the flow and H2-3 fixes the plenum pressure")
    sens = {f"dT={dT:g}K": sig(choked_flow_relative_change(inp("kaist_pressure_tolerance_frac"), dT, 293.15))
            for dT in grid("plenum_temperature_excursion_K")}
    put("flight_flow_tolerance_frac", sens, "fraction of flow", "|dP0/P0| + |dT0|/(2 T0) with dP0/P0 = +/- 1 % "
        "(IEPC-2009-061 accumulator tolerance) and T0 = 293.15 K", ["kaist_pressure_tolerance_frac",
                                                                    "GRIDS.plenum_temperature_excursion_K"],
        note="worst-case linear sum of the plenum terms only; orifice Cd calibration and erosion/clogging are "
             "additional and TBD")
    return d


