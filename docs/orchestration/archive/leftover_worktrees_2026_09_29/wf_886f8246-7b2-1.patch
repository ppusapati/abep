# ------------------------------------------------------------------------------------------------------ helpers
def _num(name, x, *, lo=None, hi=None, lo_open=False):
    if x is None or isinstance(x, bool) or not isinstance(x, (int, float)) or not math.isfinite(float(x)):
        raise H22InputError(f"{name}: expected a finite number, got {x!r} (no default is substituted)")
    x = float(x)
    if lo is not None and (x < lo or (lo_open and x == lo)):
        raise H22InputError(f"{name} = {x} below its physical range ({'>' if lo_open else '>='} {lo})")
    if hi is not None and x > hi:
        raise H22InputError(f"{name} = {x} above its physical range (<= {hi})")
    return x


def inp(key):
    """Value of a sourced input. A missing key raises; there is no fallback."""
    if key not in INPUTS:
        raise H22InputError(f"missing input {key!r}")
    return INPUTS[key]["value"]


def grid(key):
    if key not in GRIDS:
        raise H22InputError(f"missing evaluation grid {key!r}")
    return list(GRIDS[key]["values"])


def sig(x, n=6):
    """Round to n significant digits for a stable JSON text (the full-precision value is recomputed by --check)."""
    if isinstance(x, (list, tuple)):
        return [sig(v, n) for v in x]
    if x == 0 or not math.isfinite(x):
        return x
    return float(f"{x:.{n}g}")


# ------------------------------------------------------------------------------------------------------ relations
def stefan_boltzmann(k_B, h, c):
    """sigma = 2 pi^5 k_B^4 / (15 h^3 c^2)  [W m^-2 K^-4]  (exact SI constants)."""
    k = _num("k_B", k_B, lo=0.0, lo_open=True)
    hh = _num("h", h, lo=0.0, lo_open=True)
    cc = _num("c", c, lo=0.0, lo_open=True)
    return 2.0 * math.pi ** 5 * k ** 4 / (15.0 * hh ** 3 * cc ** 2)


def mg_s_to_sccm(mdot_mg_s, mg_s_per_sccm):
    return _num("mdot_mg_s", mdot_mg_s, lo=0.0) / _num("mg_s_per_sccm", mg_s_per_sccm, lo=0.0, lo_open=True)


def sccm_to_mg_s(q_sccm, mg_s_per_sccm):
    return _num("q_sccm", q_sccm, lo=0.0) * _num("mg_s_per_sccm", mg_s_per_sccm, lo=0.0, lo_open=True)


def xe_mass_kg(mdot_mg_s, hours):
    """m = mdot * t  [kg]; mdot in mg/s, t in h."""
    return _num("mdot_mg_s", mdot_mg_s, lo=0.0) * _num("hours", hours, lo=0.0) * 3600.0 / 1.0e6


def flow_for_mass_mg_s(mass_kg, hours):
    """Constant flow that consumes mass_kg over hours (same relation as lane 19 max_cathode_flow_for_mass_mg_s)."""
    return _num("mass_kg", mass_kg, lo=0.0) * 1.0e6 / (_num("hours", hours, lo=0.0, lo_open=True) * 3600.0)


def richardson_J_A_cm2(T_K, A, phi0_eV, alpha_eV_K, e_C, k_B):
    """J = A T^2 exp(-e (phi0 + alpha T) / (k T))  [A/cm2] (Richardson-Dushman, no field enhancement)."""
    T = _num("T_K", T_K, lo=0.0, lo_open=True)
    return (_num("A", A, lo=0.0, lo_open=True) * T * T
            * math.exp(-_num("e_C", e_C, lo=0.0, lo_open=True) * (_num("phi0", phi0_eV, lo=0.0, lo_open=True)
                                                                   + _num("alpha", alpha_eV_K) * T)
                       / (_num("k_B", k_B, lo=0.0, lo_open=True) * T)))


def lafferty_evaporation_g_cm2_s(T_K, B_K, C):
    """W = 10^(C - B/T) / sqrt(T)  [g cm^-2 s^-1] (Lafferty fit as used by lane 19)."""
    T = _num("T_K", T_K, lo=0.0, lo_open=True)
    return 10.0 ** (_num("C", C) - _num("B_K", B_K, lo=0.0, lo_open=True) / T) / math.sqrt(T)


def required_keeper_fraction(r, R):
    """Smallest fixed keeper current, as a fraction of I_emit,min without keeper, that keeps
    (I_max + I_k) / (I_min + I_k) <= R when I_max / I_min = r:  I_k / I_min >= max(0, (r - R) / (R - 1))."""
    rr = _num("r", r, lo=1.0)
    RR = _num("R", R, lo=1.0, lo_open=True)
    return max(0.0, (rr - RR) / (RR - 1.0))


def mfc_relative_uncertainty(mdot_sccm, fs_sccm, a_fs, a_rd, zero_tempco_fs_per_K, dT_K, orientation_fs):
    """u/mdot = sqrt(a_rd^2 + (a_fs FS/q)^2 + (c_T dT FS/q)^2 + (o FS/q)^2)  (independent terms, root-sum-square)."""
    q = _num("mdot_sccm", mdot_sccm, lo=0.0, lo_open=True)
    fs = _num("fs_sccm", fs_sccm, lo=0.0, lo_open=True)
    if q > fs:
        raise H22InputError(f"flow {q} sccm exceeds the full scale {fs} sccm")
    terms = [_num("a_rd", a_rd, lo=0.0),
             _num("a_fs", a_fs, lo=0.0) * fs / q,
             _num("zero_tempco", zero_tempco_fs_per_K, lo=0.0) * _num("dT_K", dT_K, lo=0.0) * fs / q,
             _num("orientation_fs", orientation_fs, lo=0.0) * fs / q]
    return math.sqrt(sum(t * t for t in terms))


def max_full_scale_for_target(mdot_sccm, target, a_fs, a_rd):
    """Largest FS keeping sqrt(a_rd^2 + (a_fs FS/q)^2) <= target."""
    q = _num("mdot_sccm", mdot_sccm, lo=0.0, lo_open=True)
    t = _num("target", target, lo=0.0, lo_open=True)
    ard = _num("a_rd", a_rd, lo=0.0)
    if ard >= t:
        raise H22InputError(f"reading term {ard} alone exceeds the target {t}")
    return q * math.sqrt(t * t - ard * ard) / _num("a_fs", a_fs, lo=0.0, lo_open=True)


def gravimetric_duration_h(mdot_mg_s, target, u_balance_g):
    """Collection time so that two weighings (sqrt(2) u_bal) give relative uncertainty `target` on the mean flow."""
    rate_g_h = _num("mdot_mg_s", mdot_mg_s, lo=0.0, lo_open=True) * 3600.0 / 1000.0
    return math.sqrt(2.0) * _num("u_balance_g", u_balance_g, lo=0.0, lo_open=True) / (
        _num("target", target, lo=0.0, lo_open=True) * rate_g_h)


def rate_of_rise_Pa_s(mdot_mg_s, T_K, volume_L, molar_mass_g_mol, N_A, k_B):
    """Constant-volume (rate-of-rise) calibration: dP/dt = mdot R T / (M V), ideal gas, R = N_A k_B."""
    mdot = _num("mdot_mg_s", mdot_mg_s, lo=0.0, lo_open=True) * 1.0e-6
    R = _num("N_A", N_A, lo=0.0, lo_open=True) * _num("k_B", k_B, lo=0.0, lo_open=True)
    M = _num("molar_mass_g_mol", molar_mass_g_mol, lo=0.0, lo_open=True) * 1.0e-3
    V = _num("volume_L", volume_L, lo=0.0, lo_open=True) * 1.0e-3
    return mdot * R * _num("T_K", T_K, lo=0.0, lo_open=True) / (M * V)


def choked_orifice_diameter_um(mdot_mg_s, P0_bar, T0_K, cd, gamma, molar_mass_g_mol, N_A, k_B):
    """Ideal-gas choked orifice: mdot = Cd A P0 sqrt(gamma/(R_s T0)) (2/(gamma+1))^((gamma+1)/(2(gamma-1)))."""
    mdot = _num("mdot_mg_s", mdot_mg_s, lo=0.0, lo_open=True) * 1.0e-6
    P0 = _num("P0_bar", P0_bar, lo=0.0, lo_open=True) * 1.0e5
    T0 = _num("T0_K", T0_K, lo=0.0, lo_open=True)
    g = _num("gamma", gamma, lo=1.0, lo_open=True)
    R_s = _num("N_A", N_A, lo=0.0, lo_open=True) * _num("k_B", k_B, lo=0.0, lo_open=True) / (
        _num("molar_mass_g_mol", molar_mass_g_mol, lo=0.0, lo_open=True) * 1.0e-3)
    flux = (_num("cd", cd, lo=0.0, lo_open=True, hi=1.0) * P0 * math.sqrt(g / (R_s * T0))
            * (2.0 / (g + 1.0)) ** ((g + 1.0) / (2.0 * (g - 1.0))))
    area = mdot / flux
    return math.sqrt(4.0 * area / math.pi) * 1.0e6


def choked_flow_relative_change(dP_frac, dT_K, T0_K):
    """Choked flow: mdot ~ P0 / sqrt(T0)  =>  d(mdot)/mdot = dP0/P0 - dT0/(2 T0) (worst-case magnitude reported)."""
    return abs(_num("dP_frac", dP_frac)) + abs(_num("dT_K", dT_K)) / (2.0 * _num("T0_K", T0_K, lo=0.0, lo_open=True))


