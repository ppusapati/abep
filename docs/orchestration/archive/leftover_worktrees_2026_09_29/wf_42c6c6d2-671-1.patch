  {"id": "HI-02", "check": "compressor minimum inlet area vs intake frontal area (geometric compatibility of the PROPOSED backflow targets)", "method": "A_inlet_min(b) / A_intake per candidate-case from compressor_downselect_v1.requirement_envelope; > 1 would be a geometric incompatibility of that (candidate, b) combination"},
  {"id": "HI-03", "check": "cathode Xe term at the A5 upper test point 0.15 mg/s vs the allocation", "method": "same arithmetic as the design term"},
  {"id": "HI-04", "check": "overall envelope vs a launcher / spacecraft envelope", "method": "not checkable: no launcher or spacecraft envelope is defined in the repository"}
