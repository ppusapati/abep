def common_items() -> list:
    items = [_pmi01(), _pmi02(), _pmi03(), _pmi04(), _pmi05(), _pmi06(), _pmi07(), _pmi08(), _pmi09(), _pmi10(),
             _pmi11()]
    for it in items:
        bad = neutral_language_violations(it["definition"])
        if bad:
            raise ValueError(f"{it['id']} definition is not neutral across modules: {bad}")
        for occ, rec in it["satisfiability"].items():
            if rec["status"] == SATISFIABILITY_FORBIDDEN:
                raise ValueError(f"{it['id']}: {occ} cannot satisfy a common item; move it to an annex")
    return items


