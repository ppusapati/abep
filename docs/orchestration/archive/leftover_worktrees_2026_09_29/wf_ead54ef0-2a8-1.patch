def installation_record_schema() -> dict:
    check = {
        "type": "object", "additionalProperties": False, "required": ["status", "evidence_ref"],
        "properties": {
            "status": {"enum": ["PASS", "FAIL", "NOT_APPLICABLE", "NOT_DONE"]},
            "evidence_ref": {"type": "string", "description": "record id, file path or sha256 of the raw record"},
            "note": {"type": "string"},
        },
    }
    checks = ["part_log", "torque_and_alignment_record", "leak_check", "cold_flow_manifold_pressure",
              "bz_map_each_control_state", "in_situ_calibration", "dummy_load_pickup", "interlock_loop_test",
              "identification_line_readback", "thermocouple_channel_check", "service_line_configuration",
              "witness_set_record", "o_bearing_inspection", "xe_health_check"]
    return {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "urn:abep:schemas:interfaces:preionizer_module_installation_record_v1",
        "title": "Pre-ionizer module installation record (one per occupant exchange)",
        "description": "Produced at every configuration change under PMI-11.R8. PIM-0 records dummy_load_pickup as "
                       "NOT_APPLICABLE; o_bearing_inspection and xe_health_check are NOT_APPLICABLE only when no "
                       "O-bearing operation preceded the change or D-15-B is not adopted.",
        "type": "object", "additionalProperties": False,
        "required": ["record_id", "icd_version", "utc", "occupant_type", "occupant_serial", "occupant_drawing_sha256",
                     "h1_unit_id", "procedure_id", "checks"],
        "properties": {
            "record_id": {"type": "string"},
            "icd_version": {"const": "preionizer_module_icd_v1"},
            "utc": {"type": "string", "description": "ISO 8601 UTC time of the exchange"},
            "occupant_type": {"enum": list(OCCUPANTS)},
            "occupant_serial": {"type": "string"},
            "occupant_drawing_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "h1_unit_id": {"type": "string", "description": "must equal the unit of the HW-0 reference (HW-H1-02)"},
            "procedure_id": {"type": "string", "description": "the owner-adopted configuration-change procedure "
                                                              "(HWQ-01, HW-SVC-04)"},
            "checks": {"type": "object", "additionalProperties": False, "required": checks,
                       "properties": {c: check for c in checks}},
        },
        "allOf": [{
            "if": {"properties": {"occupant_type": {"const": "PIM-0"}}},
            "then": {"properties": {"checks": {"properties": {"dummy_load_pickup": {
