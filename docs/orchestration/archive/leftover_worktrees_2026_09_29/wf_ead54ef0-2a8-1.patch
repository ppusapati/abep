def verify_pins() -> dict:
    """Owner-decision and G0 pins must match (FAIL otherwise); read-at-base inputs are reported only."""
    out = {"pins": {}, "read_at_base": {}, "ok": True}
    for k, (rel, sha) in PINS.items():
        try:
            got = sha256_of(rel)
        except SourceError:
            got = None
        ok = got == sha
        out["pins"][k] = "MATCH" if ok else ("MISSING" if got is None else "MISMATCH")
        out["ok"] &= ok
    for k, (rel, sha, _what) in READ_AT_BASE.items():
        try:
            got = sha256_of(rel)
            out["read_at_base"][k] = "MATCH" if got == sha else "CHANGED_SINCE_BASE"
        except SourceError:
            out["read_at_base"][k] = "MISSING"
    return out


def main(argv=None) -> int:
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    g = ap.add_mutually_exclusive_group(required=True)
    g.add_argument("--write", action="store_true")
    g.add_argument("--check", action="store_true")
    g.add_argument("--verify-pins", action="store_true")
    a = ap.parse_args(argv)
    if a.verify_pins:
        rep = verify_pins()
        print(json.dumps(rep, indent=1))
        return 0 if rep["ok"] else 1
    text = render(build())
    out = ROOT / OUT_REL
    if a.write:
        out.write_text(text, encoding="utf-8")
        print(f"wrote {OUT_REL}")
        return 0
    committed = out.read_text(encoding="utf-8") if out.is_file() else None
    if committed != text:
        print(f"{OUT_REL} differs from a fresh build (run --write after review)")
        return 1
    print(f"{OUT_REL} reproduces")
    return 0


if __name__ == "__main__":
    sys.exit(main())
