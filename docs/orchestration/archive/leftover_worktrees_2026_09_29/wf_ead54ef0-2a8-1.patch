TREATMENTS = {
    "REMOVED_BY_DESIGN": "the interface makes the difference impossible or identical in every arm",
    "MEASURED_AND_GATED": "measured at every configuration change or pump-down; a comparability gate or correction "
                          "rule pre-registered at LOCK-1 applies",
    "MEASURED_AND_REPORTED": "measured and reported with R_arch (covariate), never corrected",
    "RECORDED_ARM_CONSEQUENCE": "a legitimate consequence of the ionization method; recorded, never equalised",
    "ORDER_BALANCED": "handled by the Phase-1 order-balanced scheme (fo_phase1_prereg_framework), audited through the "
                      "identification line and installation records of this ICD",
}


def _cf(cid, difference, installs, items, mechanism, treatment, how, stage):
    if treatment not in TREATMENTS:
        raise ValueError(treatment)
    return {"id": cid, "difference": difference, "installs": installs, "interface_items": items,
            "mechanism": mechanism, "treatment": treatment, "how": how, "stage": stage}


