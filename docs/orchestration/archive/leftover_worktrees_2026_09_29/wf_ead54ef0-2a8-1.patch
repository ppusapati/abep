def _walk(o, path=""):
    if isinstance(o, dict):
        yield path, o
        for k, v in o.items():
            yield from _walk(v, f"{path}/{k}")
    elif isinstance(o, list):
        for i, v in enumerate(o):
            yield from _walk(v, f"{path}/{i}")


def derive(core: dict) -> dict:
    ids = [it["id"] for it in core["common_items"]]
    usage = {}
    for a in core["annexes"]:
        refd = set(a["uses_common_items"])
        for key in ("module_specific_items", "equivalence_provisions", "deviations"):
            for x in a.get(key, []):
                refd.update(x.get("common_items", []))
                refd.update(x.get("affects_common_items", []))
        unknown = sorted(refd - set(ids))
        if unknown:
            raise ValueError(f"{a['id']} references undefined common items {unknown}")
        usage[a["id"]] = {"uses_common_items": list(a["uses_common_items"]),
                          "missing_common_items": [i for i in ids if i not in a["uses_common_items"]]}
    numeric, tbds = [], []
    for path, node in _walk({k: v for k, v in core.items() if k not in ("installation_record_schema",)}):
        if "status" in node and "value" in node and "unit" in node:
            if node["status"] == "TBD":
                tbds.append({"path": path, "requires": node["requires"], "closes_at_stage": node["closes_at_stage"],
                             "closes_at": node["closes_at"]})
            else:
                numeric.append({"path": path, "value": node["value"], "unit": node["unit"], "status": node["status"],
                                "evidence_class": node["evidence_class"], "source": list(node["source"]),
                                "role": node["role"]})
    by_stage = {}
    for t in tbds:
        by_stage.setdefault(t["closes_at_stage"], []).append(t["path"])
    return {
        "generated_by": THIS_REL,
        "common_item_ids": ids,
        "boundary_map": {it["id"]: it["boundary"] for it in core["common_items"]},
        "annex_usage": usage,
        "satisfiability_matrix": {it["id"]: {o: it["satisfiability"][o]["status"] for o in OCCUPANTS}
                                  for it in core["common_items"]},
        "numeric_value_index": numeric,
        "tbd_register": tbds,
        "tbd_by_closing_stage": {k: by_stage[k] for k in CLOSING_STAGES if k in by_stage},
    }


def build() -> dict:
    core = build_core()
    core["derived"] = derive(core)
    return core


def render(doc: dict) -> str:
    return json.dumps(doc, indent=1, ensure_ascii=False) + "\n"


