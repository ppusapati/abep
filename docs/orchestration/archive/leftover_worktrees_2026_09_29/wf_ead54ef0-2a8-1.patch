     ]
    },
    {
     "id": "PMI-10.R4",
     "text": "The hot-flow (source-on) source-chamber pressure is recorded as a result and never matched: source gas heating changes it (context in Annex RF).",
     "status": "PROPOSED",
     "basis": [
      {
       "ref": "SRC-W3",
