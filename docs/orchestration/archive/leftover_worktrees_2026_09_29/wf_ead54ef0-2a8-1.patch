class SourceError(RuntimeError):
    """A cited input or a value at its locator is missing or does not have the cited form."""


# --------------------------------------------------------------------------------------------------------------------
# reading cited inputs
# --------------------------------------------------------------------------------------------------------------------
_CACHE: dict = {}


def _path(rel: str) -> Path:
    p = ROOT / rel
    if not p.is_file():
        raise SourceError(f"cited input missing: {rel}")
    return p


def load(rel: str):
    if rel not in _CACHE:
        _CACHE[rel] = json.loads(_path(rel).read_text(encoding="utf-8"))
    return _CACHE[rel]


def sha256_of(rel: str) -> str:
    return hashlib.sha256(_path(rel).read_bytes()).hexdigest()


def ptr(obj, pointer: str):
    """Resolve a JSON pointer ('/a/0/b'); raise SourceError if any token is absent."""
    cur = obj
    for raw in pointer.strip("/").split("/"):
        tok = raw.replace("~1", "/").replace("~0", "~")
        if isinstance(cur, list):
            try:
                cur = cur[int(tok)]
            except (ValueError, IndexError):
                raise SourceError(f"pointer {pointer!r}: no list element {tok!r}") from None
        elif isinstance(cur, dict):
            if tok not in cur:
                raise SourceError(f"pointer {pointer!r}: no key {tok!r}")
            cur = cur[tok]
        else:
            raise SourceError(f"pointer {pointer!r}: cannot descend into {type(cur).__name__}")
    return cur


def index_of(lst, id_, key="id") -> int:
    hits = [i for i, x in enumerate(lst) if isinstance(x, dict) and x.get(key) == id_]
    if len(hits) != 1:
        raise SourceError(f"expected exactly one element with {key} == {id_!r}, found {len(hits)}")
    return hits[0]


def _is_num(x) -> bool:
    return isinstance(x, (int, float)) and not isinstance(x, bool)


def _numeric(value, where: str):
    ok = _is_num(value) or (isinstance(value, list) and value and all(_is_num(v) for v in value))
    if not ok:
        raise SourceError(f"{where}: expected a number or a list of numbers, got {value!r}")
    return value


def src_ref(key: str) -> str:
    if key in PINS:
        return PINS[key][0]
    if key in READ_AT_BASE:
        return READ_AT_BASE[key][0]
    raise SourceError(f"unknown source key {key!r}")


# --------------------------------------------------------------------------------------------------------------------
# quantity records
# --------------------------------------------------------------------------------------------------------------------
def tbd(unit: str, requires: str, stage: str, closes_at: str, **extra) -> dict:
    if stage not in CLOSING_STAGES:
        raise ValueError(f"unknown closing stage {stage!r}")
    rec = {"value": None, "unit": unit, "status": "TBD", "requires": TBD_PREFIX + requires,
           "closes_at_stage": stage, "closes_at": closes_at}
    rec.update(extra)
    return rec


def from_record(key: str, pointer: str, *, status: str, role: str, evidence_class: str | None = None,
                unit: str | None = None, locator_note: str | None = None, **extra) -> dict:
    """A quantity whose value (and, where the source states them, unit and evidence class) is read from a record
    {value, unit, evidence_class, ...} at ``pointer`` in the cited input ``key``."""
    rel = src_ref(key)
    rec = ptr(load(rel), pointer)
    if not isinstance(rec, dict) or "value" not in rec:
        raise SourceError(f"{rel}#{pointer}: not a value record")
    value = _numeric(rec["value"], f"{rel}#{pointer}")
    src_unit = rec.get("unit", rec.get("units"))
    if unit is None:
        if not src_unit:
            raise SourceError(f"{rel}#{pointer}: no unit at source and none given")
        unit = src_unit
    ec = rec.get("evidence_class")
    if ec is None:
        if evidence_class is None:
            raise SourceError(f"{rel}#{pointer}: no evidence class at source and none given")
        ec = evidence_class
    elif evidence_class is not None and evidence_class != ec:
        raise SourceError(f"{rel}#{pointer}: evidence class {ec!r} at source, {evidence_class!r} cited")
    if ec not in EVIDENCE_CLASSES:
        raise SourceError(f"{rel}#{pointer}: evidence class {ec!r} not in docs/EVIDENCE.md")
    out = {"value": value, "unit": unit, "status": status, "evidence_class": ec, "source": [key],
           "locator": f"{rel}#{pointer}" + (f" ({locator_note})" if locator_note else ""), "role": role}
    out.update(extra)
    return out


def from_raw(key: str, pointer: str, *, unit: str, status: str, evidence_class: str, role: str,
             locator_note: str | None = None, **extra) -> dict:
    """A quantity whose source stores a bare number at ``pointer`` (unit and class stated here, from the source text)."""
    rel = src_ref(key)
    value = _numeric(ptr(load(rel), pointer), f"{rel}#{pointer}")
    if evidence_class not in EVIDENCE_CLASSES:
        raise ValueError(evidence_class)
    out = {"value": value, "unit": unit, "status": status, "evidence_class": evidence_class, "source": [key],
           "locator": f"{rel}#{pointer}" + (f" ({locator_note})" if locator_note else ""), "role": role}
    out.update(extra)
    return out


_LIT: dict = {}


def _lit_from_entry(matrix_key: str, entry: dict) -> str:
    s = entry["source"]
    if matrix_key == "SRC-ECREV":
        lit_id = "LIT-ECR-" + s.get("source_id", entry["id"])
    else:
        lit_id = "LIT-" + re.sub(r"-(D?\d+)$", "", entry["id"])
    rec = {"kind": "literature", "citation": s["citation"], "doi_or_url": s.get("doi_or_url"),
           "access": s.get("access"),
           "recorded_by": f"{src_ref(matrix_key)} (entries cited here)",
           "accessed_by_this_lane": False,
           "note": "cited as recorded by the merged evidence matrix; not re-read by this lane"}
    if lit_id in _LIT and _LIT[lit_id]["citation"] != rec["citation"]:
        raise SourceError(f"{lit_id}: two different citations")
    _LIT[lit_id] = rec
    return lit_id


def evidence_entry(matrix_key: str, entry_id: str, *, role: str = "context_only", why: str) -> dict:
    """A context value from the RF/ECR evidence matrix: never a design value of Vyovrinda hardware."""
    if role != "context_only":
        raise ValueError("RF/ECR evidence-matrix values enter this ICD as context only")
    rel = src_ref(matrix_key)
    entries = load(rel)["entries"]
    i = index_of(entries, entry_id)
    e = entries[i]
    ec = e.get("evidence_class")
    if ec not in EVIDENCE_CLASSES:
        raise SourceError(f"{entry_id}: evidence class {ec!r}")
    value = e.get("value")
    unit = e.get("units", e.get("unit"))
    if isinstance(value, dict):            # RF matrix range records {'min':..,'max':..}
        value = [value[k] for k in ("min", "max") if k in value]
    value = _numeric(value, f"{rel} entry {entry_id}")
    lit = _lit_from_entry(matrix_key, e)
    locator = e.get("locator") or e["source"].get("locator")
    return {"value": value, "unit": unit, "status": "SOURCED", "evidence_class": ec,
            "source": [matrix_key, lit],
            "locator": f"{rel} entry {entry_id} (source locator: {locator})",
            "role": role, "quantity_at_source": e["quantity"],
            "uncertainty": e.get("uncertainty"),
            "applicability": e.get("applicability_to_abep"),
            "validation_status": "not validated on Vyovrinda hardware; different device and conditions",
            "why_cited": why}


def rfp_constant(name: str, unit: str) -> dict:
    rel = src_ref("SRC-RFP-CONSTANTS")
    tree = ast.parse(_path(rel).read_text(encoding="utf-8"))
    for node in ast.walk(tree):
        if isinstance(node, ast.ClassDef) and node.name == "RFPConstraints":
            for st in node.body:
                if (isinstance(st, ast.AnnAssign) and isinstance(st.target, ast.Name) and st.target.id == name
                        and isinstance(st.value, ast.Constant) and _is_num(st.value.value)):
                    return {"value": st.value.value, "unit": unit, "status": "RFP", "evidence_class": "assumed",
                            "source": ["SRC-RFP-CONSTANTS"], "locator": f"{rel} RFPConstraints.{name}",
                            "role": "requirement",
                            "note": "RFP limit as transcribed in the repository (verify against the RFP text)"}
    raise SourceError(f"RFPConstraints.{name} not found in {rel}")


def a5_bus_allocation() -> dict:
    rel = src_ref("SRC-OD-A5")
    items = load(rel)["allocations_and_requirements"]
    i = index_of(items, "bus-power design allocation", key="quantity")
    text = items[i]["value"]
    m = re.fullmatch(r"<= (\d+(?:\.\d+)?)-(\d+(?:\.\d+)?) kW", text)
    if not m:
        raise SourceError(f"A5 bus-power allocation not in the cited form: {text!r}")
    lo, hi = (round(float(g) * 1000.0, 6) for g in m.groups())
    return {"value": [lo, hi], "unit": "W", "status": "ALLOCATION", "evidence_class": "assumed",
            "source": ["SRC-OD-A5"], "locator": f"{rel}#/allocations_and_requirements/{i}/value",
            "as_published": text, "role": "allocation",
            "note": "owner design allocation for the whole propulsion system P_bus (upper bound between the two "
                    "numbers), leaving margin to the RFP 1.5 kW requirement; an allocation, never a prediction "
                    "(A5 what_this_is_not)"}


def a4_interlocks() -> list:
    lst = ptr(load(src_ref("SRC-OD-A4")), "/decisions/S1a_minimum_interlocks")
    if not (isinstance(lst, list) and lst and all(isinstance(x, str) for x in lst)):
        raise SourceError("A4 S1a_minimum_interlocks missing")
    return list(lst)


def controls_tbd_parameter(name: str, stage: str, closes_at: str) -> dict:
    rel = src_ref("SRC-LANE14")
    p = ptr(load(rel), f"/parameters/{name}")
    val = p.get("value")
    if not (isinstance(val, str) and val.startswith("TBD")):
        raise SourceError(f"{rel} parameter {name} is no longer TBD at source ({val!r}); re-review this ICD")
    req = re.sub(r"^TBD\s*[—-]\s*requires\s*", "", val)
    return tbd(p["unit"], req, stage, closes_at, source=["SRC-LANE14"], locator=f"{rel}#/parameters/{name}")


def w3_requirement_value(req_id: str, value_key: str, *, role: str, status: str | None = None) -> dict:
    rel = src_ref("SRC-W3")
    reqs = load(rel)["requirements"]
    i = index_of(reqs, req_id)
    rec = reqs[i]["values"][value_key]
    if rec.get("value") is None:
        raise SourceError(f"{req_id}.{value_key} has no value at source")
    return from_record("SRC-W3", f"/requirements/{i}/values/{value_key}", status=status or rec["status"],
                       role=role, locator_note=f"{req_id} values.{value_key}")


def w3_has(req_id: str) -> str:
    index_of(load(src_ref("SRC-W3"))["requirements"], req_id)
    return req_id


