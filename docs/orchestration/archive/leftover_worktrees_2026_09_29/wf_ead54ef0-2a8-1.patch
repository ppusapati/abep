# helpers for requirement and satisfiability records
# --------------------------------------------------------------------------------------------------------------------
def req(rid: str, text: str, status: str, basis: list) -> dict:
    if status not in REQUIREMENT_STATUSES:
        raise ValueError(status)
    for b in basis:
        if b["ref"] not in PINS and b["ref"] not in READ_AT_BASE and b["ref"] != "SRC-THIS-ICD":
            raise ValueError(f"{rid}: unknown basis ref {b['ref']}")
    return {"id": rid, "text": text, "status": status, "basis": basis}


def b(ref: str, locator: str) -> dict:
    return {"ref": ref, "locator": locator}


def sat(rf: tuple, ecr: tuple, blank: tuple) -> dict:
    out = {}
    for occ, (status, how, *rest) in zip(OCCUPANTS, (rf, ecr, blank)):
        if status not in SATISFIABILITY:
            raise ValueError(status)
        rec = {"status": status, "how": how}
        if status == "SATISFIABLE_PENDING_ANALYSIS":
            if not rest:
                raise ValueError(f"{occ}: pending analysis needs a closing analysis")
            rec["closing_analysis"] = rest[0]
        out[occ] = rec
    return out


# Neutral-language guard (owner rule: the common interface must not be secretly RF-specific). A common-item definition
# that names an RF-only element must name the ECR counterpart in the same text.
_NEUTRAL_PAIRS = [
    (r"\brf_source\b", r"\becr_source\b"),
    (r"\bRF\b", r"\bECR\b|microwave"),
    (r"\bcoax", r"waveguide|microwave feed"),
    (r"matching network", r"isolator"),
    (r"coil/antenna", r"coupling[- ]structure"),
]


def neutral_language_violations(text: str) -> list:
    return [f"{a!r} without {c!r}" for a, c in _NEUTRAL_PAIRS
            if re.search(a, text) and not re.search(c, text)]


