# ---------------------------------------------------------------------------------------------------------------------
# helpers
# ---------------------------------------------------------------------------------------------------------------------
def sha256_file(path: str) -> str:
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def _rel(path: str, base: str) -> str:
    return os.path.relpath(path, base).replace(os.sep, "/")


def _dir_files(d: str) -> list[str]:
    out = []
    for dirpath, dirnames, filenames in os.walk(d):
        dirnames[:] = sorted(x for x in dirnames if x != "__pycache__" and not x.startswith("."))
        for fn in sorted(filenames):
            if fn.lower().endswith(_DIR_EXTS):
                out.append(os.path.join(dirpath, fn))
    return sorted(out)


def _short(text: Any, n: int = 240) -> str:
    s = text if isinstance(text, str) else json.dumps(text, ensure_ascii=False, sort_keys=True)
    s = " ".join(s.split())
    return s if len(s) <= n else s[: n - 1].rstrip() + "…"


def _md_cell(text: Any, n: int = 240) -> str:
    return _short(text, n).replace("|", "\\|")


# ---------------------------------------------------------------------------------------------------------------------
# input resolution
# ---------------------------------------------------------------------------------------------------------------------
def resolve_inputs(root: str, overlays: list[str]) -> dict[str, dict]:
    """Look up every expected input at its repository-relative path: first in root, then (preview only) in each overlay.
    A directory input resolves from the first checkout that has at least one readable file in it; checkouts are never
    mixed within one input."""
    bases = [("repository", root)] + [(f"preview_overlay:{os.path.abspath(o)}", o) for o in overlays]
    out: dict[str, dict] = {}
    for spec in INPUTS:
        rec = {k: v for k, v in spec.items() if k not in ("arch_default",)}
        rec["state"] = "UNRESOLVED"
        rec["files"] = []
        for label, base in bases:
            p = os.path.join(base, spec["path"])
            if spec["kind"] == "file" and os.path.isfile(p):
                files = [p]
            elif spec["kind"] == "dir" and os.path.isdir(p):
                files = _dir_files(p)
            else:
                continue
            if not files:
                continue
            rec["state"] = "RESOLVED"
            rec["resolved_from"] = label
            rec["_base"] = base
            rec["files"] = [{"path": _rel(f, base), "sha256": sha256_file(f), "bytes": os.path.getsize(f),
                             "_abs": f} for f in files]
            break
        if rec["state"] == "UNRESOLVED":
            rec["unresolved_reason"] = (f"not present at {spec['path']} in this checkout"
                                        + (" or in any preview overlay" if overlays else "")
                                        + (f"; expected from {spec['pending_merge_from']}, pending merge"
                                           if spec.get("pending_merge_from") else ""))
        out[spec["id"]] = rec
    return out


def _load_json(file_rec: dict) -> Any:
    with open(file_rec["_abs"], encoding="utf-8") as f:
        return json.load(f)


def _single_json(inputs: dict, iid: str) -> Any | None:
    rec = inputs[iid]
    if rec["state"] != "RESOLVED":
        return None
    return _load_json(rec["files"][0])


