# hard gates
# ---------------------------------------------------------------------------------------------------------------------
def _run_evaluator(base: str, timeout: int = 60) -> tuple[str, str | None]:
    env = dict(os.environ, PYTHONDONTWRITEBYTECODE="1")
    env.pop("PYTHONPATH", None)
    try:
        cp = subprocess.run([sys.executable, "-B", "-m", "abep_sim.hard_gates", "status"], cwd=base, env=env,
                            capture_output=True, text=True, timeout=timeout)
    except (OSError, subprocess.TimeoutExpired) as e:
        return "ERROR", f"{type(e).__name__}: {e}"
    if cp.returncode != 0:
        return "ERROR", f"exit {cp.returncode}: {_short(cp.stderr, 400)}"
    return "OK", cp.stdout


def _check_elimination_consistency(status: dict) -> None:
    """An elimination claim must be backed by a FAIL verdict on a binding gate. Raise otherwise (never report an
    elimination the gate verdicts do not support, and never drop one silently)."""
    listed = set(status.get("eliminated", []))
    for arch in ARCHITECTURES:
        a = status["architectures"][arch]
        basis = a.get("elimination_basis", [])
        if bool(a["eliminated"]) != bool(basis):
            raise ValueError(f"hard-gate status: {arch} eliminated={a['eliminated']} but elimination_basis={basis}")
        if bool(a["eliminated"]) != (arch in listed):
            raise ValueError(f"hard-gate status: {arch} eliminated flag disagrees with the top-level eliminated list")
        for b in basis:
            g = a["gates"].get(b["gate"])
            if g is None or b["gate"] not in a["binding_gates"] or not g.get("binding") or g["verdict"] != "FAIL":
                raise ValueError(f"hard-gate status: {arch} elimination on {b['gate']} is not a FAIL on a binding gate")
            if not b.get("criteria"):
                raise ValueError(f"hard-gate status: {arch} elimination on {b['gate']} names no failing criterion")
    if set(status.get("eliminated", [])) | set(status.get("not_eliminated", [])) != set(ARCHITECTURES):
        raise ValueError("hard-gate status: eliminated + not_eliminated must cover hall_only, rf_hall and ecr_hall")


def hard_gate_section(inputs: dict, reevaluate: bool) -> dict:
    need = ("gates.matrix", "gates.register", "gates.status")
    missing = [i for i in need if inputs[i]["state"] != "RESOLVED"]
    sec: dict[str, Any] = {"state": "UNRESOLVED", "reasons": [], "evaluator_check": {"state": "NOT_RUN"},
                           "matrix_version": None, "matrix_status": None, "open_owner_decisions": [],
                           "admitted_members": None}
    if missing:
        sec["reasons"].append(f"hard-gate inputs unresolved: {missing}")
        return sec
    bases = {inputs[i]["_base"] for i in need}
    matrix = _single_json(inputs, "gates.matrix")
    status = _single_json(inputs, "gates.status")
    if matrix.get("schema") != HARD_GATE_MATRIX_SCHEMA:
        raise ValueError(f"{inputs['gates.matrix']['path']}: schema {matrix.get('schema')!r}, "
                         f"expected {HARD_GATE_MATRIX_SCHEMA!r}")
    if status.get("schema") != HARD_GATE_STATUS_SCHEMA:
        raise ValueError(f"{inputs['gates.status']['path']}: schema {status.get('schema')!r}, "
                         f"expected {HARD_GATE_STATUS_SCHEMA!r}")
    if set(status.get("architectures", {})) != set(ARCHITECTURES):
        raise ValueError("hard-gate status must cover exactly hall_only, rf_hall and ecr_hall")
    sec["matrix_version"] = status.get("matrix_version")
    sec["matrix_status"] = status.get("matrix_status")
    sec["admitted_members"] = status.get("admitted_members")
    sec["open_owner_decisions"] = [{"id": d.get("id"), "topic": d.get("topic")}
                                   for d in matrix.get("open_owner_decisions", [])]
    stale = []
    if len(bases) != 1:
        stale.append("matrix, register and status were resolved from different checkouts")
    prov = status.get("provenance", {})
    msha = inputs["gates.matrix"]["files"][0]["sha256"]
    rsha = inputs["gates.register"]["files"][0]["sha256"]
    if prov.get("matrix_sha256") != msha:
        stale.append(f"status provenance matrix_sha256 {prov.get('matrix_sha256')} != current matrix {msha}")
    if prov.get("register_sha256") != rsha:
        stale.append(f"status provenance register_sha256 {prov.get('register_sha256')} != current register {rsha}")
    if matrix.get("matrix_version") != status.get("matrix_version"):
        stale.append("status matrix_version differs from the matrix file")
    ev = inputs["gates.evaluator"]
    if not reevaluate:
        sec["evaluator_check"] = {"state": "NOT_RUN", "detail": "re-evaluation disabled (--no-reevaluate)"}
    elif ev["state"] != "RESOLVED":
        sec["evaluator_check"] = {"state": "NOT_RUN", "detail": "abep_sim/hard_gates.py unresolved; status file "
                                                                "checked by input hashes only"}
    elif ev["_base"] not in bases:
        sec["evaluator_check"] = {"state": "NOT_RUN", "detail": "evaluator resolved from a different checkout than "
                                                                "the status file"}
        stale.append("evaluator and status file come from different checkouts")
    else:
        ok, out = _run_evaluator(ev["_base"])
        with open(inputs["gates.status"]["files"][0]["_abs"], encoding="utf-8") as f:
            committed = f.read()
        if ok != "OK":
            sec["evaluator_check"] = {"state": "ERROR", "detail": out}
            stale.append("evaluator re-run failed")
        elif out != committed:
            sec["evaluator_check"] = {"state": "MISMATCH",
                                      "detail": "python -m abep_sim.hard_gates status differs from the committed "
                                                "status file"}
            stale.append("committed status file differs from a fresh evaluator run")
        else:
            sec["evaluator_check"] = {"state": "MATCH",
                                      "detail": "python -B -m abep_sim.hard_gates status reproduces the committed "
                                                "status file byte for byte"}
    if stale:
        sec["state"] = "STALE"
        sec["reasons"] = stale + ["verdicts from a stale status file are not used: every gate is reported "
                                  "UNDETERMINED and nothing is eliminated until the status file is regenerated "
                                  "(python -m abep_sim.hard_gates status --out "
                                  "docs/architecture_comparison/hard_gates/hard_gate_status_v1.json)"]
        return sec
    _check_elimination_consistency(status)
    sec["state"] = "RESOLVED"
    sec["_status"] = status
    return sec


def _arch_gate_block(sec: dict, arch: str) -> dict:
    if sec["state"] != "RESOLVED":
        return {"elimination_state": "NOT_EVALUABLE", "eliminated": False, "elimination_basis": [],
                "verdicts": [], "verdict_summary": "UNDETERMINED for every gate: " + "; ".join(sec["reasons"]),
                "conflicts": [], "proposed_gate_failures": []}
    a = sec["_status"]["architectures"][arch]
    verdicts = []
    for gid in list(a["binding_gates"]) + [g for g in a["proposed_gates"] if g not in a["binding_gates"]]:
        g = a["gates"][gid]
        crits = []
        for cid in sorted(g["criteria"]):
            c = g["criteria"][cid]
            crits.append({"criterion": cid, "verdict": c["verdict"], "status": c.get("status"),
                          "counts_toward_gate": c.get("counts_toward_gate"),
                          "counts_for_fail": c.get("counts_for_fail"),
                          "evidence_items": list(c.get("evidence_used", [])),
                          "missing_for_pass": list(c.get("missing_for_pass", [])),
                          "missing_for_fail": list(c.get("missing_for_fail", []))})
        verdicts.append({"gate": gid, "title": g.get("title"), "binding": g["binding"], "gate_status": g["status"],
                         "verdict": g["verdict"], "milestone": g.get("milestone"),
                         "evidence_items": list(g.get("evidence_used", [])), "reasons": list(g.get("reasons", [])),
                         "criteria": crits})
    return {"elimination_state": "ELIMINATED" if a["eliminated"] else "NOT_ELIMINATED",
            "eliminated": bool(a["eliminated"]), "elimination_basis": a["elimination_basis"],
            "verdicts": verdicts,
            "verdict_summary": ", ".join(f"{v['gate']} {v['verdict']}" for v in verdicts),
            "conflicts": a.get("conflicts", []), "proposed_gate_failures": a.get("proposed_gate_failures", [])}


