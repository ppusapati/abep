def _git(root: str, *args: str) -> str | None:
    try:
        cp = subprocess.run(["git", "-C", root, *args], capture_output=True, text=True, timeout=30)
    except (OSError, subprocess.TimeoutExpired):
        return None
    return cp.stdout.strip() if cp.returncode == 0 else None


def git_state(root: str) -> dict:
    head = _git(root, "rev-parse", "HEAD")
    if head is None:
        return {"commit": "UNAVAILABLE (not a git checkout or git missing)", "worktree_clean_excluding_dossier": None}
    st = _git(root, "status", "--porcelain", "--", ".", f":(exclude){OUT_REL}")
    return {"commit": head, "worktree_clean_excluding_dossier": (st == "") if st is not None else None}


