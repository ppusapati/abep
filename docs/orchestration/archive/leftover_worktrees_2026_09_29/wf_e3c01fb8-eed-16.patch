def parse_claude_gate_table(text: str) -> list[dict]:
    m = re.search(r"^## Gate status.*?$(.*?)^## ", text, flags=re.M | re.S)
    if not m:
        raise ValueError("CLAUDE.md: '## Gate status' section not found")
    rows = []
    for line in m.group(1).splitlines():
        line = line.strip()
        if not line.startswith("|") or re.match(r"^\|\s*-", line):
            continue
        cells = [c.strip() for c in line.strip("|").split("|")]
        if len(cells) < 2 or cells[0].lower() == "gate":
            continue
        rows.append({"gate": cells[0], "status": " | ".join(cells[1:])})
    if not rows:
        raise ValueError("CLAUDE.md: gate status table is empty")
    return rows


def physics_section(inputs: dict) -> dict:
    sec: dict[str, Any] = {"note": "Physics-validation track, read for status only. Nothing here is a performance "
                                   "source for any architecture; screening candidates never are."}
    cm = inputs["claude_md"]
    if cm["state"] == "RESOLVED":
        with open(cm["files"][0]["_abs"], encoding="utf-8") as f:
            text = f.read()
        sec["baseline_gates"] = parse_claude_gate_table(text)
        env = re.search(r"RFP envelope:\s*(.+?)\.\s*Python owns", text, flags=re.S)
        sec["rfp_envelope_as_recorded"] = " ".join(env.group(1).split()) if env else None
    else:
        sec["baseline_gates"] = None
        sec["rfp_envelope_as_recorded"] = None
    dec = _single_json(inputs, "p5n2.decision")
    if dec is not None:
        sec["p5_n2_v1"] = {"admission_mode": dec.get("admission_mode"), "candidates": dec.get("candidates"),
                           "promotable": dec.get("promotable"), "inconclusive": dec.get("inconclusive"),
                           "failed_validation": dec.get("failed_validation")}
    rel = _single_json(inputs, "p5n2.release")
    if rel is not None:
        checks = rel.get("link_checks", {})
        dsha = rel.get("decision", {}).get("sha256")
        cur = inputs["p5n2.decision"]["files"][0]["sha256"] if inputs["p5n2.decision"]["state"] == "RESOLVED" else None
        sec["validation_release"] = {
            "campaign": rel.get("campaign"), "mode": rel.get("mode"),
            "link_checks_all_true": bool(checks) and all(v is True for v in checks.values()),
            "admission_records": rel.get("admission_records"),
            "decision_sha256_in_release": dsha,
            "decision_file_matches_release": (dsha == cur) if cur else None}
    ens = _single_json(inputs, "transport_ensemble")
    if ens is not None:
        members = sorted(m.get("ensemble_member_id") for m in ens.get("members", []))
        sec["transport_ensemble"] = {
            "schema": ens.get("schema"), "admitted_members": members,
            "credible_set_empty": not members,
            "n_screening_candidates": len(ens.get("screening_candidates", [])),
            "screening_candidates_note": "screening candidates never produce design Hall maps and never enter the "
                                         "architecture comparison (CLAUDE.md)",
            "admission_rule_status": ens.get("admission_rule_status")}
    fr = inputs["forensics.p5_n2_v1"]
    if fr["state"] == "RESOLVED":
        items = []
        for fi in fr["files"]:
            if fi["path"].endswith(".json"):
                d = _load_json(fi)
                if isinstance(d, dict):
                    items.append({"file": fi["path"], "id": d.get("id"),
                                  "official_outcome_unchanged": d.get("official_outcome_unchanged"),
                                  "non_gating": d.get("non_gating", d.get("descriptive_non_gating"))})
        sec["forensics"] = {"state": "RESOLVED", "files": items,
                            "note": "non-gating; the v1 outcome stays INCONCLUSIVE and is never rewritten (CLAUDE.md)"}
    else:
        sec["forensics"] = {"state": "UNRESOLVED", "reason": fr["unresolved_reason"]}
    te = sec.get("transport_ensemble")
    sec["hall_closure_available"] = bool(te and not te["credible_set_empty"])
    return sec


