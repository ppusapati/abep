def _unresolved_for(inputs: dict, ms: str) -> list[str]:
    return [f"{i} ({r['path']})" for i, r in inputs.items() if r["state"] != "RESOLVED" and ms in r["needed_for"]
            and i != "owner_decision"]


def milestone_block(arch: str, gsec: dict, gblock: dict, ftsec: dict, phys: dict, inputs: dict) -> dict:
    ft = ftsec.get("per_architecture", {}).get(arch) if ftsec["state"] == "RESOLVED" else None
    closure_note = ("credible Hall-transport set is empty (CLAUDE.md gate 3 FAIL; P5-N2 v1 all INCONCLUSIVE / NOT "
                    "ELIGIBLE): Hall-dependent conditions can be discharged only by Vyovrinda or same-hardware "
                    "measurement") if not phys.get("hall_closure_available") else None
    if gsec["state"] != "RESOLVED":
        return {"reachable": "NONE_DETERMINABLE",
                "reason": "the hard-gate evaluation is " + gsec["state"] + ": " + "; ".join(gsec["reasons"]),
                "A": {"available": None, "gate_conditions": [],
                      "failure_tree_conditions": ft["milestone_A_conditions"] if ft else [],
                      "statement": None},
                "next": "A",
                "missing_for_next": [f"hard-gate evaluation: {r}" for r in gsec["reasons"]]
                                    + ([] if ft else [f"failure trees: {ftsec.get('reason')}"])
                                    + [f"unresolved input: {u}" for u in _unresolved_for(inputs, "A")]
                                    + ["owner record of a conditional selection (none recorded)"]}
    a = gsec["_status"]["architectures"][arch]
    mA, mB, mC = a["milestones"]["A"], a["milestones"]["B"], a["milestones"]["C"]
    open_B = (ft["open_by_resolve_milestone"].get("B", []) if ft else None)
    open_C = (ft["open_by_resolve_milestone"].get("C", []) if ft else None)
    A = {"available": bool(mA["conditional_selection_available"]),
         "statement": mA.get("statement"),
         "gate_conditions": [{"criterion": c["criterion"], "gate": c["gate"], "requirement": c["requirement"],
                              "current_verdict": c["current_verdict"], "can_eliminate": c["can_eliminate"],
                              "discharged_by_at_A": c.get("discharged_by", {}).get("A", []),
                              "blockers": c.get("blockers", [])} for c in mA["conditions"]],
         "failure_tree_conditions": ft["milestone_A_conditions"] if ft else [],
         "open_owner_items": [o["criterion"] for o in mA.get("open_owner_items", [])],
         "proposed_gates_pending": mA.get("proposed_gates_pending", [])}
    b_ready = bool(mB["ready"]) and ft is not None and not open_B
    c_ready = bool(mC["ready"]) and ft is not None and not open_B and not open_C
    if gblock["eliminated"]:
        reachable, nxt = "NONE_ELIMINATED", None
    elif c_ready:
        reachable, nxt = "C", None
    elif b_ready:
        reachable, nxt = "B", "C"
    elif A["available"]:
        reachable, nxt = "A", "B"
    else:
        reachable, nxt = "NONE_CONFLICT", "A"
    missing: list[str] = []
    if nxt == "B":
        missing += list(mB["missing"])
        if ft is None:
            missing.append(f"failure trees unresolved: {ftsec.get('reason')}")
        elif open_B:
            missing.append(f"{len(open_B)} open failure-tree node(s) to resolve by milestone B: {', '.join(open_B)}")
        if closure_note:
            missing.append(closure_note)
        missing += [f"unresolved input: {u}" for u in _unresolved_for(inputs, "B")]
    elif nxt == "C":
        missing += list(mC["missing"])
        if open_C:
            missing.append(f"{len(open_C)} open failure-tree node(s) to resolve by milestone C: {', '.join(open_C)}")
        missing += [f"unresolved input: {u}" for u in _unresolved_for(inputs, "C")]
    elif nxt == "A":
        missing += [f"binding-gate evidence conflict: {c}" for c in gblock["conflicts"]]
    return {"reachable": reachable,
            "reason": {"A": "not eliminated by any binding gate and no binding-gate conflict; a conditional selection "
                            "is available for the owner to record, subject to every condition listed",
                       "B": "every binding gate passes, the matrix is owner-approved and no B-node is open",
                       "C": "one integrated design passes every binding gate and no owner item or tree node is open",
                       "NONE_ELIMINATED": "eliminated by the hard-gate logic",
                       "NONE_CONFLICT": "sufficient evidence conflicts on a binding gate; the owner resolves it"}
                      [reachable],
            "A": A, "next": nxt, "missing_for_next": missing}


def owner_decision(inputs: dict, gsec: dict) -> dict:
    rec = _single_json(inputs, "owner_decision")
    not_elim = (list(gsec["_status"]["not_eliminated"]) if gsec["state"] == "RESOLVED" else None)
    out = {"statement": NOT_A_DECISION, "selection": None,
           "selection_rule": "A selection is presented only if (1) the hard-gate evaluation is RESOLVED and "
                             "eliminates all but one architecture, and (2) the owner decision record names that "
                             "architecture and the sha256 of the hard-gate status file it was made on.",
           "not_eliminated_by_gate_logic": not_elim,
           "owner_decision_record": None}
    if rec is None:
        out["owner_decision_record"] = {"state": "NONE_RECORDED"}
        return out
    missing = [k for k in OWNER_RECORD_KEYS if k not in rec]
    if missing or rec.get("schema") != OWNER_RECORD_SCHEMA:
        raise ValueError(f"{inputs['owner_decision']['path']}: malformed owner decision record (schema must be "
                         f"{OWNER_RECORD_SCHEMA!r}; missing keys {missing})")
    if rec["architecture"] not in ARCHITECTURES or rec["milestone"] not in MILESTONES:
        raise ValueError("owner decision record: unknown architecture or milestone")
    cur_sha = inputs["gates.status"]["files"][0]["sha256"] if inputs["gates.status"]["state"] == "RESOLVED" else None
    reasons = []
    if gsec["state"] != "RESOLVED":
        reasons.append(f"hard-gate evaluation is {gsec['state']}")
    elif len(not_elim) != 1:
        reasons.append(f"gate logic leaves {len(not_elim)} architectures not eliminated ({', '.join(not_elim)})")
    elif not_elim[0] != rec["architecture"]:
        reasons.append(f"owner record names {rec['architecture']}, gate logic leaves {not_elim[0]}")
    if rec["hard_gate_status_sha256"] != cur_sha:
        reasons.append("owner record was made on a different hard-gate status file")
    out["owner_decision_record"] = {"state": "RECORDED", "record": {k: rec[k] for k in OWNER_RECORD_KEYS},
                                    "presented_as_selection": not reasons, "not_presented_because": reasons}
    if not reasons:
        out["selection"] = {"architecture": rec["architecture"], "milestone": rec["milestone"],
                            "decided_by": rec["decided_by"], "date": rec["date"],
                            "basis": "owner decision record + hard-gate eliminations of every other architecture"}
        out["statement"] = ("Owner-recorded decision (see owner_decision_record); the dossier reproduces it and adds "
                            "no judgement of its own.")
    return out


