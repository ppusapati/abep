def normalize_class(raw: Any) -> str:
    if not isinstance(raw, str):
        return "unclassified"
    s = raw.strip().lower()
    for pat, cls in ((r"^(paper-)?reconstructed", "reconstructed"), (r"^measured", "measured"),
                     (r"^digiti[sz]ed", "digitized"), (r"^inferred", "inferred"), (r"^model-derived", "model-derived"),
                     (r"^assumed", "assumed"), (r"^tbd", "TBD")):
        if re.match(pat, s):
            return cls
    return "unclassified"


def _arch_context(d: dict) -> tuple[str, ...] | None:
    for k in ("architectures", "architecture", "applies_to"):
        v = d.get(k)
        vals = [v] if isinstance(v, str) else (v if isinstance(v, list) else [])
        ids = tuple(a for a in ARCHITECTURES if a in [x for x in vals if isinstance(x, str)])
        if ids:
            return ids
    return None


def _has_uncertainty(u: Any) -> bool:
    if u is None or u == "" or u == [] or u == {}:
        return False
    if isinstance(u, str) and re.match(r"^\s*(tbd|none|not (stated|given|reported))", u.strip().lower()):
        return False
    return True


def scan_quantities(doc: Any, input_id: str, file_path: str, default_arch: tuple[str, ...]) -> tuple[list, int]:
    """Collect every dict that carries an evidence class (evidence_class / quantity_type) AND a value-like key."""
    out: list[dict] = []
    excluded = 0

    def walk(o: Any, ptr: str, ctx: tuple[str, ...]):
        nonlocal excluded
        if isinstance(o, dict):
            c = _arch_context(o) or ctx
            raw = o.get("evidence_class", o.get("quantity_type"))
            vkey = next((k for k in _VALUE_KEYS if k in o), None)
            if raw is not None and vkey is not None and isinstance(raw, str):
                if SCREENING_MARK in json.dumps(o, ensure_ascii=False):
                    excluded += 1
                else:
                    label = next((str(o[k]) for k in _LABEL_KEYS if isinstance(o.get(k), (str, int, float))),
                                 ptr.rsplit("/", 1)[-1])
                    val = {k: o[k] for k in _VALUE_KEYS if k in o}
                    vtxt = json.dumps(val, ensure_ascii=False, sort_keys=True)
                    u = o.get("uncertainty")
                    utxt = json.dumps(u, ensure_ascii=False, sort_keys=True) if u is not None else None
                    arch = "common" if set(c) == set(ARCHITECTURES) else sorted(c)
                    out.append({"input": input_id, "file": file_path, "pointer": ptr or "/", "label": _short(label, 120),
                                "value": val if len(vtxt) <= 200 else "(structured; see pointer)",
                                "unit": o.get("unit") if isinstance(o.get("unit"), str) else None,
                                "uncertainty": (u if utxt is None or len(utxt) <= 300 else "(structured; see pointer)"),
                                "uncertainty_stated": _has_uncertainty(u),
                                "class_raw": _short(raw, 160), "class": normalize_class(raw),
                                "architectures": arch})
            for k in sorted(o):
                walk(o[k], f"{ptr}/{k}", c)
        elif isinstance(o, list):
            for i, x in enumerate(o):
                walk(x, f"{ptr}/{i}", ctx)

    walk(doc, "", default_arch)
    return out, excluded


def lane_summaries(inputs: dict) -> tuple[list[dict], list[dict], int]:
    summaries, records, excluded_total = [], [], 0
    defaults = {s["id"]: tuple(s.get("arch_default", ARCHITECTURES)) for s in INPUTS}
    for spec in INPUTS:
        rec = inputs[spec["id"]]
        if rec["state"] != "RESOLVED" or spec["group"] in ("physics", "owner"):
            continue
        docs = []
        for fi in rec["files"]:
            if not fi["path"].endswith(".json") or fi["path"].endswith(".schema.json"):
                continue
            try:
                d = _load_json(fi)
            except json.JSONDecodeError as e:
                raise ValueError(f"{fi['path']}: invalid JSON ({e})") from e
            if not isinstance(d, dict):
                continue
            if d.get("$schema"):          # JSON Schema documents are contracts, not data
                docs.append({"file": fi["path"], "kind": "json_schema", "title": d.get("title")})
                continue
            ms = d.get("milestones")
            supports = ms.get("supports") if isinstance(ms, dict) else (d.get("supports_milestones"))
            docs.append({"file": fi["path"], "kind": "data",
                         "id": d.get("id") or d.get("matrix_id") or d.get("grid_id") or d.get("reference_id"),
                         "schema": d.get("schema") if isinstance(d.get("schema"), str) else None,
                         "version": next((str(d[k]) for k in ("version", "schema_version", "matrix_version",
                                                              "protocol_version", "module_version") if k in d), None),
                         "status": d.get("status") if isinstance(d.get("status"), str) else None,
                         "milestones_supported": supports if isinstance(supports, list) else None})
            if spec["group"] in _QUANTITY_GROUPS and spec["id"] not in ("gates.status",):
                q, ex = scan_quantities(d, spec["id"], fi["path"], defaults[spec["id"]])
                records.extend(q)
                excluded_total += ex
        summaries.append({"input": spec["id"], "documents": docs})
    records.sort(key=lambda r: (r["input"], r["file"], r["pointer"]))
    return summaries, records, excluded_total


def census(records: list[dict], arch: str) -> dict:
    rows: dict[str, dict] = {}
    for r in records:
        scope = "common" if r["architectures"] == "common" else ("specific" if arch in r["architectures"] else None)
        if scope is None:
            continue
        key = f"{r['input']}|{scope}"
        row = rows.setdefault(key, {"input": r["input"], "scope": scope, **{c: 0 for c in _CLASS_ORDER},
                                    "total": 0, "uncertainty_stated": 0})
        row[r["class"]] += 1
        row["total"] += 1
        row["uncertainty_stated"] += int(r["uncertainty_stated"])
    table = [rows[k] for k in sorted(rows)]
    fam: dict[str, int] = {f: 0 for f in ("measured", "modelled", "assumed", "TBD", "unclassified")}
    for row in table:
        for c in _CLASS_ORDER:
            fam[_CLASS_FAMILY[c]] += row[c]
    return {"by_input": table, "by_family": fam, "total": sum(r["total"] for r in table),
            "uncertainty_stated": sum(r["uncertainty_stated"] for r in table)}


