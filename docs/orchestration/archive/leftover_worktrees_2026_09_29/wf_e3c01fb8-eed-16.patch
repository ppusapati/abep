NODE_ORDER_RULE = {
    "id": "dossier_node_order_v1",
    "status": "PROPOSED",
    "text": "Open, non-sub-cause failure-tree nodes of the architecture, ordered by: (1) evidence_status 'supported' "
            "(open literature shows the mechanism operates) before 'unknown' before 'contradicted'; (2) number of "
            "hard gates the node's decision quantity links, descending; (3) resolve_by_milestone B before C; "
            "(4) node id. A listing order for attention only: no weights, probabilities or scores, and it orders "
            "failure modes, never architectures.",
    "top_n": 5,
}
_EV_RANK = {"supported": 0, "unknown": 1, "contradicted": 2}
_MS_RANK = {"A": 0, "B": 1, "C": 2}


def failure_tree_section(inputs: dict) -> dict:
    ft = _single_json(inputs, "ftree.trees")
    if ft is None:
        return {"state": "UNRESOLVED", "reason": inputs["ftree.trees"]["unresolved_reason"]}
    if ft.get("schema") != FAILURE_TREE_SCHEMA:
        raise ValueError(f"{inputs['ftree.trees']['path']}: schema {ft.get('schema')!r}, "
                         f"expected {FAILURE_TREE_SCHEMA!r}")
    gate_map = {g["id"]: g.get("matrix_gate_id", g["id"]) for g in ft.get("hard_gates", [])}
    per: dict[str, Any] = {}
    for arch in ARCHITECTURES:
        nodes = [n for n in ft["nodes"] if arch in n["architectures"]]
        open_nodes = [n for n in nodes if n.get("decision_state") != "resolved_pass"]
        counted = [n for n in open_nodes if not n.get("sub_cause_of")]

        def key(n):
            gates = n.get("decision_quantity", {}).get("gates", [])
            return (_EV_RANK.get(n.get("evidence_status"), 3), -len(gates),
                    _MS_RANK.get(n.get("resolve_by_milestone"), 3), n["id"])

        ordered = sorted(counted, key=key)
        top = [{"id": n["id"], "title": n["title"], "evidence_status": n.get("evidence_status"),
                "decision_state": n.get("decision_state"),
                "hard_gates": [gate_map.get(g, g) for g in n.get("decision_quantity", {}).get("gates", [])],
                "resolve_by_milestone": n.get("resolve_by_milestone"),
                "threshold_status": n.get("decision_quantity", {}).get("threshold_status"),
                "cheapest_resolution": n.get("cheapest_resolution", []),
                "analysis_requires_admitted_hall_closure": n.get("analysis_requires_admitted_hall_closure"),
                "milestone_A_condition": n.get("milestone_A_condition")}
               for n in ordered[: NODE_ORDER_RULE["top_n"]]]
        by_status: dict[str, int] = {}
        for n in counted:
            by_status[n.get("evidence_status", "?")] = by_status.get(n.get("evidence_status", "?"), 0) + 1
        by_ms: dict[str, list[str]] = {}
        for n in counted:
            by_ms.setdefault(n.get("resolve_by_milestone", "?"), []).append(n["id"])
        ranked = ft.get("ranked_next_evidence", {}).get("per_architecture", {}).get(arch, {})
        per[arch] = {
            "n_nodes": len(nodes), "n_open": len(open_nodes), "n_open_counted": len(counted),
            "n_sub_causes_not_counted": len(open_nodes) - len(counted),
            "open_by_evidence_status": dict(sorted(by_status.items())),
            "open_by_resolve_milestone": {k: sorted(v) for k, v in sorted(by_ms.items())},
            "top_unresolved_nodes": top,
            "milestone_A_conditions": [{"node": n["id"], "condition": n.get("milestone_A_condition")}
                                       for n in sorted(counted, key=lambda n: n["id"])],
            "next_decisive_evidence": [
                {k: r.get(k) for k in ("rank", "action", "kind", "n_decides", "gates_decided", "nodes_decided",
                                       "nodes_contributed")}
                for r in ranked.get("ranked", [])[:3]],
            "blocked_actions": ranked.get("blocked", []),
        }
    actions = {a["id"]: {"title": a.get("title"), "lane": a.get("lane"), "deliverable": a.get("deliverable")}
               for a in ft.get("actions", [])}
    for arch in ARCHITECTURES:
        for r in per[arch]["next_decisive_evidence"]:
            r.update({"title": actions.get(r["action"], {}).get("title"),
                      "lane": actions.get(r["action"], {}).get("lane")})
    return {"state": "RESOLVED", "id": ft.get("id"), "version": ft.get("version"), "status": ft.get("status"),
            "ranking_rule_id": ft.get("ranking_rule", {}).get("id"),
            "failure_tree_eliminations": ft.get("eliminations", []),
            "failure_tree_eliminations_note": "reported only; eliminations in this dossier come from the hard-gate "
                                              "evaluator alone",
            "to_reach_B": ft.get("milestones", {}).get("to_reach_B", []),
            "to_reach_C": ft.get("milestones", {}).get("to_reach_C", []),
            "per_architecture": per}


