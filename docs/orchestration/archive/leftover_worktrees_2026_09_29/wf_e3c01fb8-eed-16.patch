# build
# ---------------------------------------------------------------------------------------------------------------------
def build(root: str = REPO_ROOT, overlays: list[str] | None = None, generated_at: str | None = None,
          reevaluate: bool = True) -> dict:
    overlays = list(overlays or [])
    root = os.path.abspath(root)
    inputs = resolve_inputs(root, overlays)
    gsec = hard_gate_section(inputs, reevaluate)
    ftsec = failure_tree_section(inputs)
    phys = physics_section(inputs)
    summaries, records, excluded = lane_summaries(inputs)
    arch_out = {}
    for arch in ARCHITECTURES:
        gb = _arch_gate_block(gsec, arch)
        arch_out[arch] = {
            "hard_gates": gb,
            "milestones": milestone_block(arch, gsec, gb, ftsec, phys, inputs),
            "quantities": census(records, arch),
            "failure_tree": (ftsec["per_architecture"][arch] if ftsec["state"] == "RESOLVED"
                             else {"state": "UNRESOLVED", "reason": ftsec["reason"]}),
        }
    decision = owner_decision(inputs, gsec)
    gsec_out = {k: v for k, v in gsec.items() if not k.startswith("_")}
    files_read = []
    for iid, rec in inputs.items():
        for fi in rec["files"]:
            files_read.append({"input": iid, "path": fi["path"], "sha256": fi["sha256"], "bytes": fi["bytes"],
                               "resolved_from": rec["resolved_from"]})
    input_status = [{k: v for k, v in rec.items() if k not in ("files", "_base")}
                    | {"n_files": len(rec["files"])} for rec in inputs.values()]
    unresolved = [r["id"] for r in input_status if r["state"] != "RESOLVED"]
    gen_path = os.path.join(root, SCRIPT_REL)
    dossier = {
        "schema": DOSSIER_SCHEMA,
        "generator_version": GENERATOR_VERSION,
        "kind": "STATUS_NOT_DECISION",
        "statement": decision["statement"],
        "architectures_order": list(ARCHITECTURES),
        "milestone_definitions": MILESTONES,
        "dossier_supports_milestones": {
            "supports": ["A"],
            "A": "status of every hard gate and failure-tree condition that a conditional selection must carry",
            "to_reach_B": "the same generator reports B when the evaluator's B.ready holds and no B failure-tree node "
                          "is open; it needs the unresolved inputs merged, an admitted Hall closure or hardware "
                          "measurements, and an owner-approved matrix",
            "to_reach_C": "reports C when an integrated design passes every binding gate and no owner item is open"},
        "mode": "preview" if overlays else "repository",
        "inputs": {"n_expected": len(INPUTS), "n_resolved": len(INPUTS) - len(unresolved),
                   "unresolved": unresolved, "status": input_status},
        "hard_gate_evaluation": gsec_out,
        "failure_trees": {k: v for k, v in ftsec.items() if k != "per_architecture"},
        "node_order_rule": NODE_ORDER_RULE,
        "physics_track": phys,
        "decision_status": decision,
        "architectures": arch_out,
        "lane_documents": summaries,
        "quantity_census_rule": {
            "status": "PROPOSED",
            "text": "A quantity is any JSON object in an architecture-comparison, evidence, contract or failure-tree "
                    "input that carries evidence_class (or quantity_type) and a value-like key "
                    f"({', '.join(_VALUE_KEYS)}). Its class is the leading docs/EVIDENCE.md term of that field "
                    "(anything else: unclassified). Families for reporting only: measured = measured + digitized + "
                    "reconstructed; modelled = inferred + model-derived; assumed. An object is architecture-specific "
                    "if it (or an enclosing object) names one or two architecture ids, or its input is "
                    "architecture-specific (rf_source: rf_hall; ecr_source: ecr_hall); otherwise it is common to all "
                    "three. 'uncertainty_stated' means a non-empty uncertainty field that does not start with TBD / "
                    "none / not stated. Objects that mention a screening candidate (sgb-screen-*) are excluded.",
            "excluded_screening_candidate_records": excluded,
            "n_records": len(records)},
        "quantity_records": records,
        "provenance": {
            "generated_at": generated_at or _dt.datetime.now(_dt.timezone.utc).replace(microsecond=0).isoformat(),
            "generated_by": f"python {SCRIPT_REL}" + (" (preview with overlays)" if overlays else ""),
            "generator_sha256": sha256_file(gen_path) if os.path.isfile(gen_path) else None,
            "git": git_state(root),
            "preview_overlays": [os.path.abspath(o) for o in overlays],
            "files_read": sorted(files_read, key=lambda x: (x["path"], x["input"])),
            "deterministic_except": ["provenance.generated_at", "provenance.git"]},
    }
    return dossier


# ---------------------------------------------------------------------------------------------------------------------
# Markdown rendering (pure function of the dossier dict)
# ---------------------------------------------------------------------------------------------------------------------
def render_markdown(d: dict) -> str:
    L: list[str] = []
    w = L.append
    prov = d["provenance"]
    w("# Architecture decision dossier (hall_only / rf_hall / ecr_hall)")
    w("")
    w(f"**{d['statement']}**")
    w("")
    w(f"Generated {prov['generated_at']} by `{prov['generated_by']}` at git commit `{prov['git']['commit']}` "
      f"(mode: {d['mode']}; schema `{d['schema']}`, generator {d['generator_version']}). Regenerate with "
      f"`python {SCRIPT_REL}`; `--check` reports whether this file is current.")
    w("")
    s = d["dossier_supports_milestones"]
    w(f"**Milestones supported:** {', '.join(s['supports'])}: {s['A']}. **To reach B:** {s['to_reach_B']}. "
      f"**To reach C:** {s['to_reach_C']}.")
    w("")
    w("## Decision status")
    ds = d["decision_status"]
    w(f"- Selection: **{'none' if ds['selection'] is None else ds['selection']['architecture'] + ' (owner-recorded)'}**. "
      f"{ds['selection_rule']}")
    ne = ds["not_eliminated_by_gate_logic"]
    if ne is None:
        w(f"- Not eliminated by the gate logic: not evaluable (hard-gate evaluation "
          f"{d['hard_gate_evaluation']['state']}), so no architecture is eliminated and none can be selected.")
    else:
        w(f"- Not eliminated by the gate logic: {', '.join(ne)}.")
    od = ds["owner_decision_record"]
    if od["state"] == "NONE_RECORDED":
        w("- Owner decision record: none recorded "
          f"(`{OUT_REL}/owner_decision_record.json`, schema `{OWNER_RECORD_SCHEMA}`, is written only by the owner).")
    else:
        w(f"- Owner decision record: recorded ({_md_cell(od['record'], 300)}); presented as a selection: "
          f"{od['presented_as_selection']}" + (f" — not presented because: {'; '.join(od['not_presented_because'])}"
                                               if od["not_presented_because"] else "") + ".")
    w("")
    w("| architecture | eliminated (gate logic) | milestone reachable now | next | hard-gate verdicts |")
    w("|---|---|---|---|---|")
    for arch in d["architectures_order"]:
        a = d["architectures"][arch]
        w(f"| {arch} | {a['hard_gates']['elimination_state']} | {a['milestones']['reachable']} | "
          f"{a['milestones']['next'] or '–'} | {_md_cell(a['hard_gates']['verdict_summary'], 400)} |")
    w("")
    w("Architectures are listed in fixed id order. No ranking, no score.")
    w("")
    # --- hard gate evaluation
    g = d["hard_gate_evaluation"]
    w("## Hard-gate evaluation")
    w(f"- State: **{g['state']}**; matrix version {g['matrix_version']} ({g['matrix_status']}); evaluator re-run: "
      f"{g['evaluator_check']['state']}" + (f" ({g['evaluator_check'].get('detail')})"
                                           if g['evaluator_check'].get('detail') else "") + ".")
    for r in g["reasons"]:
        w(f"- {r}")
    if g["open_owner_decisions"]:
        w("- Open owner decisions in the matrix: " + "; ".join(f"{o['id']} {o['topic']}" for o in
                                                               g["open_owner_decisions"]) + ".")
    w("")
    # --- physics track
    p = d["physics_track"]
    w("## Physics-validation track (status only)")
    w(p["note"])
    w("")
    if p.get("rfp_envelope_as_recorded"):
        w(f"RFP envelope as recorded in CLAUDE.md: {p['rfp_envelope_as_recorded']}.")
        w("")
    if p.get("baseline_gates"):
        w("| physics-baseline gate (CLAUDE.md) | status |")
        w("|---|---|")
        for r in p["baseline_gates"]:
            w(f"| {_md_cell(r['gate'], 80)} | {_md_cell(r['status'], 400)} |")
        w("")
    if p.get("p5_n2_v1"):
        v = p["p5_n2_v1"]
        w(f"- P5-N₂ v1 ({v['admission_mode']}): promotable {v['promotable']}; failed validation "
          f"{v['failed_validation']}; inconclusive {len(v['inconclusive'] or [])} of {len(v['candidates'] or {})} "
          "screening candidates.")
    if p.get("validation_release"):
        v = p["validation_release"]
        w(f"- Validation release {v['campaign']}: all link checks true = {v['link_checks_all_true']}; decision file "
          f"matches the release hash = {v['decision_file_matches_release']}; admission records {v['admission_records']}.")
    if p.get("transport_ensemble"):
        v = p["transport_ensemble"]
        w(f"- Transport ensemble: admitted members {v['admitted_members'] or '∅'} (credible set empty = "
          f"{v['credible_set_empty']}); {v['n_screening_candidates']} screening candidates "
          f"({v['screening_candidates_note']}).")
    f = p["forensics"]
    w(f"- P5-N₂ v1 forensics (`docs/forensics/p5_n2_v1/`): {f['state']}" +
      (f" — {len(f['files'])} JSON file(s); {f['note']}." if f["state"] == "RESOLVED" else f" ({f['reason']})."))
    w(f"- Admitted Hall closure available for absolute performance: **{p['hall_closure_available']}**.")
    w("")
    # --- per architecture
    for arch in d["architectures_order"]:
        a = d["architectures"][arch]
        hg, ms, q, ft = a["hard_gates"], a["milestones"], a["quantities"], a["failure_tree"]
        w(f"## {arch}")
        w(f"**Eliminated:** {hg['elimination_state']}. **Milestone reachable now:** {ms['reachable']} — "
          f"{ms['reason']}.")
        w("")
        w("### Hard-gate verdicts")
        if hg["verdicts"]:
            w("| gate | binding | verdict | evidence items | reasons |")
            w("|---|---|---|---|---|")
            for v in hg["verdicts"]:
                w(f"| {v['gate']} {_md_cell(v['title'] or '', 80)} | {'yes' if v['binding'] else 'no (' + v['gate_status'] + ')'} | "
                  f"{v['verdict']} | {', '.join(v['evidence_items']) or 'none'} | {_md_cell('; '.join(v['reasons']), 200)} |")
            if hg["elimination_basis"]:
                w("")
                w(f"Elimination basis: {_md_cell(hg['elimination_basis'], 600)}")
        else:
            w(f"{hg['verdict_summary']}")
        w("")
        w("### Milestone A (conditional selection)")
        A = ms["A"]
        if A.get("statement"):
            w(A["statement"])
            w("")
        if A["gate_conditions"]:
            w("Hard-gate conditions (each must be demonstrated; 'A:' lists the evidence bases that discharge it at "
              "milestone A):")
            w("")
            for i, c in enumerate(A["gate_conditions"], 1):
                w(f"{i}. `{c['criterion']}` — {c['requirement']} (now {c['current_verdict']}; can eliminate: "
                  f"{c['can_eliminate']}; A: {', '.join(c['discharged_by_at_A']) or 'none'})"
                  + (f". Blockers: {_md_cell('; '.join(c['blockers']), 400)}" if c["blockers"] else ""))
            w("")
        if A["failure_tree_conditions"]:
            w(f"Failure-tree conditions ({len(A['failure_tree_conditions'])} open, non-sub-cause nodes):")
            w("")
            for c in A["failure_tree_conditions"]:
                w(f"- `{c['node']}`: {c['condition']}")
            w("")
        if not A["gate_conditions"] and not A["failure_tree_conditions"]:
            w("No condition list can be formed: the hard-gate evaluation and the failure trees are not both resolved.")
            w("")
        w(f"### Missing for the next milestone ({ms['next'] or 'none'})")
        for m in ms["missing_for_next"] or ["nothing listed"]:
            w(f"- {m}")
        w("")
        w("### Measured / modelled / assumed quantities")
        fam = q["by_family"]
        if q["total"]:
            w(f"{q['total']} quantity record(s) apply to {arch} (architecture-specific or common); uncertainty stated "
              f"on {q['uncertainty_stated']}. Families: measured {fam['measured']}, modelled {fam['modelled']}, "
              f"assumed {fam['assumed']}, TBD {fam['TBD']}, unclassified {fam['unclassified']}. Records with values, "
              "units and uncertainties: `quantity_records` in dossier.json.")
            w("")
            w("| input | scope | measured | digitized | reconstructed | inferred | model-derived | assumed | TBD | "
              "unclassified | uncertainty stated / total |")
            w("|---|---|---|---|---|---|---|---|---|---|---|")
            for r in q["by_input"]:
                w(f"| {r['input']} | {r['scope']} | " + " | ".join(str(r[c]) for c in _CLASS_ORDER)
                  + f" | {r['uncertainty_stated']} / {r['total']} |")
        else:
            w("No quantity carrying an evidence class is available in the resolved inputs (the architecture-comparison "
              "and evidence inputs are unresolved). Nothing is filled in.")
        w("")
        w("### Top unresolved failure-tree nodes and next decisive evidence")
        if ft.get("state") == "UNRESOLVED":
            w(f"UNRESOLVED: {ft['reason']}.")
        else:
            w(f"{ft['n_open_counted']} open node(s) counted ({ft['n_sub_causes_not_counted']} sub-cause(s) not "
              f"counted); by evidence status {ft['open_by_evidence_status']}. Order: `{d['node_order_rule']['id']}` "
              "(PROPOSED; see dossier.json).")
            w("")
            w("| node | title | evidence status | hard gates | resolve by | cheapest resolution |")
            w("|---|---|---|---|---|---|")
            for n in ft["top_unresolved_nodes"]:
                w(f"| {n['id']} | {_md_cell(n['title'], 120)} | {n['evidence_status']} | {', '.join(n['hard_gates'])} "
                  f"| {n['resolve_by_milestone']} | {', '.join(n['cheapest_resolution'])} |")
            w("")
            w("Next decisive evidence (failure-tree ranking `decisiveness_lexicographic_v1`, top 3):")
            w("")
            for r in ft["next_decisive_evidence"]:
                w(f"{r['rank']}. `{r['action']}` ({r['kind']}; {r['title']}; lane {r['lane']}) — decides "
                  f"{r['n_decides']} node(s) {r['nodes_decided']}, gates {r['gates_decided']}")
            for b in ft["blocked_actions"]:
                w(f"- Blocked: `{b['action']}` — {'; '.join(b['blocked_by'])} (touches {', '.join(b['nodes_touched'])})")
        w("")
    # --- inputs
    inp = d["inputs"]
    w("## Inputs")
    w(f"{inp['n_resolved']} of {inp['n_expected']} expected inputs resolved. An UNRESOLVED input is listed, never "
      "filled in. 'needed for' is this dossier's PROPOSED mapping to milestones.")
    w("")
    w("| input | path | state | needed for | provides / reason |")
    w("|---|---|---|---|---|")
    for r in inp["status"]:
        note = r["provides"] if r["state"] == "RESOLVED" else r["unresolved_reason"]
        extra = f" [{r['path_status']}]" if r.get("path_status") else ""
        w(f"| {r['id']} | `{r['path']}`{extra} | {r['state']}"
          + (f" ({r['resolved_from']})" if r["state"] == "RESOLVED" and r["resolved_from"] != "repository" else "")
          + f" | {', '.join(r['needed_for'])} | {_md_cell(note, 220)} |")
    w("")
    if d["lane_documents"]:
        w("### Lane documents read")
        w("")
        w("| input | file | id / version | status | milestones supported |")
        w("|---|---|---|---|---|")
        for s_ in d["lane_documents"]:
            for doc in s_["documents"]:
                if doc["kind"] == "json_schema":
                    w(f"| {s_['input']} | `{doc['file']}` | JSON Schema: {_md_cell(doc.get('title') or '', 80)} | – | – |")
                else:
                    w(f"| {s_['input']} | `{doc['file']}` | {doc.get('id') or doc.get('schema') or '–'} / "
                      f"{doc.get('version') or '–'} | {_md_cell(doc.get('status') or '–', 160)} | "
                      f"{', '.join(doc['milestones_supported']) if doc.get('milestones_supported') else '–'} |")
        w("")
    # --- provenance
    w("## Provenance")
    w(f"- Generated at: {prov['generated_at']}")
    w(f"- Git commit: `{prov['git']['commit']}`; worktree clean (excluding `{OUT_REL}`): "
      f"{prov['git']['worktree_clean_excluding_dossier']}")
    w(f"- Generator: `{SCRIPT_REL}` sha256 `{prov['generator_sha256']}`")
    if prov["preview_overlays"]:
        w(f"- Preview overlays (read-only): {', '.join(prov['preview_overlays'])}")
    w(f"- Deterministic except: {', '.join(prov['deterministic_except'])}")
    w("")
    w("| file | input | sha256 | bytes |")
    w("|---|---|---|---|")
    for fr in prov["files_read"]:
        w(f"| `{fr['path']}` | {fr['input']} | `{fr['sha256']}` | {fr['bytes']} |")
    w("")
    return "\n".join(L)


# ---------------------------------------------------------------------------------------------------------------------
# CLI
# ---------------------------------------------------------------------------------------------------------------------
def dumps(d: dict) -> str:
    return json.dumps(d, indent=1, ensure_ascii=False, sort_keys=True) + "\n"


def strip_volatile(d: dict) -> dict:
    x = json.loads(json.dumps(d))
    for k in d["provenance"]["deterministic_except"]:
        _, key = k.split(".", 1)
        x["provenance"].pop(key, None)
    return x


def write(d: dict, out_dir: str) -> tuple[str, str]:
    os.makedirs(out_dir, exist_ok=True)
    jp, mp = os.path.join(out_dir, JSON_NAME), os.path.join(out_dir, MD_NAME)
    with open(jp, "w", encoding="utf-8") as f:
        f.write(dumps(d))
    with open(mp, "w", encoding="utf-8") as f:
        f.write(render_markdown(d))
    return jp, mp


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    ap.add_argument("--root", default=REPO_ROOT, help="repository checkout to read (default: this repository)")
    ap.add_argument("--out-dir", default=None, help=f"output directory (default: <root>/{OUT_REL})")
    ap.add_argument("--preview-overlay", action="append", default=[],
                    help="PREVIEW ONLY: another checkout to resolve missing inputs from (read-only); requires --out-dir "
                         "outside the repository")
    ap.add_argument("--generated-at", default=None, help="fixed ISO timestamp (tests)")
    ap.add_argument("--no-reevaluate", action="store_true", help="do not re-run the hard-gate evaluator")
    ap.add_argument("--check", action="store_true",
                    help="exit 1 if the committed dossier differs from a fresh build (ignoring generated_at and git)")
    a = ap.parse_args(argv)
    root = os.path.abspath(a.root)
    default_out = os.path.join(root, OUT_REL)
    out_dir = os.path.abspath(a.out_dir or default_out)
    if a.preview_overlay:
        if a.check:
            ap.error("--check compares against the committed dossier; it cannot use preview overlays")
        if os.path.commonpath([out_dir, root]) == root:
            ap.error("a preview (with --preview-overlay) must be written outside the repository (--out-dir)")
    d = build(root, a.preview_overlay, a.generated_at, reevaluate=not a.no_reevaluate)
    if a.check:
        jp = os.path.join(default_out, JSON_NAME)
        mp = os.path.join(default_out, MD_NAME)
        if not (os.path.isfile(jp) and os.path.isfile(mp)):
            print(f"STALE: committed dossier missing at {OUT_REL}")
            return 1
        with open(jp, encoding="utf-8") as f:
            committed = json.load(f)
        with open(mp, encoding="utf-8") as f:
            md = f.read()
        if strip_volatile(committed) != strip_volatile(d):
            print("STALE: dossier.json differs from a fresh build; regenerate with "
                  f"python {SCRIPT_REL}")
            return 1
        if md != render_markdown(committed):
            print(f"STALE: {MD_NAME} is not the rendering of dossier.json")
            return 1
        print("OK: committed dossier is current")
        return 0
    jp, mp = write(d, out_dir)
    sel = d["decision_status"]["selection"]
    print(f"wrote {jp}\nwrote {mp}")
    print(f"inputs resolved {d['inputs']['n_resolved']}/{d['inputs']['n_expected']}; hard gates "
          f"{d['hard_gate_evaluation']['state']}; selection: "
          + ("none (status, not a decision)" if sel is None else f"owner-recorded {sel['architecture']}"))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
