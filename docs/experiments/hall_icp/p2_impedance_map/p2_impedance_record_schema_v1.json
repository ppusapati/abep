{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "docs/experiments/hall_icp/p2_impedance_map/p2_impedance_record_schema_v1.json",
 "title": "P2 ICP impedance-map record (p2_impedance_record_v1)",
 "description": "Generated by docs/experiments/hall_icp/p2_impedance_map/build_p2_impedance_prep.py from the reducer's field tuples; complex values are [re, im]. Forbidden keys (any depth): names starting with P_plasma, P_absorbed_plasma, and any power-like key (P_/p_ prefix, 'power', 'pwr' or a watt suffix) containing 'plasma'. Nested required sub-fields mirror the reducer's NESTED_REQUIRED contract.",
 "type": "object",
 "required": [
  "schema",
  "record_id",
  "data_class",
  "phase",
  "calibration_set_id",
  "f_Hz",
  "Z0_ohm",
  "reference_planes",
  "methods",
  "loss_method",
  "coupler",
  "vi_probe",
  "match_state",
  "factors",
  "plasma_state",
  "sweep",
  "settling",
  "temperatures_K",
  "cold_reference_id",
  "p1_stable_region_ref",
  "antenna_current"
 ],
 "properties": {
  "schema": {
   "type": "string",
   "description": "constant 'p2_impedance_record_v1'",
   "x-units": "-",
   "x-reference-plane": null
  },
  "record_id": {
   "type": "string",
   "description": "unique id",
   "x-units": "-",
   "x-reference-plane": null
  },
  "data_class": {
   "type": "string",
   "description": "measured | synthetic_test (synthetic output is labelled SYNTHETIC_TEST_DATA_NOT_EVIDENCE)",
   "x-units": "-",
   "x-reference-plane": null
  },
  "phase": {
   "type": "string",
   "description": "DUMMY_LOAD | COLD_ANTENNA_POWERED_UNLIT | HOT_MAP",
   "x-units": "-",
   "x-reference-plane": null
  },
  "calibration_set_id": {
   "type": "string",
   "description": "id of the calibration set used (must be supplied to the reducer)",
   "x-units": "-",
   "x-reference-plane": null
  },
  "f_Hz": {
   "type": "number",
   "description": "drive frequency; must equal the calibration frequency",
   "x-units": "Hz",
   "x-reference-plane": null
  },
  "Z0_ohm": {
   "type": "number",
   "description": "reference impedance; must equal the calibration Z0",
   "x-units": "ohm",
   "x-reference-plane": null
  },
  "reference_planes": {
   "type": "object",
   "description": "keys coupler_powers (RP-CPL), coupler_reflection (RP-CPL, if complex reflection recorded), vi_probe (RP-VI); values in RP-GEN, RP-CPL, RP-MIN, RP-ANT, RP-VI",
   "x-units": "-",
   "x-reference-plane": "declares the plane of each measurement"
  },
  "methods": {
   "type": "array",
   "description": "subset of vi_probe, deembed",
   "x-units": "-",
   "x-reference-plane": null
  },
  "loss_method": {
   "type": "string",
   "description": "two_port | declared_bound | not_available",
   "x-units": "-",
   "x-reference-plane": null
  },
  "coupler": {
   "type": "object",
   "description": "P_sens_fwd_W, P_sens_ref_W (sensor readings, W), power_sensor_cal_id, reflection_raw ([re, im] raw reflection ratio or null)",
   "x-units": "W; [re, im]",
   "x-reference-plane": "RP-CPL",
   "required": [
    "P_sens_fwd_W",
    "P_sens_ref_W",
    "power_sensor_cal_id",
    "reflection_raw"
   ],
   "properties": {
    "P_sens_fwd_W": {
     "type": "number",
     "x-units": "W"
    },
    "P_sens_ref_W": {
     "type": "number",
     "x-units": "W"
    },
    "power_sensor_cal_id": {
     "type": "string"
    },
    "reflection_raw": {
     "type": [
      "array",
      "null"
     ],
     "items": {
      "type": "number"
     },
     "minItems": 2,
     "maxItems": 2,
     "description": "[re, im] or null"
    }
   }
  },
  "vi_probe": {
   "type": [
    "object",
    "null"
   ],
   "description": "V_raw, I_raw ([re, im]), vi_cal_id; null when not installed",
   "x-units": "V; A",
   "x-reference-plane": "RP-VI",
   "required": [
    "V_raw",
    "I_raw",
    "vi_cal_id"
   ],
   "properties": {
    "V_raw": {
     "type": "array",
     "items": {
      "type": "number"
     },
     "minItems": 2,
     "maxItems": 2,
     "description": "[re, im]",
     "x-units": "V (raw)"
    },
    "I_raw": {
     "type": "array",
     "items": {
      "type": "number"
     },
     "minItems": 2,
     "maxItems": 2,
     "description": "[re, im]",
     "x-units": "A (raw)"
    },
    "vi_cal_id": {
     "type": "string"
    }
   }
  },
  "match_state": {
   "type": "object",
   "description": "tuning_state_id, positions, auto_tune, loss_bound_id",
   "x-units": "-",
   "x-reference-plane": "RP-MIN -> RP-ANT",
   "required": [
    "tuning_state_id",
    "positions",
    "auto_tune",
    "loss_bound_id"
   ],
   "properties": {
    "tuning_state_id": {
     "type": [
      "string",
      "null"
     ]
    },
    "positions": {
     "type": "object"
    },
    "auto_tune": {
     "type": [
      "boolean",
      "null"
     ]
    },
    "loss_bound_id": {
     "type": [
      "string",
      "null"
     ]
    }
   }
  },
  "factors": {
   "type": "object",
   "description": "fields: P_RF_setpoint_W, mdot_hall_anode_mg_s, mdot_icp_dedicated_mg_s, gas_mode, gas, p_icp_source_Pa, p_chamber_Pa, hall_state, V_collector_V, I_collector_A, P_mains_in_W (explicit null where not applicable; P_mains_in_W is GROUND/FACILITY_ONLY)",
   "x-units": "W; mg/s; Pa; V; A",
   "x-reference-plane": null,
   "required": [
    "P_RF_setpoint_W",
    "mdot_hall_anode_mg_s",
    "mdot_icp_dedicated_mg_s",
    "gas_mode",
    "gas",
    "p_icp_source_Pa",
    "p_chamber_Pa",
    "hall_state",
    "V_collector_V",
    "I_collector_A",
    "P_mains_in_W"
   ],
   "properties": {
    "P_RF_setpoint_W": {
     "type": [
      "number",
      "null"
     ],
     "x-units": "W"
    },
    "mdot_hall_anode_mg_s": {
     "type": [
      "number",
      "null"
     ],
     "x-units": "mg/s"
    },
    "mdot_icp_dedicated_mg_s": {
     "type": [
      "number",
      "null"
     ],
     "x-units": "mg/s"
    },
    "gas_mode": {
     "type": [
      "string",
      "null"
     ]
    },
    "gas": {
     "type": [
      "string",
      "null"
     ],
     "description": "evidence tag derived by the reducer (Ar -> ENGINEERING_ONLY_NON_SCORING)"
    },
    "p_icp_source_Pa": {
     "type": [
      "number",
      "null"
     ],
     "x-units": "Pa"
    },
    "p_chamber_Pa": {
     "type": [
      "number",
      "null"
     ],
     "x-units": "Pa"
    },
    "hall_state": {
     "type": [
      "string",
      "object",
      "null"
     ]
    },
    "V_collector_V": {
     "type": [
      "number",
      "null"
     ],
     "x-units": "V"
    },
    "I_collector_A": {
     "type": [
      "number",
      "null"
     ],
     "x-units": "A"
    },
    "P_mains_in_W": {
     "type": [
      "number",
      "null"
     ],
     "x-units": "W",
     "description": "GROUND/FACILITY_ONLY; never P_bus"
    }
   }
  },
  "plasma_state": {
   "type": "object",
   "description": "lit, mode (UNLIT, E, H, UNCERTAIN), optical_signal_V",
   "x-units": "-; V",
   "x-reference-plane": null,
   "required": [
    "lit",
    "mode",
    "optical_signal_V"
   ],
   "properties": {
    "lit": {
     "type": [
      "boolean",
      "null"
     ]
    },
    "mode": {
     "enum": [
      "UNLIT",
      "E",
      "H",
      "UNCERTAIN"
     ]
    },
    "optical_signal_V": {
     "type": [
      "number",
      "null"
     ],
     "x-units": "V"
    }
   }
  },
  "sweep": {
   "type": "object",
   "description": "sweep_id, direction (up, down, reference, single), index",
   "x-units": "-",
   "x-reference-plane": null,
   "required": [
    "sweep_id",
    "direction",
    "index"
   ],
   "properties": {
    "sweep_id": {
     "type": "string"
    },
    "direction": {
     "enum": [
      "up",
      "down",
      "reference",
      "single"
     ]
    },
    "index": {
     "type": "integer"
    }
   }
  },
  "settling": {
   "type": "object",
   "description": "dwell_s, settled",
   "x-units": "s",
   "x-reference-plane": null,
   "required": [
    "dwell_s",
    "settled"
   ],
   "properties": {
    "dwell_s": {
     "type": [
      "number",
      "null"
     ],
     "x-units": "s"
    },
    "settled": {
     "type": [
      "boolean",
      "null"
     ]
    }
   }
  },
  "temperatures_K": {
   "type": "object",
   "description": "antenna, dielectric, collector, match, cables, probe",
   "x-units": "K",
   "x-reference-plane": null
  },
  "cold_reference_id": {
   "type": [
    "string",
    "null"
   ],
   "description": "id of the cold-antenna reference in the calibration set",
   "x-units": "-",
   "x-reference-plane": "RP-ANT"
  },
  "p1_stable_region_ref": {
   "type": [
    "string",
    "null"
   ],
   "description": "required non-PENDING reference for HOT_MAP records",
   "x-units": "-",
   "x-reference-plane": null
  },
  "antenna_current": {
   "type": [
    "object",
    "null"
   ],
   "description": "I_rms_A, probe_cal_id",
   "x-units": "A",
   "x-reference-plane": "RP-ANT",
   "required": [
    "I_rms_A",
    "probe_cal_id"
   ],
   "properties": {
    "I_rms_A": {
     "type": "number",
     "x-units": "A"
    },
    "probe_cal_id": {
     "type": "string"
    }
   }
  },
  "power_labels": {
   "type": "object",
   "description": "optional; any label naming plasma power is refused",
   "x-units": "-",
   "x-reference-plane": null
  },
  "engineering_control": {
   "type": [
    "string",
    "null"
   ],
   "enum": [
    "OQ-VI-05",
    null
   ],
   "description": "optional; 'OQ-VI-05' marks the A9.3 required engineering-control sequence (tag REQUIRED_ENGINEERING_CONTROL_NON_SCORING)",
   "x-units": "-",
   "x-reference-plane": null
  }
 },
 "$defs": {
  "calibration_set": {
   "type": "object",
   "required": [
    "schema",
    "calibration_set_id",
    "data_class",
    "f_Hz",
    "Z0_ohm",
    "power_sensors",
    "coupler",
    "two_ports",
    "vi_probe",
    "loss_bounds",
    "cold_references",
    "antenna_current_probe"
   ],
   "description": "schema 'p2_calibration_set_v1': power_sensors {id: {CF_fwd, CF_ref, certificate}}; coupler {cal_id, plane RP-CPL, phase_calibrated, e00, e11, e10e01}; two_ports {line (RP-CPL->RP-MIN), match_states {tuning_state_id: two-port RP-MIN->RP-ANT}} with S11, S12, S21, S22, cal_id, phase_calibrated; vi_probe {cal_id, phase_calibrated, k_V, k_I, fixture_abcd, fixture_from_plane RP-VI, fixture_to_plane RP-ANT, amplitude_convention}; loss_bounds {id: {loss_fraction_max, source, evidence_class}}; cold_references {id: {R_cold_ohm, source_record_id, evidence_class, antenna_temperature_K}}; antenna_current_probe {cal_id, k_mag, certificate} | null"
  }
 }
}
