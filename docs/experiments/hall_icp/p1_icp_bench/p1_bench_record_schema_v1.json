    "synthetic",
    "labels",
    "gas",
    "gas_mode",
    "hall_discharge_state",
    "ignition_procedure_id",
    "point_id",
    "rf",
    "flows",
    "pressures",
    "ignited",
    "ignition_delay_s",
    "extinguished",
    "optical",
    "h1_magnet_state",
    "start_state",
    "restart_condition_met"
   ],
   "properties": {
    "schema": {
