{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "docs/experiments/hall_icp/p1_icp_bench/p1_bench_record_schema_v1.json",
 "title": "P1 ICP bench raw record (p1_bench_record_v1)",
 "description": "Raw P1 bench records reduced by docs/experiments/hall_icp/p1_icp_bench/p1_reducer.py. Generated from the reducer constants by build_p1_icp_bench.py; the reducer enforces these rules and raises on violations (no silent defaults). Every record is ENGINEERING_ONLY_NON_SCORING; synthetic records must say synthetic = true.",
 "oneOf": [
  {
   "$ref": "#/$defs/p1_g0_readiness"
  },
  {
   "$ref": "#/$defs/rf_cold_checkout"
  },
  {
   "$ref": "#/$defs/ignition_attempt"
  },
  {
   "$ref": "#/$defs/icp_operating_point"
  },
  {
   "$ref": "#/$defs/stability_dwell"
  },
  {
   "$ref": "#/$defs/topology_control_sequence"
  }
 ],
 "$defs": {
  "p1_g0_readiness": {
   "type": "object",
   "required": [
    "schema",
    "record_kind",
    "record_id",
    "run_id",
    "stage_id",
    "timestamp_utc",
    "synthetic",
    "labels",
    "interlocks",
    "isolation_class",
    "dwv_tests",
    "gas_lines",
    "ar_mfcs",
    "ar_sweep_bounds_mg_s",
    "second_mfc_necessity",
    "generator_class",
    "registrations",
    "thermal_limits"
   ],
   "properties": {
    "schema": {
     "const": "p1_bench_record_v1"
    },
    "record_id": {
     "type": "string"
    },
    "run_id": {
     "type": "string"
    },
    "timestamp_utc": {
     "type": "string"
    },
    "synthetic": {
     "type": "boolean"
    },
    "labels": {
     "type": "array",
     "items": {
      "type": "string"
     },
     "contains": {
      "const": "ENGINEERING_ONLY_NON_SCORING"
     }
    },
    "record_kind": {
     "const": "p1_g0_readiness"
    },
    "stage_id": {
     "const": "P1-S0"
    },
    "interlocks": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "interlock_id",
       "functional_test_done",
       "functional",
       "log_id"
      ]
     }
    },
    "isolation_class": {
     "type": "object",
     "required": [
      "V_operating_max_V",
      "V_design_withstand_V"
     ]
    },
    "dwv_tests": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "object",
      "required": [
       "path_id",
       "applicable",
       "path_class"
      ],
      "properties": {
       "path_class": {
        "enum": [
         "ICP_BODY_COLLECTOR_350V_CLASS",
         "H1_ANODE_DISCHARGE_SUPPLY_350V_CLASS",
         "OTHER_REGISTERED_PATH"
        ]
       },
       "test_configuration": {
        "const": "ASSEMBLED_SYSTEM_IN_HOUSE"
       },
       "leakage_acceptance": {
        "anyOf": [
         {
          "type": "null"
         },
         {
          "type": "object",
          "required": [
           "criterion_id",
           "max_leakage_A",
           "basis_document_id",
           "u_measurement_A",
           "uncertainty_treatment",
           "registered_utc"
          ]
         }
        ]
       }
      },
      "x-required-when-applicable": [
       "V_test_V",
       "duration_s",
       "current_limited",
       "leakage_A",
       "breakdown_or_flashover",
       "tracking_or_disruptive_discharge",
       "protective_trip",
       "test_configuration",
       "configuration_id",
       "supplier_certificate",
       "test_utc"
      ]
     }
    },
    "thermal_limits": {
     "anyOf": [
      {
       "type": "null"
      },
      {
       "type": "array",
       "items": {
        "type": "object",
        "required": [
         "temperature_field",
         "component",
         "validated_continuous_limit_C",
         "basis"
        ],
        "properties": {
         "temperature_field": {
          "enum": [
           "T_icp_dielectric_C",
           "T_antenna_C",
           "T_collector_C",
           "T_match_C",
           "T_rf_source_C",
           "T_h1_pole_inner_C",
           "T_h1_pole_outer_C"
          ]
         }
        }
       }
      }
     ]
    },
    "gas_lines": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "object",
      "required": [
       "line_id",
       "bridges_isolated_potentials",
       "isolator_installed",
       "qualification"
      ],
      "properties": {
       "service_gas": {
        "type": [
         "string",
         "null"
        ],
        "description": "representative service gas; required (null = not registered) on a line that bridges isolated potentials"
       },
       "qualification": {
        "anyOf": [
         {
          "type": "null"
         },
         {
          "type": "object",
          "required": [
           "qualification_id",
           "level_id",
           "level_V",
           "V_test_V",
           "gas",
           "p_Pa",
           "breakdown_or_flashover"
          ],
          "properties": {
           "level_V": {
            "type": [
             "number",
             "null"
            ]
           },
           "V_test_V": {
            "type": "number"
           },
           "p_Pa": {
            "type": "number"
           },
           "gas": {
            "type": "string",
            "minLength": 1
           }
          }
         }
        ]
       }
      }
     }
    },
    "ar_mfcs": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "mfc_id",
       "range_min_mg_s",
       "range_max_mg_s"
      ]
     }
    },
    "ar_sweep_bounds_mg_s": {
     "anyOf": [
      {
       "type": "null"
      },
      {
       "type": "array",
       "minItems": 2,
       "maxItems": 2
      }
     ]
    },
    "second_mfc_necessity": {
     "type": [
      "string",
      "null"
     ]
    },
    "generator_class": {
     "enum": [
      "GROUND_FACILITY_ONLY_MAINS"
     ]
    },
    "registrations": {
     "type": "object",
     "properties": {
      "extraction_topology_id": {
       "type": [
        "string",
        "null"
       ]
      },
      "h1_electrical_config_id": {
       "type": [
        "string",
        "null"
       ]
      },
      "facility_match_rule_id": {
       "type": [
        "string",
        "null"
       ]
      },
      "closure_rule_id": {
       "type": [
        "string",
        "null"
       ]
      },
      "ignition_procedure_id": {
       "type": [
        "string",
        "null"
       ]
      },
      "time_base_id": {
       "type": [
        "string",
        "null"
       ]
      },
      "electron_collector_target_geometry_id": {
       "type": [
        "string",
        "null"
       ]
      },
      "ip_neu_interim_harness_drawing_id": {
       "type": [
        "string",
        "null"
       ]
      }
     }
    }
   },
   "x-owner-values": {
    "V_operating_max_V_max": 350.0,
    "V_design_withstand_V_min": 525.0,
    "dwv_V_test_V_min": 1050.0,
    "dwv_duration_s_min": 60.0,
    "required_interlocks": [
     "P1-SI-01",
     "P1-SI-02",
     "P1-SI-03",
     "P1-SI-04",
     "P1-SI-05",
     "P1-SI-06",
     "P1-SI-07",
     "P1-SI-08",
     "P1-SI-09",
     "P1-SI-10",
     "P1-SI-11"
    ],
    "source": "docs/decisions/OD_2026_09_30_A9_4_p1_p2_owner_decisions.json decisions.P1Q-14",
    "icpq06_class_V": 1000.0,
    "dwv_required_path_classes": [
     "ICP_BODY_COLLECTOR_350V_CLASS",
     "H1_ANODE_DISCHARGE_SUPPLY_350V_CLASS"
    ],
    "thermal_abort_margin_K": 50.0,
    "a9_16_source": "docs/decisions/OD_2026_10_01_A9_8_s1_p1_start_owner_decisions.json decisions.P1-IT-55 / OQ-RFQV2-06 / OQ-RFQV2-08; docs/decisions/OD_2026_10_01_A9_8_s1_p1_start_owner_decisions.json decisions.P1Q-04"
   }
  },
  "rf_cold_checkout": {
   "type": "object",
   "required": [
    "schema",
    "record_kind",
    "record_id",
    "run_id",
    "stage_id",
    "timestamp_utc",
    "synthetic",
    "labels",
    "checkout_kind",
    "rf",
    "generator",
    "loss_characterization",
    "rf_pickup_check"
   ],
   "properties": {
    "schema": {
     "const": "p1_bench_record_v1"
    },
    "record_id": {
     "type": "string"
    },
    "run_id": {
     "type": "string"
    },
    "timestamp_utc": {
     "type": "string"
    },
    "synthetic": {
     "type": "boolean"
    },
    "labels": {
     "type": "array",
     "items": {
      "type": "string"
     },
     "contains": {
      "const": "ENGINEERING_ONLY_NON_SCORING"
     }
    },
    "record_kind": {
     "const": "rf_cold_checkout"
    },
    "stage_id": {
     "enum": [
      "P1-S1",
      "P1-S2"
     ]
    },
    "checkout_kind": {
     "enum": [
      "DUMMY_LOAD",
      "INSTALLED_UNLIT_ANTENNA_VIA_LOCAL_MATCH"
     ]
    },
    "rf": {
     "type": "object",
     "required": [
      "reference_plane",
      "P_fwd_W",
      "P_refl_W",
      "match_setting_id"
     ],
     "properties": {
      "reference_plane": {
       "const": "GENERATOR_50OHM_SIDE_OF_LOCAL_MATCH"
      },
      "P_fwd_W": {
       "type": "number"
      },
      "P_refl_W": {
       "type": "number"
      },
      "match_setting_id": {
       "type": "string"
      }
     }
    },
    "calorimetric_cross_check": {
     "type": "object",
     "required": [
      "method_id",
      "P_cal_W",
      "u_P_cal_W",
      "u_P_coupler_W"
     ],
     "properties": {
      "P_cal_W": {
       "type": "number"
      },
      "u_P_cal_W": {
       "type": "number",
       "exclusiveMinimum": 0
      },
      "u_P_coupler_W": {
       "type": "number",
       "exclusiveMinimum": 0
      },
      "method_id": {
       "type": "string"
      }
     }
    },
    "loss_characterization": {
     "anyOf": [
      {
       "type": "null"
      },
      {
       "type": "object",
       "required": [
        "characterization_id",
        "method",
        "match_setting_id",
        "value_W",
        "u_value_W",
        "valid_max_gamma_abs"
       ],
       "properties": {
        "method": {
         "enum": [
          "TWO_PORT_S_PARAMETER"
         ]
        },
        "u_value_W": {
         "type": "number",
         "exclusiveMinimum": 0
        },
        "at_power_verification": {
         "anyOf": [
          {
           "type": "null"
          },
          {
           "type": "object",
           "required": [
            "verification_id",
            "method",
            "eta_pred",
            "u_eta_pred",
            "P_net_W",
            "u_P_net_W",
            "P_ref_load_W",
            "u_P_ref_load_W",
            "k",
            "k_registration_id",
            "evidence_record_ids",
            "tuning_states"
           ],
           "properties": {
            "method": {
             "enum": [
              "CAL-P2-09_calorimetric_at_power",
              "CAL-P2-10_antenna_simulator_at_power"
             ]
            },
            "k": {
             "type": [
              "number",
              "null"
             ]
            }
           }
          }
         ]
        }
       }
      }
     ]
    },
    "optical": {
     "type": "object",
     "required": [
      "photodiode_channel_id",
      "optical_signal_V",
      "photodiode_line_of_sight_ok",
      "photodiode_saturated",
      "electrical_ignition_or_mode_transition",
      "unlit_threshold"
     ],
     "description": "photodiode channel (P1-M-28; A9.4 P2Q-05): classified by p1_reducer.classify_plasma_state into UNLIT / E_MODE / H_MODE / UNCERTAIN; unlit_threshold null until registered (P1-IT-54) -> UNCERTAIN",
     "properties": {
      "photodiode_channel_id": {
       "type": "string",
       "minLength": 1
      },
      "optical_signal_V": {
       "type": "number"
      },
      "photodiode_line_of_sight_ok": {
       "type": "boolean"
      },
      "photodiode_saturated": {
       "type": "boolean"
      },
      "electrical_ignition_or_mode_transition": {
       "type": "boolean"
      },
      "electrical_indicator_basis": {
       "type": "string"
      },
      "unlit_threshold": {
       "anyOf": [
        {
         "type": "null"
        },
        {
         "type": "object",
         "required": [
          "threshold_id",
          "threshold_V",
          "basis"
         ],
         "properties": {
          "threshold_id": {
           "type": "string"
          },
          "threshold_V": {
           "type": "number"
          },
          "basis": {
           "type": "object",
           "required": [
            "dark_background_record_id",
            "rf_powered_known_unlit_record_id",
            "known_lit_p1_record_id",
            "frozen_before_p2_map"
           ],
           "properties": {
            "frozen_before_p2_map": {
             "const": true
            }
           },
           "description": "A9.4 P2Q-05 basis, identical to the P2 reducer (consolidated verification MET-05)"
          }
         }
        }
       ]
      },
      "lit_mode_assignment": {
       "enum": [
        "E_MODE",
        "H_MODE",
        null
       ]
      },
      "mode_indicator_basis": {
       "type": "string"
      }
     }
    },
    "gas_flow_state": {
     "enum": [
      "OFF",
      "FLOWING"
     ]
    },
    "unlit_procedure_id": {
     "type": "string"
    },
    "rf_pickup_check": {
     "enum": [
      "DONE",
      "NOT_DONE"
     ]
    }
   },
   "x-required-by-kind": {
    "DUMMY_LOAD": [
     "calorimetric_cross_check"
    ],
    "INSTALLED_UNLIT_ANTENNA_VIA_LOCAL_MATCH": [
     "optical",
     "gas_flow_state",
     "unlit_procedure_id"
    ]
   },
   "x-stage-by-kind": {
    "DUMMY_LOAD": "P1-S1",
    "INSTALLED_UNLIT_ANTENNA_VIA_LOCAL_MATCH": "P1-S2"
   },
   "x-k_x": 2.0
  },
