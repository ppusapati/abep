    },
    "record_id": {
     "type": "string"
    },
    "run_id": {
     "type": "string"
    },
    "timestamp_utc": {
     "type": "string"
    },
    "synthetic": {
     "type": "boolean"
    },
    "labels": {
     "type": "array",
     "items": {
      "type": "string"
     },
     "contains": {
      "const": "ENGINEERING_ONLY_NON_SCORING"
     }
    },
    "record_kind": {
     "const": "ignition_attempt"
    },
    "stage_id": {
     "const": "P1-S3"
    },
    "gas": {
     "enum": [
      "Ar"
     ]
    },
    "gas_mode": {
     "enum": [
      "G-REUSE",
      "DIAGNOSTIC_DEDICATED_FEED"
     ]
    },
    "hall_discharge_state": {
     "const": "OFF"
    },
    "rf": {
     "type": "object",
     "required": [
      "reference_plane",
      "P_fwd_W",
      "P_refl_W",
      "match_setting_id"
     ],
     "properties": {
      "reference_plane": {
       "const": "GENERATOR_50OHM_SIDE_OF_LOCAL_MATCH"
      },
      "P_fwd_W": {
       "type": "number"
      },
      "P_refl_W": {
       "type": "number"
      },
      "match_setting_id": {
       "type": "string"
      }
     }
    },
    "ignited": {
     "type": "boolean"
    },
    "ignition_delay_s": {
     "type": [
      "number",
      "null"
     ]
    },
    "extinguished": {
     "type": "boolean"
    },
    "optical": {
     "type": "object",
     "required": [
      "photodiode_channel_id",
      "optical_signal_V",
      "photodiode_line_of_sight_ok",
      "photodiode_saturated",
      "electrical_ignition_or_mode_transition",
      "unlit_threshold"
     ],
     "description": "photodiode channel (P1-M-28; A9.4 P2Q-05): classified by p1_reducer.classify_plasma_state into UNLIT / E_MODE / H_MODE / UNCERTAIN; unlit_threshold null until registered (P1-IT-54) -> UNCERTAIN",
     "properties": {
      "photodiode_channel_id": {
       "type": "string",
       "minLength": 1
      },
      "optical_signal_V": {
       "type": "number"
      },
      "photodiode_line_of_sight_ok": {
       "type": "boolean"
      },
      "photodiode_saturated": {
       "type": "boolean"
      },
      "electrical_ignition_or_mode_transition": {
       "type": "boolean"
      },
      "electrical_indicator_basis": {
       "type": "string"
      },
      "unlit_threshold": {
       "anyOf": [
        {
         "type": "null"
        },
        {
         "type": "object",
         "required": [
          "threshold_id",
          "threshold_V",
          "basis"
         ],
         "properties": {
          "threshold_id": {
           "type": "string"
          },
          "threshold_V": {
           "type": "number"
          },
          "basis": {
           "type": "object",
           "required": [
            "dark_background_record_id",
            "rf_powered_known_unlit_record_id",
            "known_lit_p1_record_id",
            "frozen_before_p2_map"
           ],
