    "restart_condition_met": {
     "type": "boolean"
    }
   }
  },
  "stability_dwell": {
   "type": "object",
   "required": [
    "schema",
    "record_kind",
    "record_id",
    "run_id",
    "stage_id",
    "timestamp_utc",
    "synthetic",
    "labels",
    "operating_point_record_id",
    "ignition_point_id",
    "dwell"
   ],
   "properties": {
    "schema": {
     "const": "p1_bench_record_v1"
    },
    "record_id": {
     "type": "string"
    },
    "run_id": {
     "type": "string"
    },
    "timestamp_utc": {
