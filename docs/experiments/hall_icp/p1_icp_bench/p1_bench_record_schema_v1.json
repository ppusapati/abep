{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "docs/experiments/hall_icp/p1_icp_bench/p1_bench_record_schema_v1.json",
 "title": "P1 ICP bench raw record (p1_bench_record_v1)",
 "description": "Raw P1 bench records reduced by docs/experiments/hall_icp/p1_icp_bench/p1_reducer.py. Generated from the reducer constants by build_p1_icp_bench.py; the reducer enforces these rules and raises on violations (no silent defaults). Every record is ENGINEERING_ONLY_NON_SCORING; synthetic records must say synthetic = true.",
 "oneOf": [
  {
   "$ref": "#/$defs/icp_operating_point"
  },
  {
   "$ref": "#/$defs/topology_control_sequence"
  }
 ],
 "$defs": {
  "icp_operating_point": {
   "type": "object",
   "required": [
    "schema",
    "record_kind",
    "record_id",
    "run_id",
    "stage_id",
    "timestamp_utc",
    "synthetic",
    "labels",
    "gas",
    "gas_mode",
    "hall_discharge_state",
    "rf",
    "generator",
    "collector",
    "extraction",
    "pressures",
    "flows",
    "impedance",
    "terminals",
    "temperatures",
    "rf_pickup_check"
   ],
   "properties": {
    "schema": {
     "const": "p1_bench_record_v1"
    },
    "record_kind": {
     "const": "icp_operating_point"
    },
    "record_id": {
     "type": "string"
    },
    "run_id": {
     "type": "string"
    },
    "stage_id": {
     "type": "string"
    },
    "timestamp_utc": {
     "type": "string"
    },
    "synthetic": {
     "type": "boolean"
    },
    "labels": {
     "type": "array",
     "items": {
      "type": "string"
     },
     "contains": {
      "const": "ENGINEERING_ONLY_NON_SCORING"
     }
    },
    "gas": {
     "enum": [
      "Ar"
     ]
    },
    "gas_mode": {
     "enum": [
      "G-REUSE",
      "DIAGNOSTIC_DEDICATED_FEED"
     ]
    },
    "hall_discharge_state": {
     "enum": [
      "OFF",
      "ON"
     ]
    },
    "rf": {
     "type": "object",
     "required": [
      "reference_plane",
      "P_fwd_W",
      "P_refl_W",
      "line_match_loss",
      "match_setting_id"
     ],
     "properties": {
      "reference_plane": {
       "const": "GENERATOR_50OHM_SIDE_OF_LOCAL_MATCH"
      },
      "P_fwd_W": {
       "type": "number"
      },
      "P_refl_W": {
       "type": "number"
      },
      "match_setting_id": {
       "type": "string"
      },
      "line_match_loss": {
       "type": "object",
       "required": [
        "status"
       ],
       "properties": {
        "status": {
         "enum": [
          "MEASURED",
          "FLAGGED_NOT_MEASURED"
         ]
        },
        "value_W": {
         "type": "number"
        },
        "source": {
         "type": "string"
        }
       }
      }
     }
    },
    "generator": {
     "type": "object",
     "required": [
      "generator_class",
      "P_generator_input_W",
      "input_boundary",
      "instrument"
     ],
     "propertyNames": {
      "not": {
       "pattern": "[Pp][^A-Za-z0-9]*[Bb][^A-Za-z0-9]*[Uu][^A-Za-z0-9]*[Ss]"
      }
     },
     "properties": {
      "generator_class": {
       "enum": [
        "GROUND_FACILITY_ONLY_MAINS"
       ]
      },
      "P_generator_input_W": {
       "type": "number"
      },
      "input_boundary": {
       "type": "string"
      },
      "instrument": {
       "type": "string"
      }
     }
    },
    "collector": {
     "type": "object",
     "required": [
      "I_e_A",
      "V_collector_V",
      "reference_potential"
     ],
     "description": "the ICP ion-collecting electrode (TK-13; ICD ICP-21); I_e is its supply-lead current; V_collector is its potential w.r.t. reference_potential",
     "properties": {
      "I_e_A": {
       "type": "number"
      },
      "V_collector_V": {
       "type": "number"
      },
      "reference_potential": {
       "enum": [
        "FACILITY_GROUND",
        "ICP_BODY",
        "ELECTRON_COLLECTOR_ELECTRODE"
       ]
      }
     }
    },
    "extraction": {
     "type": "object",
     "required": [
      "topology_id",
      "electron_collecting_electrode"
     ],
     "description": "electron-extraction topology registered at P1-G0 (P1-IT-36): the electrode that sinks the extracted electrons",
     "properties": {
      "topology_id": {
       "type": "string",
       "minLength": 1
      },
      "electron_collecting_electrode": {
       "enum": [
        "DEDICATED_ELECTRON_COLLECTOR_TARGET",
        "CHAMBER_WALL_FACILITY_GROUND",
        "H1_ANODE"
       ]
      }
     },
     "x-allowed-by-hall-state": {
      "OFF": [
       "DEDICATED_ELECTRON_COLLECTOR_TARGET",
       "CHAMBER_WALL_FACILITY_GROUND"
      ],
      "ON": [
       "H1_ANODE"
      ]
     }
    },
    "h1_point_id": {
     "type": "string",
     "minLength": 1,
     "description": "registered H-1 point id (required for ICP-45A candidacy, P1-S7)"
    },
    "pressures": {
     "type": "object",
     "required": [
      "p_chamber_Pa"
     ],
     "properties": {
      "p_chamber_Pa": {
       "type": "number"
      },
      "p_icp_Pa": {
       "type": "number"
      }
     }
    },
    "flows": {
     "type": "object",
     "required": [
      "mdot_Ar_H1_mg_s",
      "mdot_icp_dedicated_mg_s"
     ],
     "properties": {
      "mdot_Ar_H1_mg_s": {
       "type": "number"
      },
      "mdot_icp_dedicated_mg_s": {
       "type": "number"
      },
      "ledger_booking_id": {
       "type": "string"
      }
     }
    },
    "impedance": {
     "type": "object",
     "required": [
      "status"
     ],
     "properties": {
      "status": {
       "enum": [
        "MEASURED",
        "NOT_MEASURED_PENDING_P2_CHAIN"
       ]
      },
      "R_ohm": {
       "type": "number"
      },
      "X_ohm": {
       "type": "number"
      }
     }
    },
    "terminals": {
     "type": "object",
     "additionalProperties": {
      "type": "object",
      "required": [
       "I_A",
       "basis"
      ],
      "properties": {
       "I_A": {
        "type": "number"
       },
       "basis": {
        "enum": [
         "MEASURED",
         "OPEN_CIRCUIT_BY_CONSTRUCTION"
        ]
       }
      }
     },
     "x-required-by-hall-state-and-electrode": {
      "OFF/DEDICATED_ELECTRON_COLLECTOR_TARGET": [
       "collector_supply",
       "icp_body",
       "facility_ground",
       "electron_collector"
      ],
      "OFF/CHAMBER_WALL_FACILITY_GROUND": [
       "collector_supply",
       "icp_body",
       "facility_ground"
      ],
      "ON/H1_ANODE": [
       "collector_supply",
       "icp_body",
       "facility_ground",
       "hall_anode"
      ]
     }
    },
    "temperatures": {
     "type": "object",
     "required": [
      "T_icp_dielectric_C",
      "T_antenna_C",
      "T_collector_C",
      "T_match_C",
      "T_rf_source_C",
      "T_h1_pole_inner_C",
      "T_h1_pole_outer_C",
      "T_sink_C"
     ],
     "additionalProperties": {
      "type": "number"
     }
    },
    "rf_pickup_check": {
     "enum": [
      "DONE",
      "NOT_DONE"
     ]
    }
   },
   "propertyNames": {
    "not": {
     "pattern": "[Pp][^A-Za-z0-9]*[Bb][^A-Za-z0-9]*[Uu][^A-Za-z0-9]*[Ss]"
    }
   },
   "x-p-bus-screen": "the reducer refuses, at any nesting depth, every field name that normalises (lower-case, alphanumerics only) to contain 'pbus' (A9.3 OQ-RFQ-06)"
  },
  "topology_control_sequence": {
   "type": "object",
   "required": [
    "schema",
    "record_kind",
    "record_id",
    "run_id",
    "stage_id",
    "synthetic",
    "labels",
    "gas",
    "classification",
    "c1_disconnected",
    "hall_start_registration_id",
    "steps"
   ],
   "properties": {
    "schema": {
     "const": "p1_bench_record_v1"
    },
    "record_kind": {
     "const": "topology_control_sequence"
    },
    "gas": {
     "enum": [
      "Ar"
     ]
    },
    "classification": {
     "const": "REQUIRED_ENGINEERING_CONTROL_NON_SCORING"
    },
    "c1_disconnected": {
     "const": true
    },
    "hall_start_registration_id": {
     "type": "string",
     "minLength": 1
    },
    "labels": {
     "type": "array",
     "contains": {
      "const": "ENGINEERING_ONLY_NON_SCORING"
     }
    },
    "steps": {
     "type": "array",
     "minItems": 7,
     "maxItems": 7,
     "items": {
      "type": "object",
      "required": [
       "step",
       "text",
       "signals"
      ],
      "properties": {
       "step": {
        "type": "integer"
       },
       "text": {
        "type": "string"
       },
       "sustained_discharge_observed": {
        "type": "boolean"
       },
       "sustainment_definition_id": {
        "type": "string"
       },
       "signals": {
        "type": "object",
        "required": [
         "t_s",
         "V_d_V",
         "I_d_A",
         "I_e_icp_A",
         "P_rf_fwd_W",
         "P_rf_refl_W",
         "V_collector_V",
         "V_reference_V"
        ]
       }
      }
     }
    },
    "x-step-texts-verbatim": [
     {
      "step": 1,
      "text": "H-1 gas/magnet conditions established."
     },
     {
      "step": 2,
      "text": "C1 disconnected/not supplying electrons."
     },
     {
      "step": 3,
      "text": "ICP RF OFF."
     },
     {
      "step": 4,
      "text": "Apply the preregistered Hall start attempt inside registered limits."
     },
     {
      "step": 5,
      "text": "Record whether a sustained Hall discharge exists."
     },
     {
      "step": 6,
      "text": "Turn ICP ON using the registered procedure."
     },
     {
      "step": 7,
      "text": "Observe whether Hall discharge becomes sustainable."
     }
    ]
   }
  }
 }
}
