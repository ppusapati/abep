  "icp_operating_point": {
   "type": "object",
   "required": [
    "schema",
    "record_kind",
    "record_id",
    "run_id",
    "stage_id",
    "timestamp_utc",
    "synthetic",
    "labels",
    "gas",
    "gas_mode",
    "record_class",
    "hall_discharge_state",
    "hall_discharge_sustained",
    "h1_electrical",
    "rf",
    "generator",
    "collector",
    "extraction",
    "pressures",
    "flows",
    "impedance",
    "terminals",
    "temperatures",
    "rf_pickup_check",
    "h1_magnet_state"
   ],
