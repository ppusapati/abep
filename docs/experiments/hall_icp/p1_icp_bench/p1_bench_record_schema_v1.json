{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "docs/experiments/hall_icp/p1_icp_bench/p1_bench_record_schema_v1.json",
 "title": "P1 ICP bench raw record (p1_bench_record_v1)",
 "description": "Raw P1 bench records reduced by docs/experiments/hall_icp/p1_icp_bench/p1_reducer.py. Generated from the reducer constants by build_p1_icp_bench.py; the reducer enforces these rules and raises on violations (no silent defaults). Every record is ENGINEERING_ONLY_NON_SCORING; synthetic records must say synthetic = true.",
 "oneOf": [
  {
   "$ref": "#/$defs/icp_operating_point"
  },
  {
   "$ref": "#/$defs/topology_control_sequence"
  }
 ],
 "$defs": {
  "icp_operating_point": {
   "type": "object",
   "required": [
    "schema",
    "record_kind",
    "record_id",
    "run_id",
    "stage_id",
    "timestamp_utc",
    "synthetic",
    "labels",
    "gas",
    "gas_mode",
    "record_class",
    "hall_discharge_state",
    "hall_discharge_sustained",
    "h1_electrical",
    "rf",
    "generator",
    "collector",
    "extraction",
    "pressures",
    "flows",
    "impedance",
    "terminals",
    "temperatures",
    "rf_pickup_check"
   ],
   "properties": {
    "schema": {
     "const": "p1_bench_record_v1"
    },
    "record_kind": {
     "const": "icp_operating_point"
    },
    "record_id": {
     "type": "string"
    },
    "run_id": {
     "type": "string"
    },
    "stage_id": {
     "type": "string"
    },
    "timestamp_utc": {
     "type": "string"
    },
    "synthetic": {
     "type": "boolean"
    },
    "labels": {
     "type": "array",
     "items": {
      "type": "string"
     },
     "contains": {
      "const": "ENGINEERING_ONLY_NON_SCORING"
     }
    },
    "gas": {
     "enum": [
      "Ar"
     ]
    },
    "gas_mode": {
     "enum": [
      "G-REUSE",
      "DIAGNOSTIC_DEDICATED_FEED"
     ]
    },
    "record_class": {
     "enum": [
      "ICP45_CAPACITY",
      "NEUTRALIZATION_CONSISTENCY",
      "DIAGNOSTIC_VARIANT",
      "ENGINEERING_SURFACE"
     ],
     "description": "A9.4 P1Q-10 / P1Q-13: only ICP45_CAPACITY records feed I_e,cap; Hall-ON records are NEUTRALIZATION_CONSISTENCY; METERED_RETURN anode only in a DIAGNOSTIC_VARIANT",
     "x-allowed-by-hall-state": {
      "OFF": [
       "ICP45_CAPACITY",
       "DIAGNOSTIC_VARIANT",
       "ENGINEERING_SURFACE"
      ],
      "ON": [
       "NEUTRALIZATION_CONSISTENCY",
       "DIAGNOSTIC_VARIANT"
      ]
     }
    },
    "diagnostic_registration_id": {
     "type": "string",
     "minLength": 1,
     "description": "required when record_class is DIAGNOSTIC_VARIANT"
    },
    "capacity_monitoring": {
     "type": "object",
     "required": [
      "h1_body_ground_config",
      "I_body_to_ground_continuous",
      "V_anode_channel",
      "V_icp_body_V",
      "V_electron_collector_V",
      "sign_convention_id",
      "unintended_ground_path_found",
      "ground_path_check_id"
     ],
     "description": "required on every ICP45_CAPACITY record (A9.4 P1Q-13); the terminals must then include h1_body and electron_collector (MEASURED)",
     "properties": {
      "h1_body_ground_config": {
       "const": "SINGLE_POINT_METERED_FACILITY_GROUND"
      },
      "I_body_to_ground_continuous": {
       "const": true
      },
      "V_anode_channel": {
       "const": "HIGH_IMPEDANCE_ISOLATED"
      },
      "V_icp_body_V": {
       "type": "number"
      },
      "V_electron_collector_V": {
       "type": "number"
      },
      "sign_convention_id": {
       "type": "string",
       "minLength": 1
      },
      "unintended_ground_path_found": {
       "type": "boolean"
      },
      "ground_path_check_id": {
       "type": "string",
       "minLength": 1
      }
     }
    },
    "hall_discharge_state": {
     "enum": [
      "OFF",
      "ON"
     ],
     "description": "discharge-supply OUTPUT state (P1-IT-40): ON = V_d applied; OFF = output disabled and anode disconnected"
    },
    "hall_discharge_sustained": {
     "type": "boolean",
     "description": "sustained discharge per the registered definition (P1-IT-32); must be false when the supply is OFF"
    },
    "h1_electrical": {
     "type": "object",
     "required": [
      "config_id",
      "anode_state",
      "V_anode_V",
      "h1_body_state",
      "discharge_supply_connection"
     ],
     "description": "registered H-1 electrical configuration (P1-IT-39)",
     "properties": {
      "config_id": {
       "type": "string",
       "minLength": 1
      },
      "anode_state": {
       "enum": [
        "DISCONNECTED_FLOATING",
        "METERED_RETURN",
        "CONNECTED_TO_DISCHARGE_SUPPLY"
       ]
      },
      "V_anode_V": {
       "type": "number"
      },
      "h1_body_state": {
       "type": "string",
       "minLength": 1
      },
      "discharge_supply_connection": {
       "enum": [
        "PHYSICALLY_DISCONNECTED",
        "CONNECTED"
       ]
      }
     },
     "x-supply-connection-by-hall-state": {
      "OFF": "PHYSICALLY_DISCONNECTED",
      "ON": "CONNECTED"
     },
     "x-anode-states-by-hall-state": {
      "OFF": [
       "DISCONNECTED_FLOATING",
       "METERED_RETURN"
      ],
      "ON": [
       "CONNECTED_TO_DISCHARGE_SUPPLY"
      ]
     },
     "x-hall-anode-terminal-basis-by-anode-state": {
      "DISCONNECTED_FLOATING": "OPEN_CIRCUIT_BY_CONSTRUCTION",
      "METERED_RETURN": "MEASURED",
      "CONNECTED_TO_DISCHARGE_SUPPLY": "MEASURED"
     }
    },
    "rf": {
     "type": "object",
     "required": [
      "reference_plane",
      "P_fwd_W",
      "P_refl_W",
      "line_match_loss",
      "match_setting_id"
     ],
     "properties": {
      "reference_plane": {
       "const": "GENERATOR_50OHM_SIDE_OF_LOCAL_MATCH"
      },
      "P_fwd_W": {
       "type": "number"
      },
      "P_refl_W": {
       "type": "number"
      },
      "match_setting_id": {
       "type": "string"
      },
      "line_match_loss": {
       "type": "object",
       "required": [
        "status"
       ],
       "properties": {
        "status": {
         "enum": [
          "MEASURED",
          "FLAGGED_NOT_MEASURED"
         ]
        },
        "value_W": {
         "type": "number"
        },
        "source": {
         "type": "string"
        },
        "match_setting_id": {
         "type": "string"
        },
        "valid_max_gamma_abs": {
         "type": "number"
        }
       },
       "x-required-when-measured": [
        "value_W",
        "source",
        "match_setting_id",
        "valid_max_gamma_abs"
       ]
      }
     }
    },
    "generator": {
     "type": "object",
     "required": [
      "generator_class",
      "P_generator_input_W",
      "input_boundary",
      "instrument"
     ],
     "propertyNames": {
      "not": {
       "pattern": "[Bb][^A-Za-z0-9]*[Uu][^A-Za-z0-9]*[Ss]"
      }
     },
     "properties": {
      "generator_class": {
       "enum": [
        "GROUND_FACILITY_ONLY_MAINS"
       ]
      },
      "P_generator_input_W": {
       "type": "number"
      },
      "input_boundary": {
       "type": "string",
       "not": {
        "pattern": "[Bb][^A-Za-z0-9]*[Uu][^A-Za-z0-9]*[Ss]"
       }
      },
      "instrument": {
       "type": "string"
      }
     }
    },
    "collector": {
     "type": "object",
     "required": [
      "I_e_A",
      "I_e_sign_convention",
      "I_e_resolution_A",
      "V_collector_V",
      "reference_potential"
     ],
     "description": "the ICP ion-collecting electrode (TK-13; ICD ICP-21); I_e is its supply-lead current (I_e > 0 = electrons extracted from the ICP; equals terminals.collector_supply.I_A within I_e_resolution_A); V_collector is its potential w.r.t. reference_potential",
     "properties": {
      "I_e_A": {
       "type": "number"
      },
      "I_e_sign_convention": {
       "const": "POSITIVE_ELECTRONS_EXTRACTED_FROM_ICP_EQUALS_COLLECTOR_SUPPLY_TERMINAL_INTO_NETWORK"
      },
      "I_e_resolution_A": {
       "type": "number",
       "exclusiveMinimum": 0
      },
      "V_collector_V": {
       "type": "number"
      },
      "reference_potential": {
       "enum": [
        "FACILITY_GROUND",
        "ICP_BODY",
        "ELECTRON_COLLECTOR_ELECTRODE"
       ]
      }
     }
    },
    "extraction": {
     "type": "object",
     "required": [
      "topology_id",
      "electron_collecting_electrode"
     ],
     "description": "electron-extraction topology registered at P1-G0 (P1-IT-36): the electrode that sinks the extracted electrons",
     "properties": {
      "topology_id": {
       "type": "string",
       "minLength": 1
      },
      "electron_collecting_electrode": {
       "enum": [
        "DEDICATED_ELECTRON_COLLECTOR_TARGET",
        "CHAMBER_WALL_FACILITY_GROUND",
        "H1_ANODE"
       ]
      }
     },
     "x-allowed-by-hall-state": {
      "OFF": [
       "DEDICATED_ELECTRON_COLLECTOR_TARGET",
       "CHAMBER_WALL_FACILITY_GROUND"
      ],
      "ON": [
       "H1_ANODE"
      ]
     }
    },
    "h1_point_id": {
     "type": "string",
     "minLength": 1,
     "description": "registered H-1 point id (gas/magnet conditions; required for ICP-45A capacity candidacy, P1-IT-38)"
    },
    "pressures": {
     "type": "object",
     "required": [
      "p_chamber_Pa"
     ],
     "properties": {
      "p_chamber_Pa": {
       "type": "number"
      },
      "p_icp_Pa": {
       "type": "number"
      }
     }
    },
    "flows": {
     "type": "object",
     "required": [
      "mdot_Ar_H1_mg_s",
      "mdot_icp_dedicated_mg_s"
     ],
     "properties": {
      "mdot_Ar_H1_mg_s": {
       "type": "number"
      },
      "mdot_icp_dedicated_mg_s": {
       "type": "number"
      },
      "ledger_booking_id": {
       "type": "string"
      }
     }
    },
    "impedance": {
     "type": "object",
     "required": [
      "status"
     ],
     "properties": {
      "status": {
       "enum": [
        "MEASURED",
        "NOT_MEASURED_PENDING_P2_CHAIN"
       ]
      },
      "R_ohm": {
       "type": "number"
      },
      "X_ohm": {
       "type": "number"
      }
     }
    },
    "terminals": {
     "type": "object",
     "additionalProperties": {
      "type": "object",
      "required": [
       "basis"
      ],
      "description": "signed terminal current, conventional current INTO the isolated network positive (A9.5 P1Q-15); NOT_MEASURED = unavailable, carries no I_A (never a silent zero)",
      "properties": {
       "I_A": {
        "type": [
         "number",
         "null"
        ]
       },
       "basis": {
        "enum": [
         "MEASURED",
         "OPEN_CIRCUIT_BY_CONSTRUCTION",
         "NOT_MEASURED"
        ]
       },
       "sign_convention_id": {
        "type": "string",
        "minLength": 1
       },
       "uncertainty": {
        "type": "object",
        "required": [
         "u_calibration_A",
         "u_zero_offset_A",
         "u_resolution_A",
         "u_repeatability_A",
         "u_rf_pickup_A"
        ],
        "description": "u(I_k) components of a MEASURED channel (A9.5 P1Q-15); required on every MEASURED terminal of an ICP45_CAPACITY record, else the point cannot be evaluated",
        "properties": {
         "u_calibration_A": {
          "type": "number",
          "minimum": 0
         },
         "u_zero_offset_A": {
          "type": "number",
          "minimum": 0
         },
         "u_resolution_A": {
          "type": "number",
          "exclusiveMinimum": 0
         },
         "u_repeatability_A": {
          "anyOf": [
           {
            "type": "number",
            "minimum": 0
           },
           {
            "const": "NOT_APPLICABLE"
           }
          ]
         },
         "u_rf_pickup_A": {
          "anyOf": [
           {
            "type": "number",
            "minimum": 0
           },
           {
            "const": "NONE_REGISTERED"
           }
          ]
         }
        }
       }
      },
      "x-I_A-required-unless-basis": "NOT_MEASURED"
     },
     "x-required-by-hall-state-and-electrode": {
      "OFF/DEDICATED_ELECTRON_COLLECTOR_TARGET": [
       "collector_supply",
       "icp_body",
       "facility_ground",
       "electron_collector",
       "hall_anode"
      ],
      "OFF/CHAMBER_WALL_FACILITY_GROUND": [
       "collector_supply",
       "icp_body",
       "facility_ground",
       "hall_anode"
      ],
      "ON/H1_ANODE": [
       "collector_supply",
       "icp_body",
       "facility_ground",
       "hall_anode"
      ]
     }
    },
    "temperatures": {
     "type": "object",
     "required": [
      "T_icp_dielectric_C",
      "T_antenna_C",
      "T_collector_C",
      "T_match_C",
      "T_rf_source_C",
      "T_h1_pole_inner_C",
      "T_h1_pole_outer_C",
      "T_sink_C"
     ],
     "additionalProperties": {
      "type": "number"
     }
    },
    "rf_pickup_check": {
     "enum": [
      "DONE",
      "NOT_DONE"
     ]
    }
   },
   "propertyNames": {
    "not": {
     "pattern": "[Bb][^A-Za-z0-9]*[Uu][^A-Za-z0-9]*[Ss]"
    }
   },
   "x-p-bus-screen": "the reducer refuses, at any nesting depth, every field name that normalises (lower-case, alphanumerics only) to contain 'bus', and a generator.input_boundary text naming a bus (A9.3 OQ-RFQ-06)"
  },
  "topology_control_sequence": {
   "type": "object",
   "required": [
    "schema",
    "record_kind",
    "record_id",
    "run_id",
    "stage_id",
    "synthetic",
    "labels",
    "gas",
    "classification",
    "c1_disconnected",
    "hall_start_registration_id",
    "steps"
   ],
   "properties": {
    "schema": {
     "const": "p1_bench_record_v1"
    },
    "record_kind": {
     "const": "topology_control_sequence"
    },
    "gas": {
     "enum": [
      "Ar"
     ]
    },
    "classification": {
     "const": "REQUIRED_ENGINEERING_CONTROL_NON_SCORING"
    },
    "c1_disconnected": {
     "const": true
    },
    "hall_start_registration_id": {
     "type": "string",
     "minLength": 1
    },
    "labels": {
     "type": "array",
     "contains": {
      "const": "ENGINEERING_ONLY_NON_SCORING"
     }
    },
    "steps": {
     "type": "array",
     "minItems": 7,
     "maxItems": 7,
     "items": {
      "type": "object",
      "required": [
       "step",
       "text",
       "signals"
      ],
      "properties": {
       "step": {
        "type": "integer"
       },
       "text": {
        "type": "string"
       },
       "sustained_discharge_observed": {
        "type": "boolean"
       },
       "sustainment_definition_id": {
        "type": "string"
       },
       "signals": {
        "type": "object",
        "required": [
         "t_s",
         "V_d_V",
         "I_d_A",
         "I_e_icp_A",
         "P_rf_fwd_W",
         "P_rf_refl_W",
         "V_collector_V",
         "V_reference_V"
        ]
       }
      }
     }
    }
   },
   "x-step-texts-verbatim": [
    {
     "step": 1,
     "text": "H-1 gas/magnet conditions established."
    },
    {
     "step": 2,
     "text": "C1 disconnected/not supplying electrons."
    },
    {
     "step": 3,
     "text": "ICP RF OFF."
    },
    {
     "step": 4,
     "text": "Apply the preregistered Hall start attempt inside registered limits."
    },
    {
     "step": 5,
     "text": "Record whether a sustained Hall discharge exists."
    },
    {
     "step": 6,
     "text": "Turn ICP ON using the registered procedure."
    },
    {
     "step": 7,
     "text": "Observe whether Hall discharge becomes sustainable."
    }
   ]
  }
 },
 "x-closure-rule-input": {
  "required": [
   "rule_id",
   "sign_convention",
   "sign_convention_id",
   "I_scale_min_A",
   "I_scale_min_basis"
  ],
  "allowed": [
   "rule_id",
   "sign_convention",
   "sign_convention_id",
   "I_scale_min_A",
   "I_scale_min_basis",
   "covariance"
  ],
  "sign_convention": "CONVENTIONAL_CURRENT_INTO_THE_DEFINED_ISOLATED_ELECTRICAL_NETWORK_IS_POSITIVE",
  "owner_constants": {
   "k_sigma": 3.0,
   "fraction_max": 0.02
  },
  "covariance": {
   "required": [
    "covariance_id",
    "terminals",
    "correlation"
   ],
   "description": "registered correlation r_ij of the listed terminals (symmetric, unit diagonal, positive semi-definite)"
  },
  "source": "docs/decisions/OD_2026_09_30_A9_5_p1_closure_owner_decisions.json decisions.P1Q-15"
 }
}
