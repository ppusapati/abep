      },
      "mode_indicator_basis": {
       "type": "string"
      }
     }
    },
    "point_id": {
     "type": "string",
     "minLength": 1
    },
    "ignition_procedure_id": {
     "type": "string",
     "minLength": 1
    },
    "h1_magnet_state": {
     "enum": [
      "OFF",
      "REGISTERED_SETTING"
     ]
    },
    "h1_magnet_field_setting_id": {
     "type": "string",
     "minLength": 1
    },
    "h1_coil_currents_A": {
     "type": "object",
     "minProperties": 1,
     "additionalProperties": {
      "type": "number"
     }
    },
    "start_state": {
     "enum": [
      "EXTINGUISHED_RF_OFF",
      "NOT_FROM_EXTINGUISHED_STATE"
     ]
