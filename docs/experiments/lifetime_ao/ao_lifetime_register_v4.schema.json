   "required": [
    "control",
    "statement",
    "w4_source",
    "counts",
    "rows",
    "not_adopted",
    "partial_open"
   ],
   "additionalProperties": false,
   "properties": {
    "control": {
     "const": "C5_AO_early"
    },
    "statement": {
     "type": "string"
    },
    "counts": {
     "type": "object",
     "required": [
      "provisions",
      "with_h1_requirement_id",
      "w3_by_disposition",
      "w3_back_trace_text_only",
      "w3_back_trace_none",
      "w4_by_status",
      "w4_rows",
      "w4_back_trace_none"
     ],
     "additionalProperties": false,
     "properties": {
      "provisions": {
       "type": "integer",
       "minimum": 1
      },
      "with_h1_requirement_id": {
       "type": "integer",
       "minimum": 0
      },
      "w3_by_disposition": {
       "type": "object",
       "additionalProperties": {
        "type": "integer",
        "minimum": 0
       }
      },
      "w3_back_trace_text_only": {
       "type": "integer",
       "minimum": 0
      },
      "w3_back_trace_none": {
       "type": "integer",
       "minimum": 0
      },
      "w4_by_status": {
       "type": "object",
       "additionalProperties": {
        "type": "integer",
        "minimum": 0
       }
      },
      "w4_rows": {
       "type": "integer",
       "minimum": 0
      },
      "w4_back_trace_none": {
       "type": "integer",
       "minimum": 0
      }
     }
    },
    "rows": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "object",
      "required": [
       "id",
       "adopters_v1",
       "w3_disposition",
       "w3_requirement_ids",
       "w3_back_trace",
       "w3_note",
       "w3_needed",
       "w4_status",
       "w4_adopted_ids",
       "w4_back_trace",
       "w4_how",
       "w4_needs"
      ],
      "additionalProperties": false,
      "properties": {
       "id": {
        "type": "string",
        "pattern": "^AOL-[A-Z]{2}-\\d{2}$"
       },
       "adopters_v1": {
        "type": "array",
        "items": {
         "enum": [
          "W2",
          "W3",
          "W4",
          "W5"
         ]
        }
       },
       "w3_disposition": {
        "enum": [
         "ADOPTED",
         "ADOPTED_PARTIAL",
         "ALIGNED",
         "NOT_ADOPTED",
         "MISSING_DISPOSITION"
        ]
       },
       "w3_requirement_ids": {
        "type": "array",
        "items": {
         "type": "string",
         "pattern": "^HW-"
        }
       },
       "w3_back_trace": {
        "type": "object",
        "additionalProperties": {
         "enum": [
          "traces_to",
          "text_only",
          "none"
         ]
        }
       },
       "w3_note": {
        "type": [
         "string",
         "null"
        ]
       },
       "w3_needed": {
        "type": [
         "string",
         "null"
        ]
       },
       "w4_status": {
        "enum": [
         "ADOPTED",
         "ADOPTED_PARTIAL",
         "NOT_ADOPTED",
         "MISSING_W4_DISPOSITION",
         "not_a_W4_row"
        ]
       },
       "w4_adopted_ids": {
        "type": "array",
        "items": {
         "type": "string",
         "pattern": "^INS-(P-)?\\d{2}$"
        }
       },
       "w4_back_trace": {
        "type": "object",
        "additionalProperties": {
         "enum": [
          "traces_to_provisions",
          "procedure_provisions",
          "none"
         ]
        }
       },
       "w4_how": {
        "type": [
         "string",
         "null"
        ]
       },
       "w4_needs": {
        "type": [
         "string",
         "null"
        ]
       }
      }
     }
    },
    "not_adopted": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "id",
       "by",
       "status",
       "needed",
       "other_adopter_status"
      ],
      "additionalProperties": false,
      "properties": {
       "id": {
        "type": "string"
       },
       "by": {
        "enum": [
         "W3",
         "W4"
        ]
       },
       "status": {
        "enum": [
         "NOT_ADOPTED",
         "MISSING_DISPOSITION",
         "MISSING_W4_DISPOSITION"
        ]
       },
       "needed": {
        "type": "string"
       },
       "other_adopter_status": {
        "type": "string"
       }
      }
     }
    },
    "w4_source": {
     "type": "object",
     "required": [
      "path",
      "revision",
      "table"
     ],
     "additionalProperties": false,
     "properties": {
      "path": {
       "type": "string"
      },
      "revision": {
       "type": "string"
      },
      "table": {
       "const": "c5_adoption"
      }
     }
    },
    "partial_open": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "id",
       "by",
       "needed",
       "other_adopter_status"
      ],
      "additionalProperties": false,
      "properties": {
       "id": {
        "type": "string",
        "pattern": "^AOL-[A-Z]{2}-\\d{2}$"
       },
       "by": {
        "enum": [
         "W3",
         "W4"
        ]
       },
       "needed": {
        "type": "string"
       },
       "other_adopter_status": {
        "type": "string"
       }
      }
     }
    }
   }
  },
  "history": {
   "type": "array",
   "minItems": 3,
   "items": {
    "type": "object",
    "required": [
     "version",
     "path",
     "sha256",
     "pinned_by"
    ],
    "additionalProperties": false,
    "properties": {
     "version": {
      "enum": [
       "v1",
       "v2",
       "v3"
      ]
     },
     "path": {
      "type": "string"
     },
     "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
     },
     "pinned_by": {
      "type": "string"
     }
    }
   }
  },
  "w3_integration_review_check": {
   "type": "object",
   "required": [
    "statement",
    "w3_pins_register_v3",
    "owner_addendum",
    "counts",
    "rows"
   ],
   "additionalProperties": false,
   "properties": {
    "statement": {
     "type": "string"
    },
    "w3_pins_register_v3": {
     "type": "object",
     "required": [
      "source_id",
      "path",
      "sha256"
     ],
     "additionalProperties": false,
     "properties": {
      "source_id": {
       "const": "SRC-AOL-V3"
      },
      "path": {
       "type": "string"
      },
      "sha256": {
       "type": "string",
       "pattern": "^[0-9a-f]{64}$"
      }
     }
    },
    "owner_addendum": {
     "type": "object",
     "required": [
      "path",
      "sha256"
     ],
     "additionalProperties": false,
     "properties": {
      "path": {
       "type": "string"
      },
      "sha256": {
       "type": "string",
       "pattern": "^[0-9a-f]{64}$"
      }
     }
    },
    "counts": {
     "type": "object",
     "required": [
      "provisions",
      "by_w3_status",
      "with_aol_trace",
      "aol_without_hw_trace"
     ],
     "additionalProperties": false,
     "properties": {
      "provisions": {
       "type": "integer",
       "minimum": 1
      },
      "by_w3_status": {
       "type": "object",
       "additionalProperties": {
        "type": "integer"
       }
      },
      "with_aol_trace": {
       "type": "integer"
      },
      "aol_without_hw_trace": {
       "type": "integer"
      }
     }
    },
    "rows": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "object",
      "required": [
       "provision",
       "w3_status",
       "hw_requirement_ids",
       "aol_traces",
       "aol_back_trace",
       "aol_without_hw_trace"
      ],
      "additionalProperties": false,
      "properties": {
       "provision": {
        "type": "string"
       },
       "w3_status": {
        "enum": [
         "PRESENT",
         "ADDED"
        ]
       },
       "hw_requirement_ids": {
        "type": "array",
        "items": {
         "type": "string"
        }
       },
       "aol_traces": {
        "type": "array",
        "items": {
         "type": "string"
        }
       },
       "aol_back_trace": {
        "type": "object",
        "additionalProperties": {
         "type": "array",
         "items": {
          "type": "string"
         }
        }
       },
       "aol_without_hw_trace": {
        "type": "array",
        "items": {
         "type": "string"
        }
       }
      }
     }
    }
   }
  }
 },
