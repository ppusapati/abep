{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "docs/architecture_comparison/veto_layer/veto_layer_v1.schema.json",
 "title": "Mass / thermal / life / start-up veto layer v1",
 "description": "Output of docs/architecture_comparison/veto_layer/build_veto_layer.py. Uses only the JSON-Schema subset implemented by abep_sim.hard_gates.schema_errors.",
 "type": "object",
 "additionalProperties": false,
 "required": ["schema", "id", "follow_on", "trigger", "status", "created", "base_commit", "generated_by", "question",
              "answer", "architectures", "dimensions", "status_definitions", "status_counts", "rfp_limits_as_recorded",
              "inputs", "external_blockers", "cells", "risk_indicators", "common_mode_vs_architecture_specific",
              "lane24_evaluation", "veto_candidates", "eliminated_within_tested_envelope", "not_used", "milestones",
              "proposed_for_owner", "open_questions_for_owner", "note"],
 "properties": {
  "schema": {"const": "veto_layer_v1"},
  "id": {"const": "veto_layer_v1"},
  "follow_on": {"const": "fo_veto_layer"},
  "trigger": {"const": "T_VETO_LAYER"},
  "status": {"const": "DRAFT_FOR_OWNER_REVIEW"},
  "created": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
  "base_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
  "generated_by": {"$ref": "#/$defs/text"},
  "question": {"$ref": "#/$defs/text"},
  "answer": {"$ref": "#/$defs/text"},
  "architectures": {"type": "array", "items": {"$ref": "#/$defs/arch"}, "minItems": 3, "maxItems": 3,
                    "uniqueItems": true},
  "dimensions": {"type": "array", "items": {"$ref": "#/$defs/dimension"}, "minItems": 5, "maxItems": 5,
                 "uniqueItems": true},
  "status_definitions": {"type": "object", "additionalProperties": {"$ref": "#/$defs/text"},
                         "required": ["VETO_CANDIDATE", "NO_VETO_WITHIN_EVIDENCE", "UNDETERMINED",
                                      "ELIMINATED_WITHIN_TESTED_ENVELOPE"]},
  "status_counts": {"type": "object", "additionalProperties": false,
                    "required": ["VETO_CANDIDATE", "NO_VETO_WITHIN_EVIDENCE", "UNDETERMINED"],
                    "properties": {"VETO_CANDIDATE": {"type": "integer", "minimum": 0},
                                   "NO_VETO_WITHIN_EVIDENCE": {"type": "integer", "minimum": 0},
                                   "UNDETERMINED": {"type": "integer", "minimum": 0}}},
  "rfp_limits_as_recorded": {"type": "object", "additionalProperties": {
   "type": "object", "additionalProperties": false,
   "required": ["threshold", "comparator", "unit", "gate_status", "threshold_source"],
   "properties": {"threshold": {"type": ["number", "null"]}, "comparator": {"$ref": "#/$defs/text"},
                  "unit": {"$ref": "#/$defs/text"}, "gate_status": {"$ref": "#/$defs/text"},
                  "threshold_source": {"$ref": "#/$defs/text"}}}},
  "inputs": {"type": "array", "minItems": 1, "items": {
   "type": "object", "additionalProperties": false, "required": ["path", "sha256", "lane", "lane_commit", "role"],
   "properties": {"path": {"$ref": "#/$defs/text"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                  "lane": {"$ref": "#/$defs/text"}, "lane_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
                  "role": {"$ref": "#/$defs/text"}}}},
  "external_blockers": {"type": "object", "additionalProperties": {
   "type": "object", "additionalProperties": false, "required": ["path", "in_base_commit", "note"],
   "properties": {"path": {"$ref": "#/$defs/text"}, "in_base_commit": {"type": "boolean"},
                  "note": {"$ref": "#/$defs/text"}}}},
  "cells": {"type": "object", "additionalProperties": false, "required": ["hall_only", "rf_hall", "ecr_hall"],
            "properties": {"hall_only": {"$ref": "#/$defs/arch_cells"}, "rf_hall": {"$ref": "#/$defs/arch_cells"},
                           "ecr_hall": {"$ref": "#/$defs/arch_cells"}}},
  "risk_indicators": {"type": "array", "items": {"$ref": "#/$defs/risk_indicator"}},
  "common_mode_vs_architecture_specific": {
   "type": "object", "additionalProperties": false,
   "required": ["common_mode_risk_indicators", "architecture_specific_risk_indicators", "reading"],
   "properties": {"common_mode_risk_indicators": {"$ref": "#/$defs/string_list"},
                  "architecture_specific_risk_indicators": {"type": "object",
                                                            "additionalProperties": {"$ref": "#/$defs/string_list"}},
                  "reading": {"$ref": "#/$defs/text"}}},
  "lane24_evaluation": {
   "type": "object", "additionalProperties": false,
   "required": ["evaluator", "matrix_version", "matrix_status", "admitted_members", "items_submitted", "eliminated",
                "not_eliminated", "architectures"],
   "properties": {"evaluator": {"$ref": "#/$defs/text"}, "matrix_version": {"$ref": "#/$defs/text"},
                  "matrix_status": {"$ref": "#/$defs/text"}, "admitted_members": {"$ref": "#/$defs/string_list"},
                  "items_submitted": {"$ref": "#/$defs/string_list"}, "eliminated": {"$ref": "#/$defs/string_list"},
                  "not_eliminated": {"$ref": "#/$defs/string_list"},
                  "architectures": {"type": "object", "additionalProperties": {
                   "type": "object", "additionalProperties": false,
                   "required": ["eliminated", "elimination_basis", "proposed_gate_failures", "gate_verdicts",
                                "items_not_verdict_bearing"],
                   "properties": {"eliminated": {"type": "boolean"}, "elimination_basis": {"type": "array"},
                                  "proposed_gate_failures": {"type": "array"},
                                  "gate_verdicts": {"type": "object", "additionalProperties": {
                                   "enum": ["PASS", "FAIL", "UNDETERMINED"]}},
                                  "items_not_verdict_bearing": {"type": "array", "items": {
                                   "type": "object", "additionalProperties": false,
                                   "required": ["id", "criterion", "reasons"],
                                   "properties": {"id": {"$ref": "#/$defs/text"}, "criterion": {"$ref": "#/$defs/text"},
                                                  "reasons": {"$ref": "#/$defs/string_list"}}}}}}}}},
  "veto_candidates": {"type": "array", "items": {"$ref": "#/$defs/arch_dim"}},
  "eliminated_within_tested_envelope": {"type": "array", "items": {"$ref": "#/$defs/arch_dim"}},
  "not_used": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["what", "why"],
                                          "properties": {"what": {"$ref": "#/$defs/text"},
                                                         "why": {"$ref": "#/$defs/text"}}}},
  "milestones": {"type": "object", "additionalProperties": false, "required": ["supports", "A", "B_needs", "C_needs"],
                 "properties": {"supports": {"type": "array", "items": {"enum": ["A", "B", "C"]}, "minItems": 1},
                                "A": {"$ref": "#/$defs/text"}, "B_needs": {"$ref": "#/$defs/text"},
                                "C_needs": {"$ref": "#/$defs/text"}}},
  "proposed_for_owner": {"type": "array", "items": {
   "type": "object", "additionalProperties": false, "required": ["id", "item", "status"],
   "properties": {"id": {"$ref": "#/$defs/text"}, "item": {"$ref": "#/$defs/text"}, "status": {"const": "PROPOSED"}}}},
  "open_questions_for_owner": {"$ref": "#/$defs/string_list"},
  "note": {"$ref": "#/$defs/text"}
 },
 "$defs": {
  "text": {"type": "string", "minLength": 1},
  "string_list": {"type": "array", "items": {"type": "string", "minLength": 1}},
  "arch": {"enum": ["hall_only", "rf_hall", "ecr_hall"]},
  "dimension": {"enum": ["mass", "thermal", "life_firing", "life_mission", "startup"]},
  "arch_dim": {"type": "object", "additionalProperties": false, "required": ["architecture", "dimension"],
               "properties": {"architecture": {"$ref": "#/$defs/arch"}, "dimension": {"$ref": "#/$defs/dimension"}}},
  "range": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": ["number", "null"]}},
  "arch_cells": {"type": "object", "additionalProperties": false,
                 "required": ["mass", "thermal", "life_firing", "life_mission", "startup"],
                 "properties": {"mass": {"$ref": "#/$defs/cell"}, "thermal": {"$ref": "#/$defs/cell"},
                                "life_firing": {"$ref": "#/$defs/cell"}, "life_mission": {"$ref": "#/$defs/cell"},
                                "startup": {"$ref": "#/$defs/cell"}}},
  "cell": {
   "type": "object", "additionalProperties": false,
   "required": ["status", "final_status", "criteria", "verdict_eligible_bounds", "margin", "conditional_margins",
                "risk_indicators", "risk_directions", "missing_inputs", "common_mode_missing",
                "architecture_specific_missing"],
   "properties": {
    "status": {"enum": ["VETO_CANDIDATE", "NO_VETO_WITHIN_EVIDENCE", "UNDETERMINED"]},
    "final_status": {"enum": ["VETO_CANDIDATE", "NO_VETO_WITHIN_EVIDENCE", "UNDETERMINED",
                              "ELIMINATED_WITHIN_TESTED_ENVELOPE"]},
    "criteria": {"type": "array", "minItems": 1, "items": {
     "type": "object", "additionalProperties": false,
     "required": ["criterion", "gate", "gate_status", "binding", "metric", "comparator", "threshold", "unit",
                  "elements", "fail_sufficient_bases", "can_eliminate_on_this_dimension", "notes"],
     "properties": {"criterion": {"$ref": "#/$defs/text"}, "gate": {"$ref": "#/$defs/text"},
                    "gate_status": {"$ref": "#/$defs/text"}, "binding": {"type": "boolean"},
                    "metric": {"$ref": "#/$defs/text"}, "comparator": {"$ref": "#/$defs/text"},
                    "threshold": {"type": ["number", "null"]}, "unit": {"$ref": "#/$defs/text"},
                    "elements": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/string_list"}]},
                    "fail_sufficient_bases": {"$ref": "#/$defs/string_list"},
                    "can_eliminate_on_this_dimension": {"type": "boolean"},
                    "notes": {"$ref": "#/$defs/string_list"}}}},
    "verdict_eligible_bounds": {"type": "array", "items": {
     "type": "object", "additionalProperties": false, "required": ["from", "id", "criterion", "basis", "value", "side"],
     "properties": {"from": {"$ref": "#/$defs/text"}, "id": {"$ref": "#/$defs/text"},
                    "criterion": {"$ref": "#/$defs/text"}, "basis": {"$ref": "#/$defs/text"}, "value": {"type": "object"},
                    "side": {"enum": ["fail", "pass", "not_fail", "undecided"]}}}},
    "margin": {"type": "object", "required": ["kind"],
               "properties": {"kind": {"enum": ["not_computable", "bounds"]}}},
    "conditional_margins": {"type": "array", "items": {
     "type": "object", "required": ["risk_indicator", "quantity", "range", "unit", "relation"],
     "properties": {"risk_indicator": {"$ref": "#/$defs/text"}, "quantity": {"$ref": "#/$defs/text"},
                    "range": {"$ref": "#/$defs/range"}, "unit": {"$ref": "#/$defs/text"},
                    "relation": {"$ref": "#/$defs/text"}}}},
    "risk_indicators": {"$ref": "#/$defs/string_list"},
    "risk_directions": {"$ref": "#/$defs/string_list"},
    "missing_inputs": {"type": "array", "items": {
     "type": "object", "additionalProperties": false, "required": ["input", "requires", "blocking", "scope"],
     "properties": {"input": {"$ref": "#/$defs/text"}, "requires": {"$ref": "#/$defs/text"},
                    "blocking": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
                    "scope": {"enum": ["common_mode", "architecture_specific"]}}}},
    "common_mode_missing": {"type": "integer", "minimum": 0},
    "architecture_specific_missing": {"type": "integer", "minimum": 0}
   }
  },
  "risk_indicator": {
   "type": "object", "additionalProperties": false,
   "required": ["id", "dimension", "scope", "architectures", "element", "statement", "values", "unit",
                "conditional_margin", "direction", "evidence_class", "evidence_levels", "lane24_basis", "source_refs",
                "why_not_verdict_bearing", "to_become_verdict_bearing", "architecture_modulation"],
   "properties": {
    "id": {"type": "string", "pattern": "^RI-[A-Z0-9-]+$"},
    "dimension": {"$ref": "#/$defs/dimension"},
    "scope": {"enum": ["common_mode", "architecture_specific"]},
    "architectures": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/arch"}},
    "element": {"$ref": "#/$defs/text"},
    "statement": {"$ref": "#/$defs/text"},
    "values": {"type": "object"},
    "unit": {"$ref": "#/$defs/text"},
    "conditional_margin": {"anyOf": [{"type": "null"}, {
     "type": "object", "required": ["quantity", "range", "unit", "relation"],
     "properties": {"quantity": {"$ref": "#/$defs/text"}, "range": {"$ref": "#/$defs/range"},
                    "unit": {"$ref": "#/$defs/text"}, "relation": {"$ref": "#/$defs/text"}}}]},
    "direction": {"enum": ["toward_exceedance", "away_from_exceedance", "straddles_limit", "uninformative"]},
    "evidence_class": {"$ref": "#/$defs/text"},
    "evidence_levels": {"type": "array", "items": {"type": "integer", "minimum": 1, "maximum": 7}},
    "lane24_basis": {"anyOf": [{"type": "null"},
                               {"enum": ["measurement_similar_hardware", "engineering_estimate", "assumption"]}]},
    "source_refs": {"type": "array", "minItems": 1, "items": {
     "type": "object", "required": ["file", "path"],
     "properties": {"file": {"$ref": "#/$defs/text"}, "path": {"$ref": "#/$defs/text"}}}},
    "why_not_verdict_bearing": {"$ref": "#/$defs/text"},
    "to_become_verdict_bearing": {"$ref": "#/$defs/text"},
    "architecture_modulation": {"$ref": "#/$defs/text"}
   }
  }
 }
}
