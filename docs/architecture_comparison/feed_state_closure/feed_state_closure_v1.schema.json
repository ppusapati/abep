  "design_input_inventory": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "name",
     "unit",
     "consumer",
     "required_when",
     "value",
     "status",
     "source",
     "evidence_class",
     "published_comparables"
    ],
    "additionalProperties": false,
    "properties": {
     "name": {
      "type": "string"
     },
     "unit": {
      "type": "string"
     },
     "consumer": {
      "type": "string"
