       "status": {
        "const": "PROPOSED (candidate-conditional)"
       },
       "evidence_class": {
        "const": "model-derived (from assumed inputs)"
       },
       "gas": {
        "enum": [
         "N2",
         "N2+O2 air surrogate"
        ]
       },
       "mdot_N2_kgps": {
        "type": "number",
        "exclusiveMinimum": 0
       },
       "flight_status": {
        "const": "PROPOSED_FLIGHT_REPRESENTATIVE"
       }
      }
     }
    }
   }
  },
  "mfc_range_requirement": {
