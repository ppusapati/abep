{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "docs/architecture_comparison/feed_state_closure/feed_state_closure_v1.schema.json",
 "title": "W1 feed-state closure v1 (fo_feed_state_closure)",
