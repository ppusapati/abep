       "P_feed_target_Pa",
       "T_feed_flight_K",
       "trace",
       "flight_x_s",
       "mdot_scenario_range_kgps",
       "status",
       "evidence_class",
       "flow_basis",
       "mdot_backflow_lower_kgps",
       "flight_status"
