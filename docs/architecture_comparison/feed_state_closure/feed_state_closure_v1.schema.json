{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "docs/architecture_comparison/feed_state_closure/feed_state_closure_v1.schema.json",
 "title": "W1 feed-state closure v1 (fo_feed_state_closure)",
 "description": "Valve-outlet feed states (ICD IF-A5) for PROPOSED design candidates and the derived ground test points. Keywords used: type, required, properties, additionalProperties, enum, const, items, minimum, exclusiveMinimum, maximum, minItems (the repository test validates with a small built-in validator for exactly these keywords).",
 "type": "object",
 "required": ["schema", "version", "status", "follow_on", "trigger", "owner_disposition", "base_commit", "generated_by",
              "architectures", "architecture_independence", "closure_independence", "milestones", "interfaces",
              "provenance", "references", "published_comparables", "design_input_inventory", "design_axes",
              "candidates", "design_input_documents", "ladder_runs", "closure", "sensitivity_runs", "valve_outlet",
              "sensitivity_ranking", "design_axis_effects_at_design_case", "test_points", "mfc_range_requirement",
              "atomic_oxygen", "findings", "owner_decisions_DI1"],
 "additionalProperties": false,
 "properties": {
  "schema": {"const": "feed_state_closure_v1"},
  "version": {"type": "string"},
  "status": {"const": "DRAFT for owner review"},
  "follow_on": {"const": "fo_feed_state_closure"},
  "trigger": {"const": "T_PIVOT_FEED_STATE_CLOSURE"},
  "owner_disposition": {"type": "object", "required": ["id", "file", "workstream"],
                        "properties": {"id": {"const": "od_hardware_pivot"}, "file": {"type": "string"},
                                       "workstream": {"const": "W1_feed_state_closure"}}},
  "base_commit": {"type": "string"},
  "generated_by": {"type": "string"},
  "architectures": {"type": "array", "items": {"enum": ["hall_only", "rf_hall", "ecr_hall"]}, "minItems": 3},
  "architecture_independence": {"type": "string"},
  "closure_independence": {"type": "string"},
  "milestones": {"type": "object", "required": ["supports", "A", "to_reach_B", "to_reach_C"],
                 "properties": {"supports": {"type": "array", "items": {"enum": ["A", "B", "C"]}, "minItems": 1},
                                "A": {"type": "string"},
                                "to_reach_B": {"type": "array", "items": {"type": "string"}, "minItems": 1},
                                "to_reach_C": {"type": "array", "items": {"type": "string"}, "minItems": 1}}},
  "interfaces": {"type": "object"},
  "provenance": {"type": "object", "required": ["input_files", "chain"],
                 "properties": {"input_files": {"type": "array", "minItems": 1,
                                                "items": {"type": "object", "required": ["path", "sha256"],
                                                          "additionalProperties": false,
                                                          "properties": {"path": {"type": "string"},
                                                                         "sha256": {"type": "string"}}}},
                                "chain": {"type": "string"}}},
  "references": {"type": "object"},
  "published_comparables": {"type": "array", "items": {
   "type": "object", "required": ["id", "ref", "where", "statement", "relevance", "evidence_class", "role"],
   "additionalProperties": false,
   "properties": {"id": {"type": "string"}, "ref": {"type": "string"}, "where": {"type": "string"},
                  "statement": {"type": "string"}, "relevance": {"type": "string"},
                  "evidence_class": {"enum": ["measured", "digitized", "inferred", "reconstructed", "model-derived", "assumed"]},
                  "role": {"const": "context_only"}}}},
  "design_input_inventory": {"type": "array", "minItems": 1, "items": {
   "type": "object",
   "required": ["name", "unit", "consumer", "required_when", "value", "status", "source", "evidence_class",
                "published_comparables"],
   "additionalProperties": false,
   "properties": {"name": {"type": "string"}, "unit": {"type": "string"}, "consumer": {"type": "string"},
                  "required_when": {"type": "string"},
                  "value": {"type": ["number", "string", "null"]},
                  "status": {"enum": ["PROPOSED", "TBD", "NOT_USED_IN_SELECTED_MODES"]},
                  "source": {"type": ["string", "null"]},
                  "evidence_class": {"enum": ["measured", "digitized", "inferred", "reconstructed", "model-derived",
                                              "assumed", null]},
                  "published_comparables": {"type": "array", "items": {"type": "string"}}}}},
  "design_axes": {"type": "object", "required": ["design_case", "sizing_rules", "geometries", "setpoint_ladder_Pa",
                                                 "sensitivities", "status"],
                  "properties": {"status": {"const": "PROPOSED"}}},
  "candidates": {"type": "array", "minItems": 1, "items": {
   "type": "object",
   "required": ["id", "sizing_rule", "geometry", "L_over_d", "phi", "design_thrust_mN", "intake_area_m2",
                "area_source", "C_D_design_case", "eta_c_design_case", "CR_passive_design_case", "status",
                "evidence_class"],
   "properties": {"id": {"type": "string"}, "intake_area_m2": {"type": "number", "exclusiveMinimum": 0},
                  "design_thrust_mN": {"type": "number", "exclusiveMinimum": 0},
                  "status": {"const": "PROPOSED"}, "evidence_class": {"const": "assumed"}}}},
  "design_input_documents": {"type": "object"},
  "ladder_runs": {"type": "object"},
  "closure": {"type": "object"},
  "sensitivity_runs": {"type": "object"},
  "valve_outlet": {"type": "object"},
  "sensitivity_ranking": {"type": "array", "items": {"type": "object", "required": ["candidate", "ranked"]}},
  "design_axis_effects_at_design_case": {"type": "array"},
  "test_points": {"type": "object",
                  "required": ["phase1_knee_N2", "phase2_common_condition", "phase3_absolute_demonstration"],
                  "additionalProperties": false,
                  "properties": {
                   "phase1_knee_N2": {"type": "array", "items": {
                    "type": "object", "required": ["id", "phase", "gas", "basis", "candidate", "mdot_N2_kgps",
                                                   "sccm_N2", "P_feed_target_Pa", "trace"],
                    "properties": {"phase": {"const": 1}, "gas": {"const": "N2"},
                                   "mdot_N2_kgps": {"type": "number", "exclusiveMinimum": 0}}}},
                   "phase2_common_condition": {"type": "array", "items": {
                    "type": "object", "required": ["id", "phase", "operating_point", "gas", "candidate", "arms",
                                                   "value_status", "trace"],
                    "properties": {"phase": {"const": 2}, "operating_point": {"enum": ["OP1", "OP2", "OP3", "OP5"]},
                                   "arms": {"type": "array", "items": {"enum": ["hall_only", "rf_hall", "ecr_hall"]},
                                            "minItems": 3}}}},
                   "phase3_absolute_demonstration": {"type": "array", "items": {
                    "type": "object", "required": ["id", "phase", "gas", "candidate", "mdot_N2_kgps", "sccm_N2",
                                                   "P_feed_target_Pa", "T_feed_flight_K", "trace", "flight_x_s",
                                                   "mdot_scenario_range_kgps"],
                    "properties": {"phase": {"const": 3}, "gas": {"enum": ["N2", "N2+O2 air surrogate"]},
                                   "mdot_N2_kgps": {"type": "number", "exclusiveMinimum": 0}}}}}},
  "mfc_range_requirement": {"type": "object"},
  "atomic_oxygen": {"type": "object", "required": ["can_atomic_O_be_supplied_from_bottles", "why", "surrogates",
                                                   "consequence", "valve_outlet_x_O_ranges"],
                    "properties": {"can_atomic_O_be_supplied_from_bottles": {"const": false}}},
  "findings": {"type": "array", "items": {"type": "object",
                                          "required": ["id", "where", "finding", "evidence_class", "handling"]}},
  "owner_decisions_DI1": {"type": "array", "minItems": 1,
                          "items": {"type": "object", "required": ["id", "question", "options", "recommendation"]}}
 }
}
