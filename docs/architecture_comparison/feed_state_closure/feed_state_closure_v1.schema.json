       "flight_status": {
        "enum": [
         "PROPOSED_FLIGHT_REPRESENTATIVE",
         "GROUND_QUALIFICATION_POINT"
        ]
       }
      }
     }
    },
    "phase3_absolute_demonstration": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
