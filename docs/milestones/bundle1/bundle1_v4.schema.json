{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "docs/milestones/bundle1/bundle1_v4.schema.json",
 "title": "Bundle 1: Architecture Conditional Selection (Milestone A), bundle1_v4",
 "description": "Structure of docs/milestones/bundle1/bundle1_v4.json (v4 of bundle1_v3.schema.json: supersedes bundle1_v3; historical_records v1..v3; change_log from bundle1_v3 to bundle1_v4; structure otherwise unchanged). Checked by the keyword-subset validator in build_bundle1.py (type, const, enum, required, properties, additionalProperties, items, minItems, minLength, pattern, $ref, allOf, if/then/else).",
 "type": "object",
 "required": ["id", "version", "title", "follow_on", "trigger", "attempt", "execution_key", "claim", "base_commit", "integration_commit",
              "prepared", "status", "supersedes", "historical_records", "change_log", "carried_statuses", "context_followons",
              "architectures", "boundary_version", "what_it_is", "what_it_is_not", "milestones", "inputs", "decision_rule",
              "mandatory_fields", "admissibility", "hard_gates", "outcome", "conditions_on_record", "three_questions",
              "evidence_weight", "owner_questions_open", "provenance"],
 "additionalProperties": false,
 "properties": {
  "id": {"const": "bundle1_v4"},
  "version": {"const": "v4"},
  "integration_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
  "supersedes": {"type": "object", "required": ["id", "commit", "files_sha256", "status", "verification_record", "why_not_rebuilt"],
                 "properties": {"id": {"const": "bundle1_v3"}, "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
                                "files_sha256": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}},
  "historical_records": {"type": "array", "minItems": 3,
                         "items": {"type": "object", "required": ["id", "commit", "files_sha256", "status", "verification_record", "why_not_rebuilt"],
                                   "properties": {"id": {"enum": ["bundle1_v1", "bundle1_v2", "bundle1_v3"]}, "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
                                                  "files_sha256": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}}},
  "change_log": {"type": "object",
                 "required": ["from", "to", "inputs_changed", "inputs_added", "inputs_removed", "decision_relevant_changes",
                              "metadata_changes", "new_sections", "unchanged", "summary"],
                 "properties": {"from": {"const": "bundle1_v3"}, "to": {"const": "bundle1_v4"},
                                "inputs_changed": {"type": "array", "items": {"type": "object", "required": ["lane", "role", "from_commit", "to_commit", "files"]}},
                                "unchanged": {"type": "object", "required": ["outcome", "admissibility_verdict", "cell_statuses", "eliminations",
                                                                             "overlay_readings", "decision_rule"]}}},
  "carried_statuses": {"type": "object", "required": ["echt_n2"],
                       "properties": {"echt_n2": {"type": "object", "required": ["lane09_items", "hsenv_interpretation_condition",
                                                                                 "hsenv_declared_uncertainties", "hsenv_repin_effect", "bundle_reading"],
                                                  "properties": {"lane09_items": {"type": "array", "minItems": 1,
                                                                                  "items": {"type": "object", "required": ["item", "status", "literature_transfer_use",
                                                                                                                           "score_bearing", "transport_discriminator", "source"],
                                                                                            "properties": {"score_bearing": {"const": false},
                                                                                                           "transport_discriminator": {"const": false}}}}}}}},
  "context_followons": {"type": "object", "required": ["fo_aux_bus_comparison", "fo_veto_layer", "fo_experiment_package",
                                                       "fo_dx5_cross_section_evidence", "role"]},
  "title": {"type": "string", "minLength": 1},
  "follow_on": {"const": "fo_bundle1_conditional_selection"},
  "trigger": {"const": "T_BUNDLE1"},
  "attempt": {"type": "integer"},
  "execution_key": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
  "claim": {"type": "object", "required": ["utc", "dependency_state_hash", "source", "prerequisite_identities_match_pins", "repin_log",
                                             "context_repin_log"],
            "properties": {"prerequisite_identities_match_pins": {"type": "boolean"},
                           "repin_log": {"type": "array", "items": {"type": "object", "required": ["lane", "claim_identity", "pinned_identity", "reason",
                                                                                                    "verification_record"]}},
                           "context_repin_log": {"type": "array", "items": {"type": "object", "required": ["lane", "ledger_verified_identity",
                                                                                                            "pinned_identity", "reason",
                                                                                                            "verification_record"]}}}},
  "base_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
  "prepared": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
  "status": {"const": "DRAFT_FOR_OWNER_REVIEW"},
  "architectures": {"type": "array", "items": {"enum": ["hall_only", "rf_hall", "ecr_hall"]}, "minItems": 3},
  "boundary_version": {"const": "bus_power_boundary_v1"},
  "what_it_is": {"type": "string", "minLength": 1},
  "what_it_is_not": {"type": "string", "minLength": 1},
  "milestones": {"type": "object", "required": ["supports", "A", "to_reach_B", "to_reach_C"],
                 "properties": {"supports": {"type": "array", "items": {"enum": ["A"]}, "minItems": 1},
                                "to_reach_B": {"type": "array", "items": {"type": "string"}, "minItems": 1},
                                "to_reach_C": {"type": "array", "items": {"type": "string"}, "minItems": 1}}},
  "inputs": {"type": "array", "minItems": 18, "items": {"$ref": "#/$defs/input"}},
  "decision_rule": {"type": "object", "required": ["id", "status", "steps", "note"],
                    "properties": {"status": {"const": "PROPOSED"}, "steps": {"type": "array", "items": {"type": "string"}, "minItems": 5}}},
  "mandatory_fields": {"type": "array", "minItems": 13,
                       "items": {"type": "object", "required": ["id", "symbol", "meaning"], "additionalProperties": false,
                                 "properties": {"id": {"enum": ["m_dot_s", "P_feed", "T_feed", "x_s", "V_d", "T", "P_bus", "m",
                                                                "Q_reject", "life", "startup", "eta_u", "stability"]},
                                                "symbol": {"type": "string"}, "meaning": {"type": "string", "minLength": 1}}}},
  "admissibility": {
   "type": "object",
   "required": ["rule", "verdict", "problems", "boundary_version", "counts", "populated_fields",
                "populated_fields_that_differ_between_architectures", "reading", "cells"],
   "properties": {
    "verdict": {"enum": ["ADMISSIBLE", "NOT_ADMISSIBLE"]},
    "boundary_version": {"const": "bus_power_boundary_v1"},
    "cells": {"type": "object", "required": ["hall_only", "rf_hall", "ecr_hall"], "additionalProperties": false,
              "properties": {"hall_only": {"$ref": "#/$defs/field_row"}, "rf_hall": {"$ref": "#/$defs/field_row"},
                             "ecr_hall": {"$ref": "#/$defs/field_row"}}}
   }
  },
  "hard_gates": {"type": "object",
                 "required": ["source", "lane24_matrix_status", "lane24_eliminated", "lane24_not_eliminated", "per_architecture", "overlays"],
                 "properties": {"per_architecture": {"type": "object", "additionalProperties": {"$ref": "#/$defs/gate_status"}}}},
  "outcome": {
   "type": "object",
   "required": ["form", "architecture", "label", "proposal_status", "rule_trace", "discriminators", "blocking_fields", "blocking_lanes",
                "blocking_triggers", "blocking_measurements", "blocking_owner_decisions", "conditions", "why_no_single_architecture"],
   "properties": {"form": {"enum": ["CONDITIONAL_BASELINE", "NO_BASELINE_YET"]},
                  "rule_trace": {"type": "array", "items": {"type": "string"}, "minItems": 1},
                  "conditions": {"type": "array", "items": {"$ref": "#/$defs/condition"}}},
   "allOf": [
    {"if": {"properties": {"form": {"const": "CONDITIONAL_BASELINE"}}},
     "then": {"properties": {"architecture": {"enum": ["hall_only", "rf_hall", "ecr_hall"]},
                             "conditions": {"type": "array", "minItems": 1}}},
     "else": {"properties": {"architecture": {"type": "null"}, "blocking_lanes": {"type": "array", "minItems": 1}}}}
   ]
  },
  "conditions_on_record": {"type": "object", "required": ["shared_lane24_criteria", "per_architecture"]},
  "three_questions": {"type": "object", "required": ["i_conditional_selection_now", "ii_what_blocks_physics_backed_selection", "iii_what_could_overturn"],
                      "properties": {"ii_what_blocks_physics_backed_selection": {"type": "array", "minItems": 1,
                                       "items": {"type": "object", "required": ["item", "state", "ids"],
                                                 "properties": {"ids": {"type": "array", "minItems": 1}}}},
                                     "iii_what_could_overturn": {"type": "array", "minItems": 1, "items": {"type": "string"}}}},
  "evidence_weight": {"type": "object", "required": ["rule", "inputs_single_lens", "blocking_lanes_single_lens", "note"]},
  "owner_questions_open": {"type": "array", "minItems": 1,
                           "items": {"type": "object", "required": ["lane", "source", "id", "question"], "additionalProperties": false,
                                     "properties": {"lane": {"type": "string", "pattern": "^(lane_\\d\\d_|fo_)"},
                                                    "source": {"type": "string", "minLength": 1}, "id": {"type": "string", "minLength": 1},
                                                    "question": {"type": "string", "minLength": 1}}}},
  "provenance": {"type": "object", "required": ["generated_by", "check", "schema", "governance_snapshot", "governance_checked"]}
 },
 "$defs": {
  "input": {"type": "object", "additionalProperties": false,
            "required": ["lane", "title", "role", "commit", "verification_protocol", "protocol_source", "protocol_notes",
                         "decisive_for_B_or_C_allowed", "files"],
            "properties": {"lane": {"type": "string", "pattern": "^(lane_\\d\\d_|fo_)"}, "title": {"type": "string"},
                           "role": {"enum": ["prerequisite", "context"]}, "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
                           "verification_protocol": {"type": "string", "minLength": 1}, "protocol_source": {"type": "string", "minLength": 1},
                           "protocol_notes": {"type": "array", "items": {"type": "string"}},
                           "decisive_for_B_or_C_allowed": {"type": "boolean"},
                           "files": {"type": "array", "minItems": 1,
                                     "items": {"type": "object", "required": ["path", "sha256"], "additionalProperties": false,
                                               "properties": {"path": {"type": "string", "minLength": 1},
                                                              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}}}},
  "field_row": {"type": "object", "additionalProperties": false,
                "required": ["m_dot_s", "P_feed", "T_feed", "x_s", "V_d", "T", "P_bus", "m", "Q_reject", "life", "startup", "eta_u", "stability"],
                "properties": {"m_dot_s": {"$ref": "#/$defs/cell"}, "P_feed": {"$ref": "#/$defs/unavailable_cell"},
                               "T_feed": {"$ref": "#/$defs/unavailable_cell"}, "x_s": {"$ref": "#/$defs/cell"}, "V_d": {"$ref": "#/$defs/cell"},
                               "T": {"$ref": "#/$defs/cell"}, "P_bus": {"$ref": "#/$defs/cell"}, "m": {"$ref": "#/$defs/cell"},
                               "Q_reject": {"$ref": "#/$defs/cell"}, "life": {"$ref": "#/$defs/cell"}, "startup": {"$ref": "#/$defs/cell"},
                               "eta_u": {"$ref": "#/$defs/cell"}, "stability": {"$ref": "#/$defs/cell"}}},
  "unavailable_cell": {"allOf": [{"$ref": "#/$defs/cell"}, {"properties": {"status": {"const": "EXPLICITLY_UNAVAILABLE"}, "value": {"type": "null"}}}]},
  "cell": {
   "type": "object", "additionalProperties": false,
   "required": ["status", "value", "units", "operating_point", "evidence", "evidence_class", "basis", "uncertainty_status", "derivation",
                "blocking", "lane24_criteria", "hall_closure_dependent", "notes"],
   "properties": {
    "status": {"enum": ["POPULATED", "EXPLICITLY_UNAVAILABLE"]},
    "value": {},
    "units": {"type": "string", "minLength": 1},
    "operating_point": {"type": "object", "required": ["id", "definition"], "additionalProperties": false,
                        "properties": {"id": {"type": "string", "pattern": "^OP-"}, "definition": {"type": "string", "minLength": 1}}},
    "evidence": {"type": "array", "minItems": 1,
                 "items": {"type": "object", "required": ["path", "input_lane", "locator"], "additionalProperties": false,
                           "properties": {"path": {"type": "string", "minLength": 1}, "input_lane": {"type": "string", "pattern": "^(lane_\\d\\d_|fo_)"},
                                          "locator": {"type": "string", "minLength": 1}}}},
    "evidence_class": {"enum": ["measured", "digitized", "inferred", "reconstructed", "model-derived", "assumed", "none"]},
    "basis": {"type": ["string", "null"]},
    "uncertainty_status": {"type": "string", "minLength": 1},
    "derivation": {"type": "string", "minLength": 1},
    "blocking": {"type": "array", "items": {"type": "object", "required": ["kind", "id", "what"], "additionalProperties": false,
                                           "properties": {"kind": {"enum": ["lane", "trigger", "measurement", "owner_decision"]},
                                                          "id": {"type": "string", "minLength": 1}, "what": {"type": "string", "minLength": 1}}}},
    "lane24_criteria": {"type": "array"},
    "hall_closure_dependent": {"type": "boolean"},
    "notes": {"type": "array", "items": {"type": "string"}}
   },
   "allOf": [
    {"if": {"properties": {"status": {"const": "EXPLICITLY_UNAVAILABLE"}}},
     "then": {"properties": {"value": {"type": "null"}, "evidence_class": {"const": "none"}, "blocking": {"type": "array", "minItems": 1},
                             "uncertainty_status": {"type": "string", "pattern": "^unavailable:"}}},
     "else": {"properties": {"evidence_class": {"enum": ["measured", "digitized", "inferred", "reconstructed", "model-derived", "assumed"]}}}}
   ]
  },
  "gate_status": {"type": "object", "required": ["bundle_status", "lane24_eliminated", "lane24_elimination_basis", "lane24_statement", "gate_verdicts"],
                  "properties": {"bundle_status": {"enum": ["ELIMINATED_WITHIN_TESTED_ENVELOPE", "NOT_ELIMINATED"]}},
                  "allOf": [{"if": {"properties": {"bundle_status": {"const": "ELIMINATED_WITHIN_TESTED_ENVELOPE"}}},
                             "then": {"properties": {"lane24_eliminated": {"const": true}, "lane24_elimination_basis": {"type": "array", "minItems": 1}}},
                             "else": {"properties": {"lane24_eliminated": {"const": false}}}}]},
  "condition": {"type": "object", "required": ["id", "demonstrate", "pass_criterion", "source", "demonstrated_by"]}
 }
}
